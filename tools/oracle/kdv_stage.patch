 Bits CPU_Core_Normal_Run(void) {
 	while (CPU_Cycles-->0) {
 		LOADIP;
+		static int fist_kdv_stage_init = 0;
+		static FILE *fist_kdv_stage_file = 0;
+		static unsigned fist_kdv_stage_count[7] = {0};
