+/* FIST_MEMARM_BOOT: arm the per-byte RAM last-writer recorder from process START
+ * (before the first VGA write), so buffers built during very-early extender init
+ * (e.g. the [bc90]=0x10000 blend matrix at phys 0x141000, built before the menu and
+ * thus unreachable by SIGUSR1) get a per-byte last-writer capture.  Env-gated, default
+ * OFF -> behaviour-neutral for every normal capture.  Reads FISTLOG + FIST_TILEPHYS. */
+__attribute__((constructor)) static void fist_boot_arm(void) {
+	if (!getenv("FIST_MEMARM_BOOT")) return;
+	signal(SIGUSR1, fist_sig);
+	signal(SIGUSR2, fist_sig);
+	const char *p = getenv("FISTLOG");
+	snprintf(fist_prefix, sizeof fist_prefix, "%s", p ? p : "/tmp/fistlog");
+	const char *tp = getenv("FIST_TILEPHYS");
+	if (tp) { fist_tile_lo = (Bit32u)strtoul(tp, 0, 0); fist_tile_hi = fist_tile_lo + 0x10000; }
+	const char *wp = getenv("FIST_WATCHPHYS");
+	if (wp) { Bit32u c=(Bit32u)strtoul(wp,0,0); const char*ws=getenv("FIST_WATCHSPAN");
+		Bit32u span=ws?(Bit32u)strtoul(ws,0,0):0x20; fist_watch_lo=c-span; fist_watch_hi=c+span; }
+	const char *wf = getenv("FIST_WATCHFLAT");
+	if (wf) { fist_wf_base=(Bit32u)strtoul(wf,0,0); const char*wfs=getenv("FIST_WATCHFLATSPAN");
+		fist_wf_span=wfs?(Bit32u)strtoul(wfs,0,0):0x100; }
+	fist_inited = true;
+	fist_armed  = 1;   /* VGA-write histogram armed too (harmless) */
+	fist_mem_armed = 1;   /* the RAM last-writer recorder is LIVE from boot */
+	fprintf(stderr, "[fist-oracle] FIST_MEMARM_BOOT: RAM recorder armed at process start, tile=[%08x..%08x)\n",
+		fist_tile_lo, fist_tile_hi);
+}
+
+static INLINE void fist_vgawrite(PhysPt addr, Bitu val) {
+	if (GCC_UNLIKELY(!fist_inited)) {
+		fist_inited = true;
+		signal(SIGUSR1, fist_sig);
+		signal(SIGUSR2, fist_sig);
+		const char *p = getenv("FISTLOG");
+		snprintf(fist_prefix, sizeof fist_prefix, "%s", p ? p : "/tmp/fistlog");
+		const char *tp = getenv("FIST_TILEPHYS");
+		if (tp) { fist_tile_lo = (Bit32u)strtoul(tp, 0, 0); fist_tile_hi = fist_tile_lo + 0x10000; }
+		const char *wp = getenv("FIST_WATCHPHYS");
+		if (wp) {
+			Bit32u c = (Bit32u)strtoul(wp, 0, 0);
+			const char *ws = getenv("FIST_WATCHSPAN");
+			Bit32u span = ws ? (Bit32u)strtoul(ws, 0, 0) : 0x20;
+			fist_watch_lo = c - span; fist_watch_hi = c + span;
+		}
+		const char *wf = getenv("FIST_WATCHFLAT");
+		if (wf) {
+			fist_wf_base = (Bit32u)strtoul(wf, 0, 0);
+			const char *wfs = getenv("FIST_WATCHFLATSPAN");
+			fist_wf_span = wfs ? (Bit32u)strtoul(wfs, 0, 0) : 0x100;
+		}
+		if (getenv("FIST_R9200CAP")) {
+			r9200_cap = 1; fist_mem_armed = 1;   /* arm the RAM hook so the 8120 sentinel fires */
+			const char *mp = getenv("FIST_R9200MAX"); if (mp) r9200_maxpass = atoi(mp);
+		}
+	}
+	/* 9200 frame-matched capture: snapshot frame F's globals on its first terrain write */
+	if (r9200_cap) {
+		Bit32u lin = SegPhys(cs) + reg_eip;
+		if (lin >= 0x10009200 && lin < 0x100092a0 && !r9200_inpass) {
+			r9200_inpass = 1; r9200_snapshot(); r9200_have = 1;
+		}
+	}
+	if (GCC_UNLIKELY(fist_req)) {
+		if (fist_req == 1) { fist_nent = 0; fist_armed = 1; fist_nment = 0; fist_mem_armed = 1;
+			fist_nfent = 0; fist_wf_lastcr3 = 0xffffffffu; fist_wf_lasten = -1;
+			memset(fist_lastip, 0, sizeof fist_lastip); memset(fist_lastval, 0, sizeof fist_lastval); }
+		else { fist_dump(); fist_armed = 0; fist_mem_armed = 0; }
+		fist_req = 0;
+	}
+	if (!fist_armed) return;
+	Bit32u off = addr & 0x1ffff;
+	if (off >= 0x10000) return;             /* only the visible 320x200 range */
+	Bit32u ipl = SegPhys(cs) + reg_eip;
+	Bit32u csv = SegValue(cs), eipv = reg_eip;
+	for (int i = 0; i < fist_nent; i++) {
+		if (fist_ent[i].lin == ipl) {
+			fist_ent[i].count++;
+			if (off < fist_ent[i].minoff) fist_ent[i].minoff = off;
+			if (off > fist_ent[i].maxoff) fist_ent[i].maxoff = off;
+			return;
+		}
+	}
+	if (fist_nent < FIST_NENT) {
+		FistWEnt *e = &fist_ent[fist_nent++];
+		e->lin = ipl; e->cs = csv; e->eip = eipv; e->count = 1;
+		e->minoff = e->maxoff = off; e->firstval = val;
+	}
+}
