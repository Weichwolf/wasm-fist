# wasm-fist DOSBox oracle instrumentation (apply with: patch -p0 < this  from inside dosbox-0.74-3/)
# Instruments VGA 0xA0000 writers (fist_vgawrite) AND normal-RAM writers (fist_memrec via the
# include/mem.h host_writeb/w/d hook) so extender data buffers (blend matrix, tile, colormap) can be
# captured by PHYSICAL/FLAT address.  Env: FISTLOG, FIST_TILEPHYS (per-byte last-writer 64K window),
# FIST_WATCHPHYS/SPAN, FIST_WATCHFLAT/SPAN (CR3-aware), FIST_MEMARM_BOOT (arm the RAM recorder at
# process START, for buffers built before the first VGA write).  SIGUSR1=arm/reset, SIGUSR2=dump.
--- include/mem.h
+++ include/mem.h
@@ -93,13 +93,24 @@
 static INLINE Bit32u host_readd(HostPt off) {
 	return *(Bit32u *)off;
 }
+#ifdef __cplusplus
+extern "C" void fist_memrec(Bit8u *off, Bit8u val);
+extern volatile int fist_mem_armed;
+#define FIST_MEMREC(o,v) do{ if(fist_mem_armed) fist_memrec((Bit8u*)(o),(Bit8u)(v)); }while(0)
+#else
+#define FIST_MEMREC(o,v) do{}while(0)
+#endif
 static INLINE void host_writeb(HostPt off,Bit8u val) {
+	FIST_MEMREC(off,val);
 	*(Bit8u *)(off)=val;
 }
 static INLINE void host_writew(HostPt off,Bit16u val) {
+	FIST_MEMREC(off,(Bit8u)val); FIST_MEMREC(off+1,(Bit8u)(val>>8));
 	*(Bit16u *)(off)=val;
 }
 static INLINE void host_writed(HostPt off,Bit32u val) {
+	FIST_MEMREC(off,(Bit8u)val); FIST_MEMREC(off+1,(Bit8u)(val>>8));
+	FIST_MEMREC(off+2,(Bit8u)(val>>16)); FIST_MEMREC(off+3,(Bit8u)(val>>24));
 	*(Bit32u *)(off)=val;
 }
 
--- src/hardware/vga_memory.cpp
+++ src/hardware/vga_memory.cpp
@@ -27,6 +27,458 @@
 #include "pic.h"
 #include "inout.h"
 #include "setup.h"
+#include "regs.h"
+#include "cpu.h"
+#include <signal.h>
+#include <stdio.h>
+
+/* ==== wasm-fist oracle instrumentation: capture the terrain-pixel WRITER ==== */
+/* Logs, over an armed window, a per-instruction-pointer histogram of writes to  */
+/* the mode-13h framebuffer (linear 0xA0000), plus dumps guest RAM + VRAM so the */
+/* voxel writer's identity (image+offset) and data flow can be resolved offline. */
+struct FistWEnt { Bit32u lin, cs, eip, count, minoff, maxoff, firstval; };
+#define FIST_NENT 8192
+static FistWEnt fist_ent[FIST_NENT];
+static int fist_nent = 0;
+static volatile int fist_req = 0;   /* 1=arm/reset, 2=dump */
+static int fist_armed = 0;
+static bool fist_inited = false;
+static char fist_prefix[512];
+
+/* ---- tile-3918 (extender flat 0x44200 => guest-phys 0x175200) write recorder ---- */
+struct FistMEnt { Bit32u ip, cs, eip, count, minoff, maxoff; Bit8u firstval; Bit16u stk[20]; };
+static FistMEnt fist_ment[FIST_NENT];
+static int fist_nment = 0;
+volatile int fist_mem_armed = 0;              /* referenced by include/mem.h host_writeb gate */
+static Bit32u fist_tile_lo = 0x175200, fist_tile_hi = 0x185200;
+/* ---- PER-BYTE LAST-WRITER map over the tile phys range (never disarms, no cap): for
+ * each of the 0x10000 tile bytes record the CS:EIP and value of the LAST write.  This
+ * decisively identifies the code that leaves each final tile byte, robust to overwrite
+ * ordering (bc9c/bc06 symmetric fill vs. a late fog producer). */
+static Bit32u fist_lastip[0x10000];
+static Bit8u  fist_lastval[0x10000];
+
+/* ---- targeted WATCH: capture writer flat-IP + near-call stack backtrace for a
+ * specific phys range (env FIST_WATCHPHYS, +/- FIST_WATCHSPAN bytes).  Used to
+ * find the mission-entry cockpit-view ACTIVATE source: who writes DGROUP:4d0e. */
+static Bit32u fist_watch_lo = 0, fist_watch_hi = 0;
+static int    fist_watch_hits = 0;
+
+/* ---- CR3-AWARE flat-address watch: find who writes a FLAT LINEAR address
+ * (e.g. tile 3918 = ext flat 0x44200) REGARDLESS of which physical frame backs
+ * it.  The extender's PM paging moves its flat buffers under a fixed physical
+ * range, so a fixed-phys watch (above) is confounded at map-load vs dump time.
+ * This walks the guest CR3 page tables on every CR3 change (and periodically) to
+ * keep the flat->phys mapping current, then records writers by FLAT offset. */
+struct FistFEnt { Bit32u ip, cs, eip, count, minoff, maxoff; Bit8u firstval; Bit16u stk[20]; };
+static FistFEnt fist_fent[FIST_NENT];
+static int      fist_nfent = 0;
+static Bit32u   fist_wf_base = 0, fist_wf_span = 0;
+#define FIST_MAXWP 64
+static Bit32u   fist_wf_flatpg[FIST_MAXWP], fist_wf_physpg[FIST_MAXWP];
+static int      fist_wf_npg = 0;
+static Bit32u   fist_wf_lastcr3 = 0xffffffffu;
+static int      fist_wf_lasten = -1;
+static Bit32u   fist_wf_seq = 0;
+
+/* 2-level (and 4MB-PSE) guest page-table walk for the CURRENT CR3.  Reads page-
+ * table entries straight out of guest physical RAM (MemBase[phys]).  Returns
+ * 0xFFFFFFFF when paging is on but the page is not present. */
+static Bit32u fist_flat_to_phys(Bit32u lin) {
+	if (!paging.enabled) return lin;                 /* identity when paging off */
+	Bit32u cr3 = (Bit32u)paging.cr3 & 0xfffff000u;
+	Bit32u pde = host_readd(MemBase + cr3 + ((lin >> 22) & 0x3ff) * 4);
+	if (!(pde & 1)) return 0xffffffffu;              /* PDE not present */
+	if (pde & 0x80) return (pde & 0xffc00000u) | (lin & 0x003fffffu); /* 4MB PSE page */
+	Bit32u pte = host_readd(MemBase + (pde & 0xfffff000u) + ((lin >> 12) & 0x3ff) * 4);
+	if (!(pte & 1)) return 0xffffffffu;              /* PTE not present */
+	return (pte & 0xfffff000u) | (lin & 0xfffu);
+}
+
+/* recompute the flat->phys page map for the watched flat range under current CR3 */
+static void fist_wf_remap(void) {
+	fist_wf_npg = 0;
+	Bit32u start = fist_wf_base & ~0xfffu;
+	Bit32u end   = (fist_wf_base + fist_wf_span + 0xfffu) & ~0xfffu;
+	for (Bit32u l = start; l < end && fist_wf_npg < FIST_MAXWP; l += 0x1000) {
+		Bit32u p = fist_flat_to_phys(l);
+		fist_wf_flatpg[fist_wf_npg] = l;
+		fist_wf_physpg[fist_wf_npg] = (p == 0xffffffffu) ? 0xffffffffu : (p & ~0xfffu);
+		fist_wf_npg++;
+	}
+	fist_wf_lastcr3 = (Bit32u)paging.cr3;
+	fist_wf_lasten  = (int)paging.enabled;
+}
+
+/* record a writer that hit the watched FLAT range (histogram + first backtrace) */
+static void fist_flatrec(Bit32u foff, Bit8u val) {
+	Bit32u ipl = SegPhys(cs) + reg_eip;
+	for (int i = 0; i < fist_nfent; i++) {
+		if (fist_fent[i].ip == ipl) {
+			fist_fent[i].count++;
+			if (foff < fist_fent[i].minoff) fist_fent[i].minoff = foff;
+			if (foff > fist_fent[i].maxoff) fist_fent[i].maxoff = foff;
+			return;
+		}
+	}
+	if (fist_nfent < FIST_NENT) {
+		FistFEnt *e = &fist_fent[fist_nfent++];
+		e->ip = ipl; e->cs = SegValue(cs); e->eip = reg_eip; e->count = 1;
+		e->minoff = e->maxoff = foff; e->firstval = val;
+		Bit32u ssb = SegPhys(ss);
+		for (int k = 0; k < 20; k++) e->stk[k] = mem_readw(ssb + reg_esp + k * 2);
+	}
+}
+
+static void fist_sig(int s) { fist_req = (s == SIGUSR1) ? 1 : 2; }
+
+/* ==== wasm-fist 9200 globals<->VRAM FRAME-MATCHED capture (env FIST_R9200CAP) ====
+ * Captures, for the first N terrain frames, a SELF-CONSISTENT triple from ONE 9200
+ * invocation: the projection globals it READ + the VRAM it WROTE + the DAC + the
+ * colormap tile it sampled.  Frame-matching is exact by construction:
+ *   - the extender per-frame render is 82b8 = { 8120(projection); 9200(render); 82d0() }.
+ *   - on the FIRST 0xA0000 write of a 9200 pass (lin in [0x10009200,0x100092a0), the
+ *     opaque-LOD texel writer) we snapshot the ext-flat globals 0x9000..0x9200 + the
+ *     ESI/EBP registers (the CONSTANT per-texel u/v step, invariant across the whole
+ *     9200 call) into a shadow -> these are frame F's exact render inputs.
+ *   - when 8120 NEXT executes (a RAM write with lin in [0x10008120,0x10008260) = the
+ *     projection recompute for frame F+1, which by 82b8's order runs BEFORE 9200-F+1),
+ *     the VRAM still holds frame F's terrain, so we dump the shadow globals + the
+ *     current VRAM/DAC/tile -> the globals and the VRAM are from the SAME 9200 call. */
+static int      r9200_cap = 0;
+static int      r9200_inpass = 0, r9200_have = 0, r9200_passno = 0, r9200_maxpass = 16;
+static Bit8u    r9200_glob[0x200];        /* ext[0x9000..0x9200] snapshot (frame F) */
+static Bit32u   r9200_esi = 0, r9200_ebp = 0, r9200_hzptr = 0;
+static Bit8u    r9200_hz[256];            /* horizon table contents (frame F) */
+static Bit32u   r9200_base = 0x10000000;  /* extender flat base = SegPhys(cs) at the write */
+
+static void r9200_snapshot(void) {
+	r9200_base = SegPhys(cs);              /* = 0x10000000 for the flat PM code selector */
+	for (int i = 0; i < 0x200; i++) r9200_glob[i] = mem_readb(r9200_base + 0x9000 + i);
+	r9200_esi = reg_esi; r9200_ebp = reg_ebp;             /* constant per-texel u/v step */
+	r9200_hzptr = mem_readd(r9200_base + 0x9114);
+	Bit32u ht = r9200_base + (r9200_hzptr & 0x00ffffffu); /* ext-relative horizon pointer */
+	for (int i = 0; i < 256; i++) r9200_hz[i] = mem_readb(ht + i);
+}
+
+static void r9200_dump(void) {
+	char path[700];
+	/* .cap = hdr(magic,passno,esi,ebp,hzptr) + glob[0x200] + hz[256] + tile[65536] */
+	snprintf(path, sizeof path, "%s.pass%02d.cap", fist_prefix, r9200_passno);
+	FILE *f = fopen(path, "wb");
+	if (f) {
+		Bit32u hdr[5] = { 0x43323952u /*'R92C'*/, (Bit32u)r9200_passno, r9200_esi, r9200_ebp, r9200_hzptr };
+		fwrite(hdr, 4, 5, f);
+		fwrite(r9200_glob, 1, 0x200, f);
+		fwrite(r9200_hz, 1, 256, f);
+		static Bit8u tile[65536];          /* colormap tile @ ext-flat 0x44200 (SMC 3918 base) */
+		for (int i = 0; i < 65536; i++) tile[i] = mem_readb(r9200_base + 0x44200 + i);
+		fwrite(tile, 1, 65536, f);
+		fclose(f);
+	}
+	snprintf(path, sizeof path, "%s.pass%02d.vram.bin", fist_prefix, r9200_passno);
+	f = fopen(path, "wb"); if (f) { fwrite(vga.mem.linear, 1, 256*1024, f); fclose(f); }
+	snprintf(path, sizeof path, "%s.pass%02d.pal.bin", fist_prefix, r9200_passno);
+	f = fopen(path, "wb"); if (f) { fwrite(vga.dac.rgb, 1, sizeof(vga.dac.rgb), f); fclose(f); }
+	Bit32u g4  = *(Bit32u*)(r9200_glob+0x1d4), g8  = *(Bit32u*)(r9200_glob+0x1d8);
+	Bit32u gb8 = *(Bit32u*)(r9200_glob+0x1b8), gbc = *(Bit32u*)(r9200_glob+0x1bc);
+	Bit32u gf0 = *(Bit32u*)(r9200_glob+0x1f0), gf8 = *(Bit32u*)(r9200_glob+0x1f8);
+	fprintf(stderr, "[r92cap] pass %02d esi=%08x ebp=%08x 90d4=%08x 90d8=%08x(row%d) 90b8=%08x 90bc=%08x "
+		"90f0=%u 90f8=%u hzptr=%08x vga.mode=%d pmode=%d\n",
+		r9200_passno, r9200_esi, r9200_ebp, g4, g8, (g8>>24)&0xff, gb8, gbc, gf0, gf8,
+		r9200_hzptr, (int)vga.mode, (int)cpu.pmode);
+}
+/* ==== end 9200 frame-matched capture ==== */
+
+/* Records the CS:EIP of any guest write whose physical target lands in the tile
+ * range.  Called (gated on fist_mem_armed) from host_writeb in include/mem.h. */
+extern "C" void fist_memrec(Bit8u *off, Bit8u val) {
+	Bit32u ph = (Bit32u)(off - MemBase);
+	/* 9200 frame-matched capture: 8120 recomputing frame F+1's globals = frame F boundary */
+	if (r9200_cap && r9200_have) {
+		Bit32u lin = SegPhys(cs) + reg_eip;
+		if (lin >= 0x10008120 && lin < 0x10008260) {
+			if (r9200_passno < r9200_maxpass) { r9200_dump(); r9200_passno++; }
+			r9200_have = 0; r9200_inpass = 0;
+			if (r9200_passno >= r9200_maxpass) r9200_cap = 0;   /* stop after N frames */
+		}
+	}
+	if (fist_watch_hi && ph >= fist_watch_lo && ph < fist_watch_hi && fist_watch_hits < 40000) {
+		fist_watch_hits++;
+		char wpath[600]; snprintf(wpath, sizeof wpath, "%s.watch.txt", fist_prefix);
+		FILE *wf = fopen(wpath, "a");
+		if (wf) {
+			Bit32u ssb = SegPhys(ss), flatip = SegPhys(cs) + reg_eip;
+			fprintf(wf, "WATCH ph=%08x val=%02x flatip=%08x cs=%04x eip=%08x ss=%04x sp=%08x stack:",
+				ph, val, flatip, SegValue(cs), reg_eip, SegValue(ss), reg_esp);
+			for (int k = 0; k < 20; k++) fprintf(wf, " %04x", mem_readw(ssb + reg_esp + k * 2));
+			fprintf(wf, "\n");
+			fclose(wf);
+		}
+	}
+	if (fist_wf_span) {
+		/* CR3-aware: re-map on CR3/paging-enable change or every 64K writes */
+		if ((Bit32u)paging.cr3 != fist_wf_lastcr3 || (int)paging.enabled != fist_wf_lasten
+		    || ((fist_wf_seq++ & 0xffffu) == 0)) fist_wf_remap();
+		Bit32u phpg = ph & ~0xfffu;
+		for (int i = 0; i < fist_wf_npg; i++) {
+			if (fist_wf_physpg[i] == phpg) {
+				Bit32u flataddr = fist_wf_flatpg[i] + (ph & 0xfffu);
+				if (flataddr >= fist_wf_base && flataddr < fist_wf_base + fist_wf_span)
+					fist_flatrec(flataddr - fist_wf_base, val);
+				break;
+			}
+		}
+	}
+	if (ph < fist_tile_lo || ph >= fist_tile_hi) return;
+	Bit32u ipl = SegPhys(cs) + reg_eip, off16 = ph - fist_tile_lo;
+	/* per-byte LAST-writer (decisive: who owns each final tile byte) */
+	if (off16 < 0x10000) { fist_lastip[off16] = ipl; fist_lastval[off16] = val; }
+	for (int i = 0; i < fist_nment; i++) {
+		if (fist_ment[i].ip == ipl) {
+			fist_ment[i].count++;
+			if (off16 < fist_ment[i].minoff) fist_ment[i].minoff = off16;
+			if (off16 > fist_ment[i].maxoff) fist_ment[i].maxoff = off16;
+			return;
+		}
+	}
+	if (fist_nment < FIST_NENT) {
+		FistMEnt *e = &fist_ment[fist_nment++];
+		e->ip = ipl; e->cs = SegValue(cs); e->eip = reg_eip; e->count = 1;
+		e->minoff = e->maxoff = off16; e->firstval = val;
+		Bit32u ssb = SegPhys(ss);
+		for (int k = 0; k < 20; k++) e->stk[k] = mem_readw(ssb + reg_esp + k * 2);
+	}
+}
+
+static void fist_dump(void) {
+	char path[600];
+	/* 1. writer histogram + code bytes */
+	snprintf(path, sizeof path, "%s.writers.txt", fist_prefix);
+	FILE *f = fopen(path, "w");
+	if (f) {
+		fprintf(f, "# vga A0000 writers over armed window: %d distinct IPs\n", fist_nent);
+		fprintf(f, "# cpu.pmode=%d  vga.mode=%d\n", (int)cpu.pmode, (int)vga.mode);
+		/* simple selection sort by count desc */
+		for (int i = 0; i < fist_nent; i++) {
+			int mx = i;
+			for (int j = i + 1; j < fist_nent; j++)
+				if (fist_ent[j].count > fist_ent[mx].count) mx = j;
+			FistWEnt t = fist_ent[i]; fist_ent[i] = fist_ent[mx]; fist_ent[mx] = t;
+		}
+		for (int i = 0; i < fist_nent && i < 64; i++) {
+			FistWEnt *e = &fist_ent[i];
+			fprintf(f, "\nWRITER lin=%08x cs=%04x eip=%08x count=%u off=[%04x..%04x] firstval=%02x\n",
+				e->lin, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) {
+				if (k == 0) fprintf(f, "| ");
+				fprintf(f, "%02x ", mem_readb(e->lin + k));
+			}
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 2. guest physical RAM (heightmap/colormap/camera live here) */
+	snprintf(path, sizeof path, "%s.ram.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) {
+		Bitu bytes = MEM_TotalPages() * 4096;
+		if (bytes > 16u * 1024 * 1024) bytes = 16u * 1024 * 1024;
+		fwrite(MemBase, 1, bytes, f);
+		fclose(f);
+	}
+	/* 3. VGA linear video memory (raw mode-13h/chain4 layout) */
+	snprintf(path, sizeof path, "%s.vram.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(vga.mem.linear, 1, 256 * 1024, f); fclose(f); }
+	/* 4. DAC palette (256*3, 6-bit) */
+	snprintf(path, sizeof path, "%s.pal.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(vga.dac.rgb, 1, sizeof(vga.dac.rgb), f); fclose(f); }
+	/* 5. tile-3918 (phys range) writers: CS:EIP histogram + code bytes */
+	snprintf(path, sizeof path, "%s.tilewriters.txt", fist_prefix);
+	f = fopen(path, "w");
+	if (f) {
+		fprintf(f, "# tile writers over armed window, phys=[%08x..%08x): %d distinct IPs\n",
+			fist_tile_lo, fist_tile_hi, fist_nment);
+		for (int i = 0; i < fist_nment; i++) {
+			int mx = i;
+			for (int j = i + 1; j < fist_nment; j++)
+				if (fist_ment[j].count > fist_ment[mx].count) mx = j;
+			FistMEnt t = fist_ment[i]; fist_ment[i] = fist_ment[mx]; fist_ment[mx] = t;
+		}
+		for (int i = 0; i < fist_nment && i < 48; i++) {
+			FistMEnt *e = &fist_ment[i];
+			fprintf(f, "\nTILEWRITER lin=%08x cs=%04x eip=%08x count=%u tileoff=[%04x..%04x] firstval=%02x\n",
+				e->ip, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) {
+				if (k == 0) fprintf(f, "| ");
+				fprintf(f, "%02x ", mem_readb(e->ip + k));
+			}
+			fprintf(f, "\n  stack:");
+			for (int k = 0; k < 20; k++) fprintf(f, " %04x", e->stk[k]);
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 5b. PER-BYTE LAST-WRITER: dump the final-value map (compare == oracle tile) + a
+	 * histogram of which CS:EIP OWNS each final tile byte (decisive producer id). */
+	snprintf(path, sizeof path, "%s.lastval.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(fist_lastval, 1, sizeof fist_lastval, f); fclose(f); }
+	snprintf(path, sizeof path, "%s.lastwriters.txt", fist_prefix);
+	f = fopen(path, "w");
+	if (f) {
+		/* histogram distinct last-writer IPs over [0..0xffff] */
+		struct { Bit32u ip, count, minoff, maxoff; } h[256]; int nh = 0;
+		for (Bit32u o = 0; o < 0x10000; o++) {
+			Bit32u ip = fist_lastip[o];
+			if (!ip) continue;
+			int j; for (j = 0; j < nh; j++) if (h[j].ip == ip) break;
+			if (j == nh && nh < 256) { h[nh].ip = ip; h[nh].count = 0; h[nh].minoff = o; h[nh].maxoff = o; nh++; }
+			if (j < 256) { h[j].count++; if (o < h[j].minoff) h[j].minoff = o; if (o > h[j].maxoff) h[j].maxoff = o; }
+		}
+		fprintf(f, "# PER-BYTE LAST-WRITER over tile [%08x..%08x): %d distinct owning IPs\n",
+			fist_tile_lo, fist_tile_lo + 0x10000, nh);
+		for (int i = 0; i < nh; i++) {  /* selection sort by count desc */
+			int mx = i; for (int j = i + 1; j < nh; j++) if (h[j].count > h[mx].count) mx = j;
+			{ Bit32u ti=h[i].ip,tc=h[i].count,tmn=h[i].minoff,tmx=h[i].maxoff;
+			  h[i]=h[mx]; h[mx].ip=ti;h[mx].count=tc;h[mx].minoff=tmn;h[mx].maxoff=tmx; }
+		}
+		for (int i = 0; i < nh; i++) {
+			fprintf(f, "\nLASTWRITER lin=%08x extip=%05x count=%u tileoff=[%04x..%04x]\n",
+				h[i].ip, h[i].ip & 0xfffff, h[i].count, h[i].minoff, h[i].maxoff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) { if (k==0) fprintf(f,"| "); fprintf(f, "%02x ", mem_readb(h[i].ip + k)); }
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 6. CR3-AWARE flat-address (tile-3918) writers: histogram + backtrace + map */
+	if (fist_wf_span) {
+		snprintf(path, sizeof path, "%s.flatwriters.txt", fist_prefix);
+		f = fopen(path, "w");
+		if (f) {
+			fprintf(f, "# CR3-aware flat writers, flat=[%08x..%08x): %d distinct IPs\n",
+				fist_wf_base, fist_wf_base + fist_wf_span, fist_nfent);
+			fprintf(f, "# final flat->phys map (npg=%d, cr3=%08x, paging=%d):\n",
+				fist_wf_npg, (Bit32u)paging.cr3, (int)paging.enabled);
+			for (int i = 0; i < fist_wf_npg; i++)
+				fprintf(f, "#   flatpg %08x -> physpg %08x\n", fist_wf_flatpg[i], fist_wf_physpg[i]);
+			for (int i = 0; i < fist_nfent; i++) {
+				int mx = i;
+				for (int j = i + 1; j < fist_nfent; j++)
+					if (fist_fent[j].count > fist_fent[mx].count) mx = j;
+				FistFEnt t = fist_fent[i]; fist_fent[i] = fist_fent[mx]; fist_fent[mx] = t;
+			}
+			for (int i = 0; i < fist_nfent && i < 48; i++) {
+				FistFEnt *e = &fist_fent[i];
+				fprintf(f, "\nFLATWRITER lin=%08x cs=%04x eip=%08x count=%u flatoff=[%04x..%04x] firstval=%02x\n",
+					e->ip, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+				fprintf(f, "  code@lin-16: ");
+				for (int k = -16; k < 48; k++) {
+					if (k == 0) fprintf(f, "| ");
+					fprintf(f, "%02x ", mem_readb(e->ip + k));
+				}
+				fprintf(f, "\n  stack:");
+				for (int k = 0; k < 20; k++) fprintf(f, " %04x", e->stk[k]);
+				fprintf(f, "\n");
+			}
+			fclose(f);
+		}
+	}
+	fprintf(stderr, "[fist-oracle] dumped %s.{writers.txt,tilewriters.txt,flatwriters.txt,ram.bin,vram.bin,pal.bin}\n", fist_prefix);
+}
