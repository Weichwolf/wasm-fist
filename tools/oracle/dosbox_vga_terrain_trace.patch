+/* ==== wasm-fist oracle instrumentation: capture the terrain-pixel WRITER ==== */
+/* Logs, over an armed window, a per-instruction-pointer histogram of writes to  */
+/* the mode-13h framebuffer (linear 0xA0000), plus dumps guest RAM + VRAM so the */
+/* voxel writer's identity (image+offset) and data flow can be resolved offline. */
+struct FistWEnt { Bit32u lin, cs, eip, count, minoff, maxoff, firstval; };
+#define FIST_NENT 8192
+static FistWEnt fist_ent[FIST_NENT];
+static int fist_nent = 0;
+static volatile int fist_req = 0;   /* 1=arm/reset, 2=dump */
+static int fist_armed = 0;
+static bool fist_inited = false;
+static char fist_prefix[512];
+
+/* ---- tile-3918 (extender flat 0x44200 => guest-phys 0x175200) write recorder ---- */
+struct FistMEnt { Bit32u ip, cs, eip, count, minoff, maxoff; Bit8u firstval; Bit16u stk[20]; };
+static FistMEnt fist_ment[FIST_NENT];
+static int fist_nment = 0;
+volatile int fist_mem_armed = 0;              /* referenced by include/mem.h host_writeb gate */
+static Bit32u fist_tile_lo = 0x175200, fist_tile_hi = 0x185200;
+/* ---- PER-BYTE LAST-WRITER map over the tile phys range (never disarms, no cap): for
+ * each of the 0x10000 tile bytes record the CS:EIP and value of the LAST write.  This
+ * decisively identifies the code that leaves each final tile byte, robust to overwrite
+ * ordering (bc9c/bc06 symmetric fill vs. a late fog producer). */
+static Bit32u fist_lastip[0x10000];
+static Bit8u  fist_lastval[0x10000];
+
+/* ---- targeted WATCH: capture writer flat-IP + near-call stack backtrace for a
+ * specific phys range (env FIST_WATCHPHYS, +/- FIST_WATCHSPAN bytes).  Used to
+ * find the mission-entry cockpit-view ACTIVATE source: who writes DGROUP:4d0e. */
+static Bit32u fist_watch_lo = 0, fist_watch_hi = 0;
+static int    fist_watch_hits = 0;
+
+/* ---- CR3-AWARE flat-address watch: find who writes a FLAT LINEAR address
+ * (e.g. tile 3918 = ext flat 0x44200) REGARDLESS of which physical frame backs
+ * it.  The extender's PM paging moves its flat buffers under a fixed physical
+ * range, so a fixed-phys watch (above) is confounded at map-load vs dump time.
+ * This walks the guest CR3 page tables on every CR3 change (and periodically) to
+ * keep the flat->phys mapping current, then records writers by FLAT offset. */
+struct FistFEnt { Bit32u ip, cs, eip, count, minoff, maxoff; Bit8u firstval; Bit16u stk[20]; };
+static FistFEnt fist_fent[FIST_NENT];
+static int      fist_nfent = 0;
+static Bit32u   fist_wf_base = 0, fist_wf_span = 0;
+#define FIST_MAXWP 64
+static Bit32u   fist_wf_flatpg[FIST_MAXWP], fist_wf_physpg[FIST_MAXWP];
+static int      fist_wf_npg = 0;
+static Bit32u   fist_wf_lastcr3 = 0xffffffffu;
+static int      fist_wf_lasten = -1;
+static Bit32u   fist_wf_seq = 0;
+
+/* 2-level (and 4MB-PSE) guest page-table walk for the CURRENT CR3.  Reads page-
+ * table entries straight out of guest physical RAM (MemBase[phys]).  Returns
+ * 0xFFFFFFFF when paging is on but the page is not present. */
+static Bit32u fist_flat_to_phys(Bit32u lin) {
+	if (!paging.enabled) return lin;                 /* identity when paging off */
+	Bit32u cr3 = (Bit32u)paging.cr3 & 0xfffff000u;
+	Bit32u pde = host_readd(MemBase + cr3 + ((lin >> 22) & 0x3ff) * 4);
+	if (!(pde & 1)) return 0xffffffffu;              /* PDE not present */
+	if (pde & 0x80) return (pde & 0xffc00000u) | (lin & 0x003fffffu); /* 4MB PSE page */
+	Bit32u pte = host_readd(MemBase + (pde & 0xfffff000u) + ((lin >> 12) & 0x3ff) * 4);
+	if (!(pte & 1)) return 0xffffffffu;              /* PTE not present */
+	return (pte & 0xfffff000u) | (lin & 0xfffu);
+}
+
+/* recompute the flat->phys page map for the watched flat range under current CR3 */
+static void fist_wf_remap(void) {
+	fist_wf_npg = 0;
+	Bit32u start = fist_wf_base & ~0xfffu;
+	Bit32u end   = (fist_wf_base + fist_wf_span + 0xfffu) & ~0xfffu;
+	for (Bit32u l = start; l < end && fist_wf_npg < FIST_MAXWP; l += 0x1000) {
+		Bit32u p = fist_flat_to_phys(l);
+		fist_wf_flatpg[fist_wf_npg] = l;
+		fist_wf_physpg[fist_wf_npg] = (p == 0xffffffffu) ? 0xffffffffu : (p & ~0xfffu);
+		fist_wf_npg++;
+	}
+	fist_wf_lastcr3 = (Bit32u)paging.cr3;
+	fist_wf_lasten  = (int)paging.enabled;
+}
+
+/* record a writer that hit the watched FLAT range (histogram + first backtrace) */
+static void fist_flatrec(Bit32u foff, Bit8u val) {
+	Bit32u ipl = SegPhys(cs) + reg_eip;
+	for (int i = 0; i < fist_nfent; i++) {
+		if (fist_fent[i].ip == ipl) {
+			fist_fent[i].count++;
+			if (foff < fist_fent[i].minoff) fist_fent[i].minoff = foff;
+			if (foff > fist_fent[i].maxoff) fist_fent[i].maxoff = foff;
+			return;
+		}
+	}
+	if (fist_nfent < FIST_NENT) {
+		FistFEnt *e = &fist_fent[fist_nfent++];
+		e->ip = ipl; e->cs = SegValue(cs); e->eip = reg_eip; e->count = 1;
+		e->minoff = e->maxoff = foff; e->firstval = val;
+		Bit32u ssb = SegPhys(ss);
+		for (int k = 0; k < 20; k++) e->stk[k] = mem_readw(ssb + reg_esp + k * 2);
+	}
+}
+
+static void fist_sig(int s) { fist_req = (s == SIGUSR1) ? 1 : 2; }
+
+/* ==== wasm-fist 9200 globals<->VRAM FRAME-MATCHED capture (env FIST_R9200CAP) ====
+ * Captures, for the first N terrain frames, a SELF-CONSISTENT triple from ONE 9200
+ * invocation: the projection globals it READ + the VRAM it WROTE + the DAC + the
+ * colormap tile it sampled.  Frame-matching is exact by construction:
+ *   - the extender per-frame render is 82b8 = { 8120(projection); 9200(render); 82d0() }.
+ *   - on the FIRST 0xA0000 write of a 9200 pass (lin in [0x10009200,0x100092a0), the
+ *     opaque-LOD texel writer) we snapshot the ext-flat globals 0x9000..0x9200 + the
+ *     ESI/EBP registers (the CONSTANT per-texel u/v step, invariant across the whole
+ *     9200 call) into a shadow -> these are frame F's exact render inputs.
+ *   - when 8120 NEXT executes (a RAM write with lin in [0x10008120,0x10008260) = the
+ *     projection recompute for frame F+1, which by 82b8's order runs BEFORE 9200-F+1),
+ *     the VRAM still holds frame F's terrain, so we dump the shadow globals + the
+ *     current VRAM/DAC/tile -> the globals and the VRAM are from the SAME 9200 call. */
+static int      r9200_cap = 0;
+static int      r9200_inpass = 0, r9200_have = 0, r9200_passno = 0, r9200_maxpass = 16;
+static Bit8u    r9200_glob[0x200];        /* ext[0x9000..0x9200] snapshot (frame F) */
+static Bit32u   r9200_esi = 0, r9200_ebp = 0, r9200_hzptr = 0;
+static Bit8u    r9200_hz[256];            /* horizon table contents (frame F) */
+static Bit32u   r9200_base = 0x10000000;  /* extender flat base = SegPhys(cs) at the write */
+/* ==== wasm-fist CAMERA capture: the render-time TCB camera 8120 reads at 9200-entry ==== */
+static Bit32u   r9200_tcbptr = 0;         /* value at ext ds:[0xc93] = current-TCB ptr */
+static Bit32u   r9200_cam_a[8], r9200_cam_b[8]; /* +0x2c..+0x3e read 2 ways (ext-rel / abs) */
+
+/* FAULT-FREE physical read of a guest LINEAR address: translate via the current CR3
+ * (page tables read straight from MemBase, no guest fault) then read physical RAM.
+ * Returns 0 for an unmapped page or out-of-range phys.  Avoids the "Pagefault didn't
+ * correct table" that mem_readw() triggers when it walks an unmapped TCB linear. */
+static Bit32u fist_safe_readn(Bit32u lin, int n) {
+	Bit32u v = 0;
+	for (int i = 0; i < n; i++) {
+		Bit32u ph = fist_flat_to_phys(lin + i);
+		Bit8u b = 0;
+		if (ph != 0xffffffffu && ph < (Bit32u)(MEM_TotalPages()*4096)) b = host_readb(MemBase + ph);
+		v |= (Bit32u)b << (8*i);
+	}
+	return v;
+}
+
+static void r9200_snapshot(void) {
+	r9200_base = SegPhys(cs);              /* = 0x10000000 for the flat PM code selector */
+	for (int i = 0; i < 0x200; i++) r9200_glob[i] = mem_readb(r9200_base + 0x9000 + i);
+	r9200_esi = reg_esi; r9200_ebp = reg_ebp;             /* constant per-texel u/v step */
+	r9200_hzptr = mem_readd(r9200_base + 0x9114);
+	Bit32u ht = r9200_base + (r9200_hzptr & 0x00ffffffu); /* ext-relative horizon pointer */
+	for (int i = 0; i < 256; i++) r9200_hz[i] = mem_readb(ht + i);
+	/* the current-TCB pointer 8120 uses: ds:[0xc93]; camera fields at TCB+0x2c..+0x3e.
+	 * The extender DATA selector base may differ from CS base -> read [0xc93] via DS base. */
+	Bit32u dsb = SegPhys(ds), csb = SegPhys(cs), ssb = SegPhys(ss);
+	Bit32u c93_cs = fist_safe_readn(csb + 0xc93, 4);
+	Bit32u c93_ds = fist_safe_readn(dsb + 0xc93, 4);
+	r9200_tcbptr = c93_ds ? c93_ds : c93_cs;    /* prefer the DS-based read */
+	/* the CPU forms the EA as (DS_base + ebx + off) mod 2^32: with DS_base=0x10000000
+	 * and ebx=0xf0010000 this WRAPS to low linear 0x00010000 (the real-mode TCB). */
+	Bit32u la = (dsb + r9200_tcbptr) & 0xffffffffu;  /* wrapped DS-relative = the TCB linear */
+	Bit32u lb = r9200_tcbptr;                         /* raw (fallback) */
+	{
+		char cp[700]; snprintf(cp, sizeof cp, "%s.cam.txt", fist_prefix);
+		FILE *cf = fopen(cp, "a");
+		if (cf) {
+			fprintf(cf, "[seg] csb=%08x dsb=%08x ssb=%08x  [0xc93] via cs=%08x via ds=%08x  cr3=%08x paging=%d  TCB flat la=%08x -> phys=%08x (identity if paging-off = la)\n",
+				csb, dsb, ssb, c93_cs, c93_ds, (Bit32u)paging.cr3, (int)paging.enabled, la, fist_flat_to_phys(la));
+			/* hex window around ds:0xc90 to see the pointer + neighbours */
+			fprintf(cf, "[hex ds:0xc80] ");
+			for (int i=0;i<0x30;i++) fprintf(cf, "%02x ", (Bit8u)fist_safe_readn(dsb+0xc80+i,1));
+			fprintf(cf, "\n");
+			fflush(cf); fclose(cf);
+		}
+	}
+	/* fields: [0]=+0x2c X(32) [1]=+0x30 Y(32) [2]=+0x34 alt(32) [3]=+0x38 head(16)
+	 *         [4]=+0x3a pitch(16) [5]=+0x3c roll(16) [6]=+0x3e foc(16) [7]=+0xcc detail(8) */
+	r9200_cam_a[0]=fist_safe_readn(la+0x2c,4); r9200_cam_a[1]=fist_safe_readn(la+0x30,4); r9200_cam_a[2]=fist_safe_readn(la+0x34,4);
+	r9200_cam_a[3]=fist_safe_readn(la+0x38,2); r9200_cam_a[4]=fist_safe_readn(la+0x3a,2); r9200_cam_a[5]=fist_safe_readn(la+0x3c,2);
+	r9200_cam_a[6]=fist_safe_readn(la+0x3e,2); r9200_cam_a[7]=fist_safe_readn(la+0xcc,1);
+	r9200_cam_b[0]=fist_safe_readn(lb+0x2c,4); r9200_cam_b[1]=fist_safe_readn(lb+0x30,4); r9200_cam_b[2]=fist_safe_readn(lb+0x34,4);
+	r9200_cam_b[3]=fist_safe_readn(lb+0x38,2); r9200_cam_b[4]=fist_safe_readn(lb+0x3a,2); r9200_cam_b[5]=fist_safe_readn(lb+0x3c,2);
+	r9200_cam_b[6]=fist_safe_readn(lb+0x3e,2); r9200_cam_b[7]=fist_safe_readn(lb+0xcc,1);
+	/* print IMMEDIATELY at the first-9200-write moment so a mid-mission pagefault
+	 * (before the deferred 8120 dump boundary) does not lose the camera capture. */
+	{
+		static int camwrites = 0;
+		if (camwrites == 0) {   /* dump the FIRST-frame VRAM+DAC so the ref frame can be matched */
+			char vp[700];
+			snprintf(vp, sizeof vp, "%s.frame1.vram.bin", fist_prefix);
+			FILE *vf = fopen(vp, "wb"); if (vf) { fwrite(vga.mem.linear, 1, 256*1024, vf); fclose(vf); }
+			snprintf(vp, sizeof vp, "%s.frame1.pal.bin", fist_prefix);
+			vf = fopen(vp, "wb"); if (vf) { fwrite(vga.dac.rgb, 1, sizeof(vga.dac.rgb), vf); fclose(vf); }
+		}
+		char cp[700]; snprintf(cp, sizeof cp, "%s.cam.txt", fist_prefix);
+		FILE *cf = fopen(cp, "a");
+		if (cf) {
+			fprintf(cf, "[r92cam-now #%d] tcbptr=%08x la=%08x lb=%08x  A[ext-rel]: X=%d Y=%d alt=%d head=%u pitch(+3a)=%d roll(+3c)=%d foc=%u det=%u | B[abs]: X=%d Y=%d alt=%d head=%u pitch=%d roll=%d foc=%u det=%u\n",
+				camwrites++, r9200_tcbptr, la, lb,
+				(int)r9200_cam_a[0],(int)r9200_cam_a[1],(int)r9200_cam_a[2],r9200_cam_a[3],(Bit16s)r9200_cam_a[4],(Bit16s)r9200_cam_a[5],r9200_cam_a[6],r9200_cam_a[7],
+				(int)r9200_cam_b[0],(int)r9200_cam_b[1],(int)r9200_cam_b[2],r9200_cam_b[3],(Bit16s)r9200_cam_b[4],(Bit16s)r9200_cam_b[5],r9200_cam_b[6],r9200_cam_b[7]);
+			fflush(cf); fclose(cf);
+		}
+	}
+}
+
+static void r9200_dump(void) {
+	char path[700];
+	/* .cap = hdr(magic,passno,esi,ebp,hzptr) + glob[0x200] + hz[256] + tile[65536] */
+	snprintf(path, sizeof path, "%s.pass%02d.cap", fist_prefix, r9200_passno);
+	FILE *f = fopen(path, "wb");
+	if (f) {
+		Bit32u hdr[5] = { 0x43323952u /*'R92C'*/, (Bit32u)r9200_passno, r9200_esi, r9200_ebp, r9200_hzptr };
+		fwrite(hdr, 4, 5, f);
+		fwrite(r9200_glob, 1, 0x200, f);
+		fwrite(r9200_hz, 1, 256, f);
+		static Bit8u tile[65536];          /* colormap tile @ ext-flat 0x44200 (SMC 3918 base) */
+		for (int i = 0; i < 65536; i++) tile[i] = mem_readb(r9200_base + 0x44200 + i);
+		fwrite(tile, 1, 65536, f);
+		fclose(f);
+	}
+	snprintf(path, sizeof path, "%s.pass%02d.vram.bin", fist_prefix, r9200_passno);
+	f = fopen(path, "wb"); if (f) { fwrite(vga.mem.linear, 1, 256*1024, f); fclose(f); }
+	snprintf(path, sizeof path, "%s.pass%02d.pal.bin", fist_prefix, r9200_passno);
+	f = fopen(path, "wb"); if (f) { fwrite(vga.dac.rgb, 1, sizeof(vga.dac.rgb), f); fclose(f); }
+	Bit32u g4  = *(Bit32u*)(r9200_glob+0x1d4), g8  = *(Bit32u*)(r9200_glob+0x1d8);
+	Bit32u gb8 = *(Bit32u*)(r9200_glob+0x1b8), gbc = *(Bit32u*)(r9200_glob+0x1bc);
+	Bit32u gf0 = *(Bit32u*)(r9200_glob+0x1f0), gf8 = *(Bit32u*)(r9200_glob+0x1f8);
+	fprintf(stderr, "[r92cap] pass %02d esi=%08x ebp=%08x 90d4=%08x 90d8=%08x(row%d) 90b8=%08x 90bc=%08x "
+		"90f0=%u 90f8=%u hzptr=%08x vga.mode=%d pmode=%d\n",
+		r9200_passno, r9200_esi, r9200_ebp, g4, g8, (g8>>24)&0xff, gb8, gbc, gf0, gf8,
+		r9200_hzptr, (int)vga.mode, (int)cpu.pmode);
+	fprintf(stderr, "[r92cam] pass %02d tcbptr=%08x  A[ext-rel]: X=%d Y=%d alt=%d head=%u pitch(+3a)=%d roll(+3c)=%d foc=%u det=%u\n",
+		r9200_passno, r9200_tcbptr,
+		(int)r9200_cam_a[0], (int)r9200_cam_a[1], (int)r9200_cam_a[2], r9200_cam_a[3],
+		(Bit16s)r9200_cam_a[4], (Bit16s)r9200_cam_a[5], r9200_cam_a[6], r9200_cam_a[7]);
+	fprintf(stderr, "[r92cam] pass %02d              B[abs   ]: X=%d Y=%d alt=%d head=%u pitch(+3a)=%d roll(+3c)=%d foc=%u det=%u\n",
+		r9200_passno,
+		(int)r9200_cam_b[0], (int)r9200_cam_b[1], (int)r9200_cam_b[2], r9200_cam_b[3],
+		(Bit16s)r9200_cam_b[4], (Bit16s)r9200_cam_b[5], r9200_cam_b[6], r9200_cam_b[7]);
+	/* ---- LIGHT-TILE PHYS RESOLUTION: translate the render-time tile linear address
+	 * (ext base r9200_base + 0x44200 = 0x10044200) through the CURRENT CR3 to the phys
+	 * page that actually backs the tile 9200 sampled this frame. Print + dump full RAM
+	 * once so the light tile's builder/source can be pinned by a phys last-writer. */
+	{
+		Bit32u tlin = r9200_base + 0x44200;
+		Bit32u tph  = fist_flat_to_phys(tlin);
+		Bit32u tsmc = mem_readd(r9200_base + 0x3918);  /* the SMC tile base ds:0x3918 */
+		Bit32u smclin = r9200_base + (tsmc & 0x00ffffffu);
+		Bit32u smcph  = fist_flat_to_phys(smclin);
+		/* the 0x689a resample SOURCE = ds:0x3911; detail params ds:0x3916/0x391c; dispatch ds:0x3958 */
+		Bit32u src3911 = mem_readd(r9200_base + 0x3911);
+		Bit32u p3916   = mem_readd(r9200_base + 0x3916);
+		Bit32u p391c   = mem_readd(r9200_base + 0x391c);
+		Bit32u disp3958= mem_readd(r9200_base + 0x3958);
+		Bit32u srclin  = r9200_base + (src3911 & 0x00ffffffu);
+		Bit32u srcph   = fist_flat_to_phys(srclin);
+		fprintf(stderr, "[r92phys] pass %02d cr3=%08x paging=%d  tile_lin=%08x->phys=%08x  "
+			"ds:3918=%08x smclin=%08x->phys=%08x  ds:3911(SRC)=%08x srclin=%08x->phys=%08x "
+			"ds:3916=%08x ds:391c=%08x ds:3958(disp)=%08x\n",
+			r9200_passno, (Bit32u)paging.cr3, (int)paging.enabled, tlin, tph, tsmc, smclin, smcph,
+			src3911, srclin, srcph, p3916, p391c, disp3958);
+		{ /* dump the 0x689a resample SOURCE (256KB from ds:0x3911, paging-translated) */
+			static Bit8u src[0x40000];
+			for (int i = 0; i < 0x40000; i++) src[i] = mem_readb(srclin + i);
+			char sp[700]; snprintf(sp, sizeof sp, "%s.pass%02d.src3911.bin", fist_prefix, r9200_passno);
+			FILE *sf = fopen(sp, "wb"); if (sf) { fwrite(src, 1, 0x40000, sf); fclose(sf); }
+		}
+		static int ramdumped = 0;
+		if (!ramdumped) {
+			ramdumped = 1;
+			snprintf(path, sizeof path, "%s.pass%02d.ram.bin", fist_prefix, r9200_passno);
+			f = fopen(path, "wb");
+			if (f) {
+				Bitu bytes = MEM_TotalPages() * 4096;
+				if (bytes > 16u*1024*1024) bytes = 16u*1024*1024;
+				fwrite(MemBase, 1, bytes, f); fclose(f);
+				fprintf(stderr, "[r92phys] dumped full RAM %s (%lu bytes)\n", path, (unsigned long)bytes);
+			}
+		}
+	}
+}
+/* ==== end 9200 frame-matched capture ==== */
+
+/* ==== wasm-fist 6980 voxel-raycaster FRAME-MATCHED input capture (env FIST_R6980CAP) ====
+ * The colour gate.  The 9200 .cap captures the AFFINE renderer's tile-space camera at
+ * 9200-entry -- but 8120 runs between 6980 (the voxel tile-fill) and 9200 and OVERWRITES
+ * the shared 90d4/90d8 slots, so the .cap globals are USELESS for 6980 (world-space).
+ * This capture snapshots 6980's OWN world camera + depth ramps + the render-time colormap,
+ * read through LIVE paging AT 6980 execution (mid-fill) -- so the colormap dumped is the
+ * exact bytes 6980 dereferences THIS frame, not the frame-skewed 8120-boundary page a full
+ * RAM dump catches.  6980's colour source is a FIXED displacement (6b1a: mov al,[esi+ecx+
+ * 0x100000], esi=[0x85bc]) -- no SMC redirect -- and 6980 stores that byte verbatim (6b2b/
+ * 6bab: rep stos al).  We ALSO accumulate 6980's actual tile stores into a shadow, so the
+ * dumped shadow IS 6980's true render-time output (== the colormap bytes it read).
+ *   entry range 0x10006980..0x10006c00 = the 6980 body; stores at 0x10006b2b / 0x10006bab.
+ * Dumps at the paired 9200-entry (so the completed tile + this frame's world camera + the
+ * 9200 pass number all line up with the existing r92 .cap tile of the same passno). */
+static int    r6980_cap = 0;
+static int    r6980_active = 0;             /* 6980 snapshot captured this frame, awaiting 9200 */
+static Bit32u r6980_base = 0x10000000;
+static Bit8u  r6980_ext[0x200];             /* ext[0x9000..0x9200] at 6980 time (world camera) */
+static Bit32u r6980_g[16];                  /* 85bc,85b8,3909,3918,38ed,38f1,38fd,3901,3905,3a20,90c0,90dc,90e0,90fc,9100,90c4 */
+static Bit32u r6980_ramp[4*256];            /* 3a24[256], 3e24[256], 4224[256], 4624[256] */
+static Bit8u  r6980_shadow[0x10000];        /* 6980's ACTUAL tile stores (offset<-flat 0x44200) */
+static int    r6980_mapdumped = 0;
+
+/* read-side capture of the 6980 colour load `mov al,[esi+ecx+0x100000]` (6b1a/6b9a):
+ * records the REAL effective address the CPU dereferences + the value it gets, resolving
+ * the dark-plane paradox (my mem_readb of the same flat addr reads dark, but the store is
+ * light).  Armed only during the settled 6980 pass; capped sample buffer. */
+volatile int fist_memread_armed = 0;
+static Bit32u r6980_rd_phys[64], r6980_rd_flat[64], r6980_rd_esi[64];
+static Bit8u  r6980_rd_val[64];
+static int    r6980_rd_n = 0;
+static Bit32u r6980_rd_valhist[256];
+static int    r6980_rd_total = 0;
+static Bit32u r6980_hm_phys0 = 0;   /* first heightmap-read (6aeb) phys, 1MB page banked */
+extern "C" void fist_memread(Bit8u *off) {
+	Bit32u lin = SegPhys(cs) + reg_eip;
+	if (lin == 0x10006aeb || lin == 0x10006b6b) {  /* heightmap reads `add al,[esi+ecx]` (both loops) */
+		if (!r6980_hm_phys0) r6980_hm_phys0 = (Bit32u)(off - MemBase);
+		return;
+	}
+	if (lin != 0x10006b1a && lin != 0x10006b9a) return;
+	Bit32u ph = (Bit32u)(off - MemBase);
+	Bit8u v = *off;
+	r6980_rd_valhist[v]++; r6980_rd_total++;
+	if (r6980_rd_n < 64) {
+		r6980_rd_phys[r6980_rd_n] = ph;
+		r6980_rd_flat[r6980_rd_n] = reg_esi + reg_ecx + 0x100000;  /* the flat EA the asm forms */
+		r6980_rd_esi[r6980_rd_n]  = reg_esi;
+		r6980_rd_val[r6980_rd_n]  = v;
+		r6980_rd_n++;
+	}
+}
+
+static void r6980_snapshot(void) {
+	r6980_base = SegPhys(cs);
+	for (int i = 0; i < 0x200; i++) r6980_ext[i] = mem_readb(r6980_base + 0x9000 + i);
+	static const Bit32u go[16] = {0x85bc,0x85b8,0x3909,0x3918,0x38ed,0x38f1,0x38fd,0x3901,
+	                              0x3905,0x3a20,0x90c0,0x90dc,0x90e0,0x90fc,0x9100,0x90c4};
+	for (int i = 0; i < 16; i++) r6980_g[i] = mem_readd(r6980_base + go[i]);
+	for (int i = 0; i < 256; i++) {
+		r6980_ramp[      i] = mem_readd(r6980_base + 0x3a24 + i*4);
+		r6980_ramp[256 + i] = mem_readd(r6980_base + 0x3e24 + i*4);
+		r6980_ramp[512 + i] = mem_readd(r6980_base + 0x4224 + i*4);
+		r6980_ramp[768 + i] = mem_readd(r6980_base + 0x4624 + i*4);
+	}
+	memset(r6980_shadow, 0, sizeof r6980_shadow);
+	r6980_active = 1;
+	/* arm the read-side capture for the settled passes only (keeps the hot read path fast) */
+	if (r9200_passno >= 8 && r6980_rd_total == 0) fist_memread_armed = 1;
+}
+
+/* Dump the RENDER-TIME map + proj through LIVE paging AT the colormap-read moment
+ * (the first 6b2b/6bab tile store, i.e. right after the 6b1a colormap read).  The
+ * extender re-pages its runtime buffers (proven: the proj at flat 0x24200 reads as
+ * an unmapped/zero page at 6980-ENTRY but is valid at render time), so the colormap
+ * plane [0x85bc]+0x100000 the snapshot-time read caught was the wrong page.  Reading
+ * it here, at the moment 6980 actually dereferences it, gives the exact bytes it reads. */
+static void r6980_mapdump(void) {
+	if (r6980_mapdumped) return;
+	r6980_mapdumped = 1;
+	Bit32u hb = mem_readd(r6980_base + 0x85bc);   /* re-read live: [0x85bc] */
+	char p[700];
+	static Bit8u plane[0x400000];
+	struct { Bit32u off; Bit32u len; const char *nm; } planes[4] = {
+		{0x000000,0x400000,"hm"}, {0x100000,0x100000,"cm"},
+		{0x400000,0x400000,"reduce"}, {0x800000,0x100000,"plane8"} };
+	for (int k = 0; k < 4; k++) {
+		for (Bit32u i = 0; i < planes[k].len; i++)
+			plane[i] = mem_readb(r6980_base + hb + planes[k].off + i);
+		snprintf(p, sizeof p, "%s.r6980.map_%s.bin", fist_prefix, planes[k].nm);
+		FILE *f = fopen(p, "wb"); if (f) { fwrite(plane, 1, planes[k].len, f); fclose(f); }
+	}
+	Bit32u pj = mem_readd(r6980_base + 0x3909) & 0xffffff00u;
+	static Bit8u proj[0x10000];
+	for (Bit32u i = 0; i < 0x10000; i++) proj[i] = mem_readb(r6980_base + pj + i);
+	snprintf(p, sizeof p, "%s.r6980.proj.bin", fist_prefix);
+	FILE *f = fopen(p, "wb"); if (f) { fwrite(proj, 1, 0x10000, f); fclose(f); }
+	int pjnz=0; for (int i=0;i<0x10000;i++) if(proj[i]) pjnz++;
+	/* the color read `mov al,[esi+ecx+0x100000]` uses DS; dump the colormap via DS base
+	 * (== the exact linear the CPU reads) to resolve the dark-plane paradox. */
+	Bit32u dsb = SegPhys(ds), esb = SegPhys(es), csb = SegPhys(cs);
+	static Bit8u cmds[0x100000];
+	for (Bit32u i = 0; i < 0x100000; i++) cmds[i] = mem_readb(dsb + hb + 0x100000 + i);
+	snprintf(p, sizeof p, "%s.r6980.map_cm_ds.bin", fist_prefix);
+	f = fopen(p, "wb"); if (f) { fwrite(cmds, 1, 0x100000, f); fclose(f); }
+	int cmmax=0; for(int i=0;i<0x100000;i++) if(cmds[i]>cmmax) cmmax=cmds[i];
+	fprintf(stderr, "[r6980] map @store: [85bc]=%08x [3909]=%08x proj_nz=%d  CS=%08x DS=%08x ES=%08x  cm_ds_max=%d\n",
+		hb, mem_readd(r6980_base + 0x3909), pjnz, csb, dsb, esb, cmmax);
+}
+
+static void r6980_dump(int passno) {
+	char p[700];
+	snprintf(p, sizeof p, "%s.r6980.pass%02d.bin", fist_prefix, passno);
+	FILE *f = fopen(p, "wb");
+	if (f) {
+		Bit32u hdr[2] = { 0x38393652u /*'R698'*/, (Bit32u)passno };
+		fwrite(hdr, 4, 2, f);
+		fwrite(r6980_ext, 1, 0x200, f);           /* world camera ext[0x9000..0x9200] */
+		fwrite(r6980_g, 4, 16, f);                /* named globals */
+		fwrite(r6980_ramp, 4, 4*256, f);          /* 3a24/3e24/4224/4624 */
+		static Bit8u tile[0x10000];               /* completed tile (live 0x44200) */
+		for (int i = 0; i < 0x10000; i++) tile[i] = mem_readb(r6980_base + 0x44200 + i);
+		fwrite(tile, 1, 0x10000, f);
+		fwrite(r6980_shadow, 1, 0x10000, f);      /* 6980's actual stores = its colormap reads */
+		fclose(f);
+	}
+	/* gate-A one-line summary: 6980's stored values (its colormap reads) light or dark? */
+	int nw=0; long sum=0; int mn=255,mx=0; int seen[256]; memset(seen,0,sizeof seen);
+	for (int i=0;i<0x10000;i++){ if(r6980_shadow[i]){ nw++; int v=r6980_shadow[i]; sum+=v; if(v<mn)mn=v; if(v>mx)mx=v; seen[v]=1; } }
+	int dist=0; for(int i=0;i<256;i++) dist+=seen[i];
+	Bit32u g4=*(Bit32u*)(r6980_ext+0x1d4), g8=*(Bit32u*)(r6980_ext+0x1d8);
+	fprintf(stderr,"[r6980] pass %02d 90d4=%08x 90d8=%08x 90dc=%08x nstores=%d val(mean=%ld min=%d max=%d dist=%d)%s\n",
+		passno, g4, g8, r6980_g[11], nw, nw?sum/nw:0, nw?mn:0, mx, dist, mx>=140?"  <- LIGHT":"  <- dark");
+	/* read-side capture report: what the 6b1a/6b9a colour load actually dereferenced */
+	if (fist_memread_armed && r6980_rd_total > 0) {
+		int rmn=255,rmx=0; long rs=0; for(int i=0;i<256;i++){ if(r6980_rd_valhist[i]){ if(i<rmn)rmn=i; if(i>rmx)rmx=i; rs+=(long)i*r6980_rd_valhist[i]; } }
+		fprintf(stderr,"[r6980rd] pass %02d nreads=%d colorval(mean=%ld min=%d max=%d)  samples(flat->phys=val):",
+			passno, r6980_rd_total, r6980_rd_total?rs/r6980_rd_total:0, rmn, rmx);
+		for (int i=0;i<8 && i<r6980_rd_n;i++)
+			fprintf(stderr," %08x->%08x=%02x(esi=%08x)", r6980_rd_flat[i], r6980_rd_phys[i], r6980_rd_val[i], r6980_rd_esi[i]);
+		fprintf(stderr,"\n");
+		/* dump the phys-page(s) the colour read actually hit, 1MB from the first sample's page */
+		if (r6980_rd_n > 0) {
+			/* Dump the real colormap + heightmap the CPU actually read, GUEST-PHYS direct (MemBase):
+			 * mem_readb of these flat addrs is UNRELIABLE (returns the dark map-load page, not the
+			 * page the CPU's PM-paged read hit).  The read hook captured the true phys the CPU read;
+			 * dump the 1MB-aligned page holding it.  Colour read phys = flat(esi+coord+0x100000);
+			 * height read phys = flat(esi+coord).  We record coord=0's phys for each and dump the
+			 * page, reconstructing coord-indexing offline from the flat->phys stride. */
+			Bit32u cpg = r6980_rd_phys[0] & 0xfff00000u;
+			Bit32u hpg = r6980_hm_phys0   & 0xfff00000u;
+			static Bit8u realcm[0x100000], realhm[0x100000];
+			for (Bit32u i=0;i<0x100000;i++){ realcm[i]=MemBase[cpg+i]; realhm[i]=MemBase[hpg+i]; }
+			char pp[700];
+			snprintf(pp,sizeof pp,"%s.r6980.realcm.bin",fist_prefix);
+			FILE *rf=fopen(pp,"wb"); if(rf){ fwrite(realcm,1,0x100000,rf); fclose(rf); }
+			snprintf(pp,sizeof pp,"%s.r6980.realhm.bin",fist_prefix);
+			rf=fopen(pp,"wb"); if(rf){ fwrite(realhm,1,0x100000,rf); fclose(rf); }
+			int cmx=0,hmx=0; for(int i=0;i<0x100000;i++){ if(realcm[i]>cmx)cmx=realcm[i]; if(realhm[i]>hmx)hmx=realhm[i]; }
+			/* the intra-page offset of coord=0's colour read = phys - 1MB base; the colormap for
+			 * coord starts at (phys0 - (flat0 low bits within page)).  Emit both so the offline
+			 * reproduction can align coord->buffer index exactly. */
+			fprintf(stderr,"[r6980rd2] cm_phys=%08x(pg %08x off %05x flat %08x) hm_phys=%08x(pg %08x off %05x) realcm_max=%d realhm_max=%d\n",
+				r6980_rd_phys[0], cpg, r6980_rd_phys[0]-cpg, r6980_rd_flat[0], r6980_hm_phys0, hpg, r6980_hm_phys0-hpg, cmx, hmx);
+		}
+		fist_memread_armed = 0;   /* one settled pass is enough; restore the fast read path */
+	}
+}
+/* ==== end 6980 capture ==== */
+
+/* Records the CS:EIP of any guest write whose physical target lands in the tile
+ * range.  Called (gated on fist_mem_armed) from host_writeb in include/mem.h. */
+extern "C" void fist_memrec(Bit8u *off, Bit8u val) {
+	Bit32u ph = (Bit32u)(off - MemBase);
+	/* 6980 capture: snapshot on the first 6980-body write of a frame; accumulate its stores */
+	if (r6980_cap) {
+		Bit32u lin = SegPhys(cs) + reg_eip;
+		if (lin >= 0x10006980 && lin < 0x10006c00) {
+			if (!r6980_active) r6980_snapshot();
+			if (lin == 0x10006b2b || lin == 0x10006bab) {  /* the two rep-stos tile writers */
+				r6980_mapdump();   /* dump colormap at render-time paging (first store) */
+				/* es:[edi] with es base flat: edi = flat linear offset; tile base flat 0x44200 */
+				Bit32u foff = reg_edi - 0x44200;
+				if (foff < 0x10000) r6980_shadow[foff] = val;
+			}
+		}
+	}
+	/* 9200 frame-matched capture: 8120 recomputing frame F+1's globals = frame F boundary */
+	if (r9200_cap && r9200_have) {
+		Bit32u lin = SegPhys(cs) + reg_eip;
+		if (lin >= 0x10008120 && lin < 0x10008260) {
+			if (r9200_passno < r9200_maxpass) { r9200_dump(); r9200_passno++; }
+			r9200_have = 0; r9200_inpass = 0;
+			if (r9200_passno >= r9200_maxpass) r9200_cap = 0;   /* stop after N frames */
+		}
+	}
+	if (fist_watch_hi && ph >= fist_watch_lo && ph < fist_watch_hi && fist_watch_hits < 40000) {
+		fist_watch_hits++;
+		char wpath[600]; snprintf(wpath, sizeof wpath, "%s.watch.txt", fist_prefix);
+		FILE *wf = fopen(wpath, "a");
+		if (wf) {
+			Bit32u ssb = SegPhys(ss), flatip = SegPhys(cs) + reg_eip;
+			fprintf(wf, "WATCH ph=%08x val=%02x flatip=%08x cs=%04x eip=%08x ss=%04x sp=%08x stack:",
+				ph, val, flatip, SegValue(cs), reg_eip, SegValue(ss), reg_esp);
+			for (int k = 0; k < 20; k++) fprintf(wf, " %04x", mem_readw(ssb + reg_esp + k * 2));
+			fprintf(wf, "\n");
+			fclose(wf);
+		}
+	}
+	if (fist_wf_span) {
+		/* CR3-aware: re-map on CR3/paging-enable change or every 64K writes */
+		if ((Bit32u)paging.cr3 != fist_wf_lastcr3 || (int)paging.enabled != fist_wf_lasten
+		    || ((fist_wf_seq++ & 0xffffu) == 0)) fist_wf_remap();
+		Bit32u phpg = ph & ~0xfffu;
+		for (int i = 0; i < fist_wf_npg; i++) {
+			if (fist_wf_physpg[i] == phpg) {
+				Bit32u flataddr = fist_wf_flatpg[i] + (ph & 0xfffu);
+				if (flataddr >= fist_wf_base && flataddr < fist_wf_base + fist_wf_span)
+					fist_flatrec(flataddr - fist_wf_base, val);
+				break;
+			}
+		}
+	}
+	if (ph < fist_tile_lo || ph >= fist_tile_hi) return;
+	Bit32u ipl = SegPhys(cs) + reg_eip, off16 = ph - fist_tile_lo;
+	/* per-byte LAST-writer (decisive: who owns each final tile byte) */
+	if (off16 < 0x10000) { fist_lastip[off16] = ipl; fist_lastval[off16] = val; }
+	for (int i = 0; i < fist_nment; i++) {
+		if (fist_ment[i].ip == ipl) {
+			fist_ment[i].count++;
+			if (off16 < fist_ment[i].minoff) fist_ment[i].minoff = off16;
+			if (off16 > fist_ment[i].maxoff) fist_ment[i].maxoff = off16;
+			return;
+		}
+	}
+	if (fist_nment < FIST_NENT) {
+		FistMEnt *e = &fist_ment[fist_nment++];
+		e->ip = ipl; e->cs = SegValue(cs); e->eip = reg_eip; e->count = 1;
+		e->minoff = e->maxoff = off16; e->firstval = val;
+		Bit32u ssb = SegPhys(ss);
+		for (int k = 0; k < 20; k++) e->stk[k] = mem_readw(ssb + reg_esp + k * 2);
+	}
+}
+
+static void fist_dump(void) {
+	char path[600];
+	/* 1. writer histogram + code bytes */
+	snprintf(path, sizeof path, "%s.writers.txt", fist_prefix);
+	FILE *f = fopen(path, "w");
+	if (f) {
+		fprintf(f, "# vga A0000 writers over armed window: %d distinct IPs\n", fist_nent);
+		fprintf(f, "# cpu.pmode=%d  vga.mode=%d\n", (int)cpu.pmode, (int)vga.mode);
+		/* simple selection sort by count desc */
+		for (int i = 0; i < fist_nent; i++) {
+			int mx = i;
+			for (int j = i + 1; j < fist_nent; j++)
+				if (fist_ent[j].count > fist_ent[mx].count) mx = j;
+			FistWEnt t = fist_ent[i]; fist_ent[i] = fist_ent[mx]; fist_ent[mx] = t;
+		}
+		for (int i = 0; i < fist_nent && i < 64; i++) {
+			FistWEnt *e = &fist_ent[i];
+			fprintf(f, "\nWRITER lin=%08x cs=%04x eip=%08x count=%u off=[%04x..%04x] firstval=%02x\n",
+				e->lin, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) {
+				if (k == 0) fprintf(f, "| ");
+				fprintf(f, "%02x ", mem_readb(e->lin + k));
+			}
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 2. guest physical RAM (heightmap/colormap/camera live here) */
+	snprintf(path, sizeof path, "%s.ram.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) {
+		Bitu bytes = MEM_TotalPages() * 4096;
+		if (bytes > 16u * 1024 * 1024) bytes = 16u * 1024 * 1024;
+		fwrite(MemBase, 1, bytes, f);
+		fclose(f);
+	}
+	/* 3. VGA linear video memory (raw mode-13h/chain4 layout) */
+	snprintf(path, sizeof path, "%s.vram.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(vga.mem.linear, 1, 256 * 1024, f); fclose(f); }
+	/* 4. DAC palette (256*3, 6-bit) */
+	snprintf(path, sizeof path, "%s.pal.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(vga.dac.rgb, 1, sizeof(vga.dac.rgb), f); fclose(f); }
+	/* 5. tile-3918 (phys range) writers: CS:EIP histogram + code bytes */
+	snprintf(path, sizeof path, "%s.tilewriters.txt", fist_prefix);
+	f = fopen(path, "w");
+	if (f) {
+		fprintf(f, "# tile writers over armed window, phys=[%08x..%08x): %d distinct IPs\n",
+			fist_tile_lo, fist_tile_hi, fist_nment);
+		for (int i = 0; i < fist_nment; i++) {
+			int mx = i;
+			for (int j = i + 1; j < fist_nment; j++)
+				if (fist_ment[j].count > fist_ment[mx].count) mx = j;
+			FistMEnt t = fist_ment[i]; fist_ment[i] = fist_ment[mx]; fist_ment[mx] = t;
+		}
+		for (int i = 0; i < fist_nment && i < 48; i++) {
+			FistMEnt *e = &fist_ment[i];
+			fprintf(f, "\nTILEWRITER lin=%08x cs=%04x eip=%08x count=%u tileoff=[%04x..%04x] firstval=%02x\n",
+				e->ip, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) {
+				if (k == 0) fprintf(f, "| ");
+				fprintf(f, "%02x ", mem_readb(e->ip + k));
+			}
+			fprintf(f, "\n  stack:");
+			for (int k = 0; k < 20; k++) fprintf(f, " %04x", e->stk[k]);
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 5b. PER-BYTE LAST-WRITER: dump the final-value map (compare == oracle tile) + a
+	 * histogram of which CS:EIP OWNS each final tile byte (decisive producer id). */
+	snprintf(path, sizeof path, "%s.lastval.bin", fist_prefix);
+	f = fopen(path, "wb");
+	if (f) { fwrite(fist_lastval, 1, sizeof fist_lastval, f); fclose(f); }
+	snprintf(path, sizeof path, "%s.lastwriters.txt", fist_prefix);
+	f = fopen(path, "w");
+	if (f) {
+		/* histogram distinct last-writer IPs over [0..0xffff] */
+		struct { Bit32u ip, count, minoff, maxoff; } h[256]; int nh = 0;
+		for (Bit32u o = 0; o < 0x10000; o++) {
+			Bit32u ip = fist_lastip[o];
+			if (!ip) continue;
+			int j; for (j = 0; j < nh; j++) if (h[j].ip == ip) break;
+			if (j == nh && nh < 256) { h[nh].ip = ip; h[nh].count = 0; h[nh].minoff = o; h[nh].maxoff = o; nh++; }
+			if (j < 256) { h[j].count++; if (o < h[j].minoff) h[j].minoff = o; if (o > h[j].maxoff) h[j].maxoff = o; }
+		}
+		fprintf(f, "# PER-BYTE LAST-WRITER over tile [%08x..%08x): %d distinct owning IPs\n",
+			fist_tile_lo, fist_tile_lo + 0x10000, nh);
+		for (int i = 0; i < nh; i++) {  /* selection sort by count desc */
+			int mx = i; for (int j = i + 1; j < nh; j++) if (h[j].count > h[mx].count) mx = j;
+			{ Bit32u ti=h[i].ip,tc=h[i].count,tmn=h[i].minoff,tmx=h[i].maxoff;
+			  h[i]=h[mx]; h[mx].ip=ti;h[mx].count=tc;h[mx].minoff=tmn;h[mx].maxoff=tmx; }
+		}
+		for (int i = 0; i < nh; i++) {
+			fprintf(f, "\nLASTWRITER lin=%08x extip=%05x count=%u tileoff=[%04x..%04x]\n",
+				h[i].ip, h[i].ip & 0xfffff, h[i].count, h[i].minoff, h[i].maxoff);
+			fprintf(f, "  code@lin-16: ");
+			for (int k = -16; k < 48; k++) { if (k==0) fprintf(f,"| "); fprintf(f, "%02x ", mem_readb(h[i].ip + k)); }
+			fprintf(f, "\n");
+		}
+		fclose(f);
+	}
+	/* 6. CR3-AWARE flat-address (tile-3918) writers: histogram + backtrace + map */
+	if (fist_wf_span) {
+		snprintf(path, sizeof path, "%s.flatwriters.txt", fist_prefix);
+		f = fopen(path, "w");
+		if (f) {
+			fprintf(f, "# CR3-aware flat writers, flat=[%08x..%08x): %d distinct IPs\n",
+				fist_wf_base, fist_wf_base + fist_wf_span, fist_nfent);
+			fprintf(f, "# final flat->phys map (npg=%d, cr3=%08x, paging=%d):\n",
+				fist_wf_npg, (Bit32u)paging.cr3, (int)paging.enabled);
+			for (int i = 0; i < fist_wf_npg; i++)
+				fprintf(f, "#   flatpg %08x -> physpg %08x\n", fist_wf_flatpg[i], fist_wf_physpg[i]);
+			for (int i = 0; i < fist_nfent; i++) {
+				int mx = i;
+				for (int j = i + 1; j < fist_nfent; j++)
+					if (fist_fent[j].count > fist_fent[mx].count) mx = j;
+				FistFEnt t = fist_fent[i]; fist_fent[i] = fist_fent[mx]; fist_fent[mx] = t;
+			}
+			for (int i = 0; i < fist_nfent && i < 48; i++) {
+				FistFEnt *e = &fist_fent[i];
+				fprintf(f, "\nFLATWRITER lin=%08x cs=%04x eip=%08x count=%u flatoff=[%04x..%04x] firstval=%02x\n",
+					e->ip, e->cs, e->eip, e->count, e->minoff, e->maxoff, e->firstval & 0xff);
+				fprintf(f, "  code@lin-16: ");
+				for (int k = -16; k < 48; k++) {
+					if (k == 0) fprintf(f, "| ");
+					fprintf(f, "%02x ", mem_readb(e->ip + k));
+				}
+				fprintf(f, "\n  stack:");
+				for (int k = 0; k < 20; k++) fprintf(f, " %04x", e->stk[k]);
+				fprintf(f, "\n");
+			}
+			fclose(f);
+		}
+	}
+	fprintf(stderr, "[fist-oracle] dumped %s.{writers.txt,tilewriters.txt,flatwriters.txt,ram.bin,vram.bin,pal.bin}\n", fist_prefix);
+}
