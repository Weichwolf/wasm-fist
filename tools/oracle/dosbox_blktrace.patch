board:0013 dynamic basic-block trace -- dump every EXECUTED instruction once (dedup by linear: a
bitmap below 32 MB, an open-addressing set above it -- the extender maps the 32-bit app high) as "cs:eip linear <16 opcode bytes>", to reconstruct the executed program (overlay flight model,
indirect edges, SMC, the code static Ghidra cannot reach).  Env: FIST_BLKTRACE=<path>, optional
FIST_BLKTRACE_LO/_HI (hex linear scope) and FIST_BLKTRACE_CS (hex, one code segment).  Also
FIST_REGTRACE=<path> FIST_REGTRACE_LIN=<hex>[,<hex>..]: the general registers each time execution
reaches one of the listed linears (the extender's register carries, board:0002).  Insert in the
normal core's per-instruction loop (after the 0a28 hook), before the C_DEBUG block.  Apply to
third_party/dosbox-build/dosbox-0.74-3/src/cpu/core_normal.cpp then `make`.
--- a/src/cpu/core_normal.cpp
+++ b/src/cpu/core_normal.cpp
@@ after the fist_0a28 hook in CPU_Core_Normal_Run() @@
 		if (fist_0a28_f && SegValue(cs)==(Bitu)fist_0a28_seg && (reg_eip&0xffff)==0x0a28) {
 			fist_0a28_count++;
 			fprintf(fist_0a28_f,"%.4f\n", PIC_FullIndex());
 		}
+		/* board:0013 FIST_BLKTRACE=<path>: dump every executed instruction ONCE (dedup by linear via a
+		 * bitmap) as "cs:eip linear <16 opcode bytes>" -> offline reassemble the EXECUTED program (the
+		 * overlay flight/combat model, resolving indirect edges / SMC / the 0x100000 code that static
+		 * Ghidra cannot).  Optional FIST_BLKTRACE_LO / _HI (hex linear) scope; FIST_BLKTRACE_CS (hex) to
+		 * one code segment.  Loops/repeated calls collapse to one line -> bounded output. */
+		static int fist_blk_init = 0; static FILE* fist_blk_f = 0;
+		static unsigned char* fist_blk_seen = 0;
+		static Bit32u fist_blk_lo = 0, fist_blk_hi = 0xffffffffu; static int fist_blk_cs = -1;
+		if (!fist_blk_init) { fist_blk_init = 1;
+			const char* p = getenv("FIST_BLKTRACE");
+			if (p) { fist_blk_f = fopen(p, "w");
+				fist_blk_seen = (unsigned char*)calloc(0x2000000/8, 1);
+				const char* lo = getenv("FIST_BLKTRACE_LO"); if (lo) fist_blk_lo = (Bit32u)strtoul(lo,0,16);
+				const char* hi = getenv("FIST_BLKTRACE_HI"); if (hi) fist_blk_hi = (Bit32u)strtoul(hi,0,16);
+				const char* cs = getenv("FIST_BLKTRACE_CS"); if (cs) fist_blk_cs = (int)strtol(cs,0,16);
+			}
+		}
+		if (fist_blk_f && fist_blk_seen && (fist_blk_cs < 0 || SegValue(cs)==(Bitu)fist_blk_cs)) {
+			Bit32u lin = (Bit32u)core.cseip;
+			if (lin >= fist_blk_lo && lin < fist_blk_hi) {
+				/* below 32 MB a bitmap; above it (the extender maps the 32-bit app at a high linear
+				 * address -- the windshield code lives there, board:0002) an open-addressing set. */
+				int fresh = 0;
+				if (lin < 0x2000000) {
+					if (!(fist_blk_seen[lin>>3] & (1u<<(lin&7)))) { fist_blk_seen[lin>>3] |= (1u<<(lin&7)); fresh = 1; }
+				} else {
+					static Bit32u* hi_set = 0; static Bit32u hi_n = 0; const Bit32u HI_CAP = 1u<<22;
+					if (!hi_set) hi_set = (Bit32u*)calloc(HI_CAP, sizeof(Bit32u));
+					if (hi_n < HI_CAP/2) {
+						Bit32u h = (lin * 2654435761u) & (HI_CAP-1);
+						while (hi_set[h] && hi_set[h] != lin) h = (h+1) & (HI_CAP-1);
+						if (!hi_set[h]) { hi_set[h] = lin; hi_n++; fresh = 1; }
+					}
+				}
+				if (fresh) {
+					char b[33]; for (int i=0;i<16;i++) sprintf(b+i*2,"%02x",(unsigned)mem_readb(lin+i));
+					fprintf(fist_blk_f,"%04x:%08x %08x %s\n",(unsigned)SegValue(cs),(unsigned)reg_eip,(unsigned)lin,b);
+				}
+			}
+		}
+		/* board:0002 FIST_REGTRACE=<path> FIST_REGTRACE_LIN=<hex>[,<hex>..]: the general registers every
+		 * time execution reaches one of the listed linears (the extender's stale-register carries). */
+		static int fist_reg_init = 0; static FILE* fist_reg_f = 0; static Bit32u fist_reg_lin[16]; static int fist_reg_n = 0;
+		if (!fist_reg_init) { fist_reg_init = 1;
+			const char* p = getenv("FIST_REGTRACE");
+			if (p) { fist_reg_f = fopen(p, "w");
+				const char* l = getenv("FIST_REGTRACE_LIN");
+				while (l && *l && fist_reg_n < 16) { fist_reg_lin[fist_reg_n++] = (Bit32u)strtoul(l, (char**)&l, 16); if (*l == ',') l++; }
+			}
+		}
+		if (fist_reg_f) { Bit32u lin = (Bit32u)core.cseip;
+			for (int i = 0; i < fist_reg_n; i++) if (lin == fist_reg_lin[i]) {
+				/* ret= the word at ss:sp -- at a `ret` linear this is the caller's return offset (board:0017's
+				 * RNG-draw attribution); [sp+2] for a far return's segment. */
+				fprintf(fist_reg_f, "%04x:%08x lin=%08x eax=%08x ebx=%08x ecx=%08x edx=%08x esi=%08x edi=%08x ebp=%08x esp=%08x ret=%04x:%04x t=%.4f\n",
+					(unsigned)SegValue(cs), (unsigned)reg_eip, (unsigned)lin, (unsigned)reg_eax, (unsigned)reg_ebx, (unsigned)reg_ecx,
+					(unsigned)reg_edx, (unsigned)reg_esi, (unsigned)reg_edi, (unsigned)reg_ebp, (unsigned)reg_esp,
+					(unsigned)mem_readw(SegPhys(ss) + (reg_esp & 0xffff)), (unsigned)mem_readw(SegPhys(ss) + ((reg_esp + 2) & 0xffff)), PIC_FullIndex());
+				fflush(fist_reg_f); }
+			/* FIST_REGTRACE_DUMPLIN=<hex> FIST_REGTRACE_DUMPFILE=<path>: the guest's physical RAM (16 MB) the
+			 * first time execution reaches that linear -- the original's whole state at a sync point
+			 * (board:0017: the object table at the first mission sim step). */
+			static int dump_init = 0; static Bit32u dump_lin = 0; static const char* dump_file = 0; static long dump_n = 1, dump_every = 0, dump_hits = 0; static Bitu dump_base = 0, dump_len = 0;
+			if (!dump_init) { dump_init = 1; const char* dl = getenv("FIST_REGTRACE_DUMPLIN"); dump_file = getenv("FIST_REGTRACE_DUMPFILE");
+				if (dl) dump_lin = (Bit32u)strtoul(dl, 0, 16); const char* dn = getenv("FIST_REGTRACE_DUMPN"); if (dn) dump_n = atol(dn);
+				const char* de = getenv("FIST_REGTRACE_DUMPEVERY"); if (de) dump_every = atol(de);
+				const char* db = getenv("FIST_REGTRACE_DUMPBASE"); if (db) dump_base = (Bitu)strtoul(db, 0, 16);   /* a window: phys base, byte length */
+				const char* dz = getenv("FIST_REGTRACE_DUMPLEN"); if (dz) dump_len = (Bitu)strtoul(dz, 0, 16); }
+			/* the Nth hit (FIST_REGTRACE_DUMPN, default 1), or -- FIST_REGTRACE_DUMPEVERY=k -- hits 1, 1+k, 1+2k, ...
+			 * into <file>.<hit> (the sim state every k steps, for the state diff at the step the RNG streams part) */
+			if (dump_file && lin == dump_lin) { ++dump_hits; char nm[512]; const char* fn = 0;
+				if (dump_every) { if ((dump_hits - 1) % dump_every == 0) { snprintf(nm, sizeof nm, "%s.%ld", dump_file, dump_hits); fn = nm; } }
+				else if (dump_hits == dump_n) fn = dump_file;
+				if (fn) { FILE* df = fopen(fn, "wb");
+					if (df) { Bitu bytes = MEM_TotalPages() * 4096; if (bytes > 16u*1024*1024) bytes = 16u*1024*1024;
+						if (dump_len) { if (dump_base + dump_len <= bytes) fwrite(MemBase + dump_base, 1, dump_len, df); }
+						else fwrite(MemBase, 1, bytes, df);
+						fclose(df); fprintf(stderr, "[regtrace] RAM dumped at lin=%08x hit %ld -> %s\n", (unsigned)lin, dump_hits, fn); } } }
+		}
