board:0013 dynamic basic-block trace -- dump every EXECUTED instruction once (dedup by linear: a
bitmap below 32 MB, an open-addressing set above it -- the extender maps the 32-bit app high) as "cs:eip linear <16 opcode bytes>", to reconstruct the executed program (overlay flight model,
indirect edges, SMC, the code static Ghidra cannot reach).  Env: FIST_BLKTRACE=<path>, optional
FIST_BLKTRACE_LO/_HI (hex linear scope) and FIST_BLKTRACE_CS (hex, one code segment).  Insert in the
normal core's per-instruction loop (after the 0a28 hook), before the C_DEBUG block.  Apply to
third_party/dosbox-build/dosbox-0.74-3/src/cpu/core_normal.cpp then `make`.
--- a/src/cpu/core_normal.cpp
+++ b/src/cpu/core_normal.cpp
@@ after the fist_0a28 hook in CPU_Core_Normal_Run() @@
 		if (fist_0a28_f && SegValue(cs)==(Bitu)fist_0a28_seg && (reg_eip&0xffff)==0x0a28) {
 			fist_0a28_count++;
 			fprintf(fist_0a28_f,"%.4f\n", PIC_FullIndex());
 		}
+		/* board:0013 FIST_BLKTRACE=<path>: dump every executed instruction ONCE (dedup by linear via a
+		 * bitmap) as "cs:eip linear <16 opcode bytes>" -> offline reassemble the EXECUTED program (the
+		 * overlay flight/combat model, resolving indirect edges / SMC / the 0x100000 code that static
+		 * Ghidra cannot).  Optional FIST_BLKTRACE_LO / _HI (hex linear) scope; FIST_BLKTRACE_CS (hex) to
+		 * one code segment.  Loops/repeated calls collapse to one line -> bounded output. */
+		static int fist_blk_init = 0; static FILE* fist_blk_f = 0;
+		static unsigned char* fist_blk_seen = 0;
+		static Bit32u fist_blk_lo = 0, fist_blk_hi = 0xffffffffu; static int fist_blk_cs = -1;
+		if (!fist_blk_init) { fist_blk_init = 1;
+			const char* p = getenv("FIST_BLKTRACE");
+			if (p) { fist_blk_f = fopen(p, "w");
+				fist_blk_seen = (unsigned char*)calloc(0x2000000/8, 1);
+				const char* lo = getenv("FIST_BLKTRACE_LO"); if (lo) fist_blk_lo = (Bit32u)strtoul(lo,0,16);
+				const char* hi = getenv("FIST_BLKTRACE_HI"); if (hi) fist_blk_hi = (Bit32u)strtoul(hi,0,16);
+				const char* cs = getenv("FIST_BLKTRACE_CS"); if (cs) fist_blk_cs = (int)strtol(cs,0,16);
+			}
+		}
+		if (fist_blk_f && fist_blk_seen && (fist_blk_cs < 0 || SegValue(cs)==(Bitu)fist_blk_cs)) {
+			Bit32u lin = (Bit32u)core.cseip;
+			if (lin >= fist_blk_lo && lin < fist_blk_hi) {
+				/* below 32 MB a bitmap; above it (the extender maps the 32-bit app at a high linear
+				 * address -- the windshield code lives there, board:0002) an open-addressing set. */
+				int fresh = 0;
+				if (lin < 0x2000000) {
+					if (!(fist_blk_seen[lin>>3] & (1u<<(lin&7)))) { fist_blk_seen[lin>>3] |= (1u<<(lin&7)); fresh = 1; }
+				} else {
+					static Bit32u* hi_set = 0; static Bit32u hi_n = 0; const Bit32u HI_CAP = 1u<<22;
+					if (!hi_set) hi_set = (Bit32u*)calloc(HI_CAP, sizeof(Bit32u));
+					if (hi_n < HI_CAP/2) {
+						Bit32u h = (lin * 2654435761u) & (HI_CAP-1);
+						while (hi_set[h] && hi_set[h] != lin) h = (h+1) & (HI_CAP-1);
+						if (!hi_set[h]) { hi_set[h] = lin; hi_n++; fresh = 1; }
+					}
+				}
+				if (fresh) {
+					char b[33]; for (int i=0;i<16;i++) sprintf(b+i*2,"%02x",(unsigned)mem_readb(lin+i));
+					fprintf(fist_blk_f,"%04x:%08x %08x %s\n",(unsigned)SegValue(cs),(unsigned)reg_eip,(unsigned)lin,b);
+				}
+			}
+		}
