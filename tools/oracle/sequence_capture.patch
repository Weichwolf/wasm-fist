--- a/src/hardware/mixer.cpp
+++ b/src/hardware/mixer.cpp
@@ -41,0 +42 @@
+#include "../gui/fist_sequence_capture.h"
@@ -362,0 +364,16 @@
+	}
+	if (getenv("FIST_SEQUENCE")) {
+		Bitu added = needed-mixer.done;
+		Bitu readpos = (mixer.pos+mixer.done)&MIXER_BUFMASK;
+		double time = PIC_FullIndex();
+		while (added) {
+			Bit16s stereo[512][2];
+			Bitu count = added < 512 ? added : 512;
+			for (Bitu i=0; i<count; ++i) {
+				stereo[i][0] = MIXER_CLIP(mixer.work[readpos][0] >> MIXER_VOLSHIFT);
+				stereo[i][1] = MIXER_CLIP(mixer.work[readpos][1] >> MIXER_VOLSHIFT);
+				readpos = (readpos+1)&MIXER_BUFMASK;
+			}
+			fist_sequence_audio(time, mixer.freq, &stereo[0][0], count);
+			added -= count;
+		}
