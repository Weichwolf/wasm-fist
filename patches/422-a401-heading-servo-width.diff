board:0012 unit-STEERING heading-servo runaway root (FUN_1000_a401).  The AZER1 self-play tank drives its
position to +-500M because heading [0x55] spirals monotonically negative without bound.  a401 is the turn
SERVO: it moves [0x55] +-1 toward a target = min(throttle[0x57]>>2, steering-table).  asm (fist_dat_image.bin
@ 0x1a44c..0x1a49e) is WORD throughout: mov ax,WORD[di+0x57];sar ax,2; cmp ax,WORD[di+0x55] (SIGNED jg/je);
dec/inc WORD[di+0x55]; test WORD[di+0x55],0x8000; and WORD[di+0x40],0xffef.  Ghidra typed [0x55] as
*(uint*) (32-bit UNSIGNED) -- so once heading goes negative (16-bit 0x8000.., a normal left turn) the 32-bit
read is a large POSITIVE value, the servo always sees current>target and DECREMENTS forever -> heading (and
velY=[0x55]>>1 via a1d6) runs away.  The 32-bit reads also pull in the adjacent throttle [0x57].  Fix:
rebase [0x55]/[0x57]/[0x40] to 16-bit (*(short*) signed for the compare/inc/dec, *(uint16_t*) for the bit
tests), matching the WORD asm.  With this the servo settles at the target and the tank steers instead of
spiralling.  (Depends on 421 which fixed a1d6/a174 velocity width.)
--- a/fist.c
+++ b/fist.c
@@ -64261,33 +64261,33 @@
     unsigned int off245 = *(uint16_t *)(gsb245 + 0x2b84 + idx245);
     uVar1 = (uint)*(byte *)(gsb245 + (uVar2 & 0x1f) + off245);
   }
-  uVar2 = *(int *)(param_1 + 0x57) >> 2;
+  uVar2 = *(short *)(param_1 + 0x57) >> 2;   /* PATCH 422: WORD asm (sar ax,2), see header */
   if ((int)uVar1 < (int)uVar2) {
     uVar2 = uVar1;
   }
-  uVar1 = *(uint *)(param_1 + 0x55);
+  uVar1 = *(short *)(param_1 + 0x55);         /* PATCH 422: SIGNED 16-bit heading (cmp ax,WORD[di+0x55]) */
   if (uVar2 == uVar1 || (int)uVar2 < (int)uVar1) {
     if (uVar2 == uVar1) {
       g_fist_cf = 0;                /* 1a464 je 1a4a0 clc */
       return;
     }
-    if ((((*(uint *)(param_1 + 0x55) & 0x8000) != 0) && ((*(byte *)(param_1 + 0x19) & 6) != 0)) &&
+    if ((((*(uint16_t *)(param_1 + 0x55) & 0x8000) != 0) && ((*(byte *)(param_1 + 0x19) & 6) != 0)) &&
        ((*(byte *)(param_1 + 0x3d) & 0xc) != 0)) {
       g_fist_cf = 0;                /* 1a477 jne 1a4a0 clc */
       return;
     }
-    *(int *)(param_1 + 0x55) = *(int *)(param_1 + 0x55) + -1;
+    *(short *)(param_1 + 0x55) = *(short *)(param_1 + 0x55) + -1;
   }
   else {
-    if ((((*(uint *)(param_1 + 0x55) & 0x8000) == 0) && ((*(byte *)(param_1 + 0x19) & 6) != 0)) &&
+    if ((((*(uint16_t *)(param_1 + 0x55) & 0x8000) == 0) && ((*(byte *)(param_1 + 0x19) & 6) != 0)) &&
        ((*(byte *)(param_1 + 0x3d) & 0xc) != 0)) {
       g_fist_cf = 0;                /* 1a48f jne 1a4a0 clc */
       return;
     }
-    *(int *)(param_1 + 0x55) = *(int *)(param_1 + 0x55) + 1;
+    *(short *)(param_1 + 0x55) = *(short *)(param_1 + 0x55) + 1;
   }
-  if (*(int *)(param_1 + 0x55) != 0) {
-    *(uint *)(param_1 + 0x40) = *(uint *)(param_1 + 0x40) & 0xffef;
+  if (*(short *)(param_1 + 0x55) != 0) {
+    *(uint16_t *)(param_1 + 0x40) = *(uint16_t *)(param_1 + 0x40) & 0xffef;
   }
   g_fist_cf = 1;                    /* 1a49e stc */
   return;
