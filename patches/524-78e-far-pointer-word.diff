-  DAT_1000_c78e = DAT_2000_aa2c + 0xea;
+  /* PATCH 524: `mov ax,[0xea2c] ; add ax,0xea ; mov [0x78e],ax` (asm 0xdad2) -- a 16-BIT read of the TCB
+   * OFFSET word DGROUP:0xea2c, plus 0xea, into the 16-bit word DGROUP:0x78e, which pairs with the segment
+   * at 0x790 as a far pointer.  DAT_2000_aa2c is #defined as a HOST POINTER
+   * (g_mem + (word[0xea2e]<<4) + word[0xea2c]), so `DAT_2000_aa2c + 0xea` stored into a WORD wrote the
+   * low 16 bits of a HOST ADDRESS -- host-dependent by construction, exactly patch 516's class. */
+  DAT_1000_c78e = (undefined2)(uint16_t)(*(uint16_t *)(g_mem + 0x2aa2c) + 0xea);
   DAT_2000_a6f1 = 0;
   DAT_1000_c790 = DAT_2000_aa2e;
   *(undefined1 *)(DAT_2000_aa2c + 0xcf) = 0;
@@ -36392,7 +36397,12 @@
   
