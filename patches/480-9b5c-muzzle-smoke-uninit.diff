+   * mov si,di; pop di; jb ret; call 9b6f` -> SI=the NEW type-0x12 puff, DI=the firer (patch 462).
+   * Ghidra passed the UNINITIALISED pseudo-var `unaff_CS` as 9b6f's object and hard-wired b1d6's CF to 0
+   * -- the single largest uninitialised-read site in the engine (10 of them), and the reason the AZER1
+   * self-play diverged native<->wasm: -O0 and -O2 leave different garbage in that slot, so the puff was
+   * built at a different DGROUP offset on each target and the object population drifted apart (one extra
+   * type-0x11 child on wasm by t=334). */
+  extern unsigned char g_fist_cf;
+  uint16_t di = (uint16_t)param_1;                                  /* the firer near offset */
+  uint16_t si = (uint16_t)FUN_1000_b1d6(0x12,(int *)(uintptr_t)di); /* 9b60 -> DI = the new object */
+  if (!(bool)g_fist_cf) FUN_0000_9b6f((int)si,(int *)(uintptr_t)di);
   return;
 }
 
