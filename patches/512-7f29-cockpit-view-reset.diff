-  DAT_2000_4f84 = DAT_2000_4f84 | 0x25;
-  *(undefined1 *)(DAT_2000_2d34 + 0xa0) = 0;
-  FUN_0000_aa2b(param_1,iVar1);
-  FUN_0000_22bb();
