+   *     7f32: c6 85 a0 00 00  movb [di+0xa0],0
+   *     7f37: e8 f1 2a        call 0xaa2b           ; DI live
+   *     7f3a: e8 7e a3        call 0x22bb
+   * Ghidra dereferenced DAT_2000_2d34 -- the player's near offset (patch 300) -- as a host pointer. */
