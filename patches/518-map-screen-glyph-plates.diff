-  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c6b4)))();
+  /* PATCH 518: `testb [0x6dab],2 ; je .. ; mov ax,0xfe8 ; cmpw [0x7b9e],0x19 ; jne .. ;
+   * add ax,[0x7b9c]` (else `mov ax,0xff8`) (asm 0x50ea-0x510b), a map-screen glyph plate the 2057/209e
+   * display-list walks dispatch.  BX is the list element's DGROUP NEAR OFFSET, which both walks publish
+   * to DGROUP:0x3e08 before dispatching; the port's dispatch cannot carry it, so it is read back there.
+   * Ghidra emitted the ENTIRE body as a bare arg-less `lcall [0x6b4]` -- no glyph id, no BX. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short bx = (unsigned short)(*(unsigned short *)(dg + 0x3e08) + 4);   /* lea bx,[bx+4] */
+  unsigned short ax;
+  if ((dg[0x6dab] & 2) != 0) {                                       /* the EDIT-mode gate */
+    ax = 0xfe8;
+    if (*(unsigned short *)(dg + 0x7b9e) == 0x19)
+      ax = (unsigned short)(ax + *(unsigned short *)(dg + 0x7b9c));
+  } else {
+    ax = 0xff8;
+  }
+  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c6b4)))(ax,bx);
   return;
 }
 
