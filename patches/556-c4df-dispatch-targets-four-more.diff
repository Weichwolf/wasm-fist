+   *     c755: 80 7c 1c 01        cmpb  $0x1,0x1c(%si)
+   *     c759: 74 17              je    0xc772
+   *     c75b: 8b 1e e0 e6        mov   0xe6e0,%bx         ; (-0x1920) the deferred-object count
+   *     c75f: 83 fb 40           cmp   $0x40,%bx
+   *     c762: 73 0e              jae   0xc772             ; bound: at most 0x20 entries
+   *     c764: 8e 2e 70 00        mov   0x70,%gs           ; GS = STRSEG
+   *     c768: 65 89 b7 6a 36     mov   %si,%gs:0x366a(%bx)
+   *     c76d: 83 06 e0 e6 02     addw  $0x2,0xe6e0
+   *     c772: f9 c3              stc ; ret
+   * The view-0x20 method that DEFERS an object instead of drawing it: it appends SI to the list at
+   * STRSEG:0x366a and always returns CF=1, so c4df's walk continues.  Every path ends at the same
+   * stc -- there is no drawing arm. */
+  extern unsigned char  g_fist_cf;
+  extern unsigned short g_fist_render_si;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short si = g_fist_render_si;
+  if (((*(unsigned short *)(dg + 0x6d2c) & 4) != 0) && (dg[(unsigned short)(si + 0x1c)] != 1)) {
+    unsigned short bx = *(unsigned short *)(dg + 0xe6e0);
+    if (bx < 0x40) {
+      unsigned strseg = *(unsigned short *)(dg + 0x70);
+      *(unsigned short *)(g_mem + ((unsigned)strseg << 4) + (unsigned short)(0x366a + bx)) = si;
+      *(unsigned short *)(dg + 0xe6e0) = (unsigned short)(bx + 2);
