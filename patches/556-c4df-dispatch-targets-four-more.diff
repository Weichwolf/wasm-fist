+void __allregs
+FUN_0000_c715(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4,
+             undefined2 param_5)
+{
+  /* PATCH 556: asm
+   *     c715: f6 06 ab 6d 02   testb  $0x2,0x6dab      ; EDIT mode?
+   *     c71a: 74 12            je     0xc72e
+   *     c71c: 0f b6 5c 1c      movzbw 0x1c(%si),%bx
+   *     c720: d1 e3            shl    $1,%bx
+   *     c722: 8b 87 0d e8      mov    0xe80d(%bx),%ax  ; (-0x17f3) the per-[si+0x1c] sprite word
+   *     c726: 8b d8            mov    %ax,%bx          ; BX = the whole word
+   *     c728: 32 e4            xor    %ah,%ah          ; AX = its low byte
+   *     c72a: e8 95 01         call   0xc8c2 ; ret      ; c8c2 ends with clc
+   *     c72e: <the deferred-object append, identical to c74d's> ; c74b: stc ; ret
+   * Both AX and BX are fully determined here, which is why this one could be written and c783 could
+   * not: c8c2 takes AH from its first argument and forces AL=0x10 itself. */
+  extern unsigned char  g_fist_cf;
+  extern unsigned short g_fist_render_si;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short si = g_fist_render_si;
+  (void)param_1;(void)param_2;(void)param_3;(void)param_4;(void)param_5;
+  if ((dg[0x6dab] & 2) != 0) {
+    unsigned short bx = (unsigned short)(dg[(unsigned short)(si + 0x1c)] << 1);
+    unsigned short ax = *(unsigned short *)(dg + (unsigned short)(0xe80d + bx));
+    FUN_0000_c8c2((undefined2)(unsigned short)(ax & 0xff),(undefined2)ax,0,(undefined2)si,0);
+    return;
+  }
+  /* c72e: the deferred-object list append, then stc */
+  if (dg[(unsigned short)(si + 0x1c)] != 1) {
+    unsigned short bx = *(unsigned short *)(dg + 0xe6e0);
+    if (bx < 0x40) {
+      unsigned strseg = *(unsigned short *)(dg + 0x70);                /* mov 0x70,%gs */
+      *(unsigned short *)(g_mem + ((unsigned)strseg << 4) + (unsigned short)(0x366a + bx)) = si;
+      *(unsigned short *)(dg + 0xe6e0) = (unsigned short)(bx + 2);
+    }
+  }
+  g_fist_cf = 1;                                                       /* c74b stc */
+  return;
