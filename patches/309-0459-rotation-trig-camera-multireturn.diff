+  uint16_t L8 = (uint16_t)((short)M >> 15);    /* [bp-8]: sign mask of M (cwd/xor/sbb abs idiom) */
+  L6 = (uint16_t)(L6 - L8);                    /* [bp-6]: abs(M) */
