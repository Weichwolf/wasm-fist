+    ((void (*)(uint,uint,uint))fist_icall_near(0x0u,(uint16_t)(*(undefined2 *)(g_mem + 0x1c000 + (uint16_t)(DAT_2000_2d32 + 0x6d7c)))))(vcx, vsi, vcx);
