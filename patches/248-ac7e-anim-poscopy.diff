+   * si = word[DS:0x9798] (= DAT_2000_5798, a DGROUP NEAR OFFSET set by ab03) -> resource at
+   * g_mem+0x1c000+si.  Ghidra typed DAT_2000_5798 as a host char* AND di as a host pointer -> SIGSEGV.
+   * Copies dwords [si+0xc]->[di+0x49], [si+0x10]->[di+0x4d] (movl) + sets bit1 of [di+0x40]. */
+  unsigned char *dg248 = (unsigned char *)g_mem + 0x1c000;
