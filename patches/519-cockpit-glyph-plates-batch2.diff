PATCH 519: twenty-four more cockpit glyph plates emitted as a bare arg-less `lcall [0x6b4]`.

Continuing the batch patch 518 started.  Ghidra emitted the ENTIRE body of each of these as
`(*(code *)fist_icall_far((uint32_t)(DAT_1000_c6b4)))(); return;` -- no player lookup, no glyph id, no BX
-- so the paint service ran on whatever AX and BX happened to hold.  DAT_2000_2d34 is the PLAYER's NEAR
OFFSET (patch 300) and BX is the display-list element's near offset, which BOTH the 2057 and 209e walks
publish to DGROUP:0x3e08 (`mov [0x3e08],bx`) immediately before dispatching.

The dominant shape, `mov di,[0x6d34] ; movzbw ax,[di+0x3f] ; add ax,K ; lea bx,[bx+4] ; lcall [0x6b4]`,
22 sites:
    751d K=0x1490   7557 0x1450   75bd 0x14a0   75d6 0x14b0   75ef 0x1480   7627 0x1550   7640 0x1560
    7a32 0x01a0     7a6c 0x01c0   7aa5 0x01b0   7ae3 0x01d0   7afc 0x01e0
    8e04 0x0748     8e1d 0x0758   8e59 0x0a10   8e72 0x0a20
    9476 0x0a30     94ae 0x0b90   9512 0x0ba0   9550 0x0bc0   958c 0x0bd0   95a5 0x0be0

Two selector variants:
    74da  `movzbw ax,[di+0x3f] ; cmpw [di],2 ; jb .. ; add ax,0x1500 ; jmp .. ; add ax,0x14f0`
          -- the glyph base depends on the player vehicle TYPE word[di] being below 2.
    95be  `mov ax,0xad0 ; testb [di+0x1a],8 ; je .. ; mov ax,0xad8`

Remaining from the 48: 74da/95be are done here, 11 were patch 518, 5 were patch 517's asm shape; the
still-open ones need their own asm -- 7597 (a different source byte, byte[DGROUP:0x8d5f], and a FIXED
bx=0x8dc4), 7fff and 8ba1 (a `mul`/shift-derived table index), 8d88 and the CS=0x1000 group 6e3d, 7100,
8668, 8708, 8725, 906d, 96bb, 97da, 9ab5 (table lookups, two of them through the `mov gs,[0x70]`
string segment -- the same GS base patch 510 restored in 8463).
--- a/fist.c
+++ b/fist.c
@@ -19970,7 +19970,19 @@
 void __allregs FUN_0000_74da(void)
 
 {
-  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c6b4)))();
+  /* PATCH 519: a cockpit glyph plate (asm 0x74da-0x74f5), one of the 48 handlers whose ENTIRE body Ghidra
+   * emitted as a bare arg-less `lcall [0x6b4]` -- no player lookup, no glyph id, no BX.
+   *     mov di,[0x6d34] ; movzbw ax,[di+0x3f] ; cmpw [di],2 ; jb .. ; add ax,0x1500 ;
+   *     jmp .. ; <lt> add ax,0x14f0 ; lea bx,[bx+4] ; lcall [0x6b4]
+   * DAT_2000_2d34 is the PLAYER's NEAR OFFSET (patch 300); BX is the display-list element's near offset,
+   * which both the 2057 and 209e walks publish to DGROUP:0x3e08 before dispatching. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short di = (unsigned short)DAT_2000_2d34;
+  unsigned short bx = (unsigned short)(*(unsigned short *)(dg + 0x3e08) + 4);
+  unsigned short ax;
+  ax = (unsigned short)(dg[(unsigned short)(di + 0x3f)]
+            + ((*(unsigned short *)(dg + di) < 2) ? 0x14f0 : 0x1500));
+  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c6b4)))(ax,bx);
   return;
 }
 
