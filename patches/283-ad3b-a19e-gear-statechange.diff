+    if ((int)*(short *)(dg + (unsigned short)(di + 0x34)) < 0xe00) {
+      if (dg[(unsigned short)(di + 0x90)] == '\0') {
         return;
       }
     }
-    else if (*(char *)(param_1 + 0x90) == '\x01') {
