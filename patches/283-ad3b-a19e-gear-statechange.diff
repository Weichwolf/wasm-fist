+  /* PATCH 283: the landing-gear state method (asm 0xad3b-0xad61; DS=DGROUP=0x1c00), dispatched by ab03.
+   * di=object near offset in param_1; when the gear-state byte[di+0x90] is <2 and the altitude word
+   * [di+0x34] crosses 0xe00 in the wrong direction, retracts/extends via a19e.  Ghidra deref'd param_1
+   * as a host pointer + read [di+0x34] as a 32-bit int (asm WORD).  Rebased to the DGROUP model.  (The
+   * asm al=1/0 gear-direction selector is dropped through a19e's 1-param sig -- gear-state only.) */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
