+/* Original 133a reset body; the shared CPU context owns every live register. */
+void __allregs FUN_0000_133a(FistCpuState *cpu)
+{
+  FistCpuState *previous=fist_clock_bind_cpu(cpu);
+  uint16_t value;
+  fist_cpu_fetch(cpu,0x133a); fist_cpu_set_if(cpu,0);
+  fist_cpu_fetch(cpu,0x133b);
+  memcpy(&value,g_mem+fist_ext_base+0x12cc,2);
+  cpu->edx=fist_cpu_low(cpu->edx,value,16);
+  fist_cpu_fetch(cpu,0x1342);
+  value=(uint16_t)cpu->edx;
+  fist_cpu_alu(cpu,FIST_LAZY_ADDW,16,value,6,value+6);
+  cpu->edx=fist_cpu_low(cpu->edx,value+6,16);
+  fist_cpu_fetch(cpu,0x1346); cpu->eax=fist_cpu_low(cpu->eax,1,8);
+  fist_cpu_fetch(cpu,0x1348); out((uint16_t)cpu->edx,(uint8_t)cpu->eax);
+  fist_cpu_fetch(cpu,0x1349); /* JMP134b */
+  fist_cpu_fetch(cpu,0x134b); cpu->ecx=20;
+  do {
+    fist_cpu_fetch(cpu,0x1350); cpu->eax=fist_cpu_low(cpu->eax,in((uint16_t)cpu->edx),8);
+    fist_cpu_fetch(cpu,0x1351); /* JMP1353 */
+    fist_cpu_fetch(cpu,0x1353); --cpu->ecx;
+  } while (cpu->ecx);
+  fist_cpu_fetch(cpu,0x1355);
+  value=(uint8_t)cpu->eax;
+  fist_cpu_alu(cpu,FIST_LAZY_XORB,8,value,value,0);
+  cpu->eax=fist_cpu_low(cpu->eax,0,8);
+  fist_cpu_fetch(cpu,0x1357); out((uint16_t)cpu->edx,(uint8_t)cpu->eax);
+  fist_cpu_fetch(cpu,0x1358); /* JMP135a; shared core exit owns FillFlags */
+  fist_cpu_fetch(cpu,0x135a); cpu->ecx=8000;
+  fist_cpu_fetch(cpu,0x135f);
+  memcpy(&value,g_mem+fist_ext_base+0x12cc,2);
+  cpu->edx=fist_cpu_low(cpu->edx,value,16);
+  fist_cpu_fetch(cpu,0x1366);
+  value=(uint16_t)cpu->edx;
+  fist_cpu_alu(cpu,FIST_LAZY_ADDW,16,value,14,value+14);
+  cpu->edx=fist_cpu_low(cpu->edx,value+14,16);
+  do {
