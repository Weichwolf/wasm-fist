+/* Original 23c4 byte dispatch followed by a tail JMP, not another CALL. */
+void __allregs FUN_0000_23c4(FistCpuState *cpu)
+{
+  FistCpuState *previous=fist_clock_bind_cpu(cpu);
+  fist_cpu_fetch(cpu,0x23c4); cpu->ebx=fist_cpu_low(cpu->ebx,cpu->eax,8);
+  fist_cpu_fetch(cpu,0x23c6);
+  uint32_t index=(uint8_t)cpu->ebx;
+  fist_cpu_alu(cpu,FIST_LAZY_CMPB,8,index,4,index-4);
+  fist_cpu_fetch(cpu,0x23c9);
+  if (!(fist_cpu_cf(cpu) || fist_cpu_zf(cpu))) {
+    fist_cpu_fetch(cpu,0x23cb);
+    fist_cpu_alu(cpu,FIST_LAZY_XORD,32,cpu->eax,cpu->eax,0);
+    cpu->eax=0;
+    fist_cpu_fetch(cpu,0x23cd); fist_cpu_near_ret(cpu,g_mem);
+  } else {
+    fist_cpu_fetch(cpu,0x23ce); cpu->ebx=(uint8_t)cpu->ebx;
+    fist_cpu_fetch(cpu,0x23d1);
+    memcpy(&cpu->eax,g_mem+fist_ext_base+0x159f+cpu->ebx*4,4);
+    fist_cpu_fetch(cpu,0x23d8); cpu->eip=cpu->eax;
+    if (cpu->eip==0x2294) {
+      /* This original table entry is the existing bare RET callback; with
