+      fist_cpu_fetch(cpu,0x2294); fist_cpu_near_ret(cpu,g_mem);
+    } else {
+      void (*target)(FistCpuState *)=(void (*)(FistCpuState *))fist_icall(fist_ext_base+cpu->eip);
+      target(cpu);
+    }
+  }
+  fist_clock_bind_cpu(previous);
+}
