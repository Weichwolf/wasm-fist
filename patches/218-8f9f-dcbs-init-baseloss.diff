+  *(unsigned short *)(dg + (unsigned short)(di + 0x87)) = 0x800;/* movw $0x800,0x87(%di) */
+  *(unsigned short *)(dg + (unsigned short)(di + 0x14)) = 0x400;/* movw $0x400,0x14(%di) */
+  dg[(unsigned short)(di + 0x16)] |= 0x8;                       /* orb $0x8,0x16(%di) */
