+++ b/fist.c
@@ -22833,16 +22833,22 @@
 void __allregs FUN_0000_8f9f(int param_1)
 
 {
-  *(undefined2 *)(param_1 + 0xac) = 0xf;
-  *(undefined2 *)(param_1 + 0xae) = 0x10;
-  *(undefined2 *)(param_1 + 0xb0) = 5;
-  *(undefined2 *)(param_1 + 0xb2) = 2000;
-  *(undefined2 *)(param_1 + 0xb4) = 0x14;
-  *(undefined1 *)(param_1 + 0x8d) = 1;
