+  *(unsigned short *)(dg + (unsigned short)(di + 0xae)) = 0x10; /* movw $0x10,0xae(%di) */
+  *(unsigned short *)(dg + (unsigned short)(di + 0xb0)) = 0x5;  /* movw $0x5,0xb0(%di) */
+  *(unsigned short *)(dg + (unsigned short)(di + 0xb2)) = 0x7d0;/* movw $0x7d0,0xb2(%di) */
+  *(unsigned short *)(dg + (unsigned short)(di + 0xb4)) = 0x14; /* movw $0x14,0xb4(%di) */
