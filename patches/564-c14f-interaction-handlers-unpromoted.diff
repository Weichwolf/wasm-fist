+  /* PATCH 564: type-5/6 interaction (asm 0000:a0a1): `call 0x291` (AL = random byte) ; `mov bx,[di] ;
+   * cmp al,[bx+0x95e4] ; jae clc` -- a per-PROJECTILE-type hit chance, byte table DGROUP:0x95e4 (type 7
+   * = 0x80, 8..13 = 0x26/0x4c, 15 = 0xfd); then `eax = [di+0xc]-[si+0xc] ; cmp eax,0x200 ; jg clc ;
+   * cmp eax,-0x200 ; jl clc ; stc` -- a SIGNED Z band of +-0x200. */
+  extern unsigned char g_fist_cf;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned int dio = (unsigned short)di, sio = (unsigned short)si;
+  unsigned char al = (unsigned char)(unsigned int)FUN_0000_0291();
+  unsigned short ptype = *(unsigned short *)(dg + dio);
+  if (al >= dg[(unsigned short)(0x95e4 + ptype)]) { g_fist_cf = 0; return; }
+  int32_t dz = (int32_t)(*(uint32_t *)(dg + (unsigned short)(dio + 0xc)) - *(uint32_t *)(dg + (unsigned short)(sio + 0xc)));
+  if (dz > 0x200 || dz < -0x200) { g_fist_cf = 0; return; }
+  g_fist_cf = 1;
+  return;
+}
