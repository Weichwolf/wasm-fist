+   * byte[si+0x19]*2 ; ebx = word[0x9ebf+bx]` (the variant's height, zero-extended) ; `test byte[di+0x19],4
+   * ; jz ; shr ebx,2` (a flagged projectile gets a quarter of the band) ; `cmp eax,ebx ; jae clc ; stc`
+   * (UNSIGNED). */
+  extern unsigned char g_fist_cf;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned int dio = (unsigned short)di, sio = (unsigned short)si;
+  uint32_t dz = *(uint32_t *)(dg + (unsigned short)(dio + 0xc)) - *(uint32_t *)(dg + (unsigned short)(sio + 0xc));
+  uint32_t band = *(uint16_t *)(dg + (unsigned short)(0x9ebf + (dg[(unsigned short)(sio + 0x19)] << 1)));
+  if (dg[(unsigned short)(dio + 0x19)] & 4) band >>= 2;
+  g_fist_cf = (dz < band) ? 1 : 0;
+  return;
+}
