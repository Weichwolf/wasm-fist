+/* ===== ((uint)(uintptr_t)&FUN_0000_c894) @ 0000:c894 ===== */
+
+void __allregs
+FUN_0000_c894(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4,
+             undefined2 param_5)
+
+{
+  /* PATCH 534: asm 0xc894-0xc8b1, the helper 0xc829 tails into.  Same arg-less c4df context as
+   * c70d/c86e (si = g_fist_render_si, bx = classid*2):
+   *     c894: mov ah,0xf
+   *     c896: testb [si+0x16],8 ; je c89e      ; bit clear -> keep 0xf
+   *     c89c: mov ah,0xe
+   *     c89e: testb [si+0x17],8 ; je c8ac      ; bit clear -> draw
+   *     c8a4: testw [0x452],0x20 ; je c8b0     ; blink phase clear -> skip
+   *     c8ac: call c8b2 ; ret                  ; c8b2 ends with clc (patch 463)
+   *     c8b0: stc ; ret
+   * So it draws unless the object's [si+0x17] bit3 is set AND the frame-timer blink bit [0x452]&0x20
+   * is clear -- i.e. it is the BLINKING variant of the c8b2 draw. */
+  extern unsigned char  g_fist_cf;
+  extern unsigned short g_fist_render_si;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short si = g_fist_render_si;
+  unsigned char  ah = (dg[(unsigned short)(si + 0x16)] & 8) ? 0x0e : 0x0f;   /* c896/c89c */
+  (void)param_1;(void)param_2;(void)param_3;(void)param_4;(void)param_5;
+  if ((dg[(unsigned short)(si + 0x17)] & 8) == 0 ||
+      (*(unsigned short *)(dg + 0x452) & 0x20) != 0) {                        /* c89e/c8a4 */
+    FUN_0000_c8b2(CONCAT11(ah,0),(undefined2)(unsigned short)(*(unsigned short *)(dg + si) << 1),
+                  0,(undefined2)si,0);                                        /* c8ac (clc inside) */
+    return;
+  }
+  g_fist_cf = 1;                                                              /* c8b0 stc */
+  return;
+}
+
+/* ===== ((uint)(uintptr_t)&FUN_0000_c829) @ 0000:c829 ===== */
+
+void __allregs
+FUN_0000_c829(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4,
+             undefined2 param_5)
+
+{
+  /* PATCH 534: asm `c829: call 0xc894 ; c82c: ret` -- a pure thunk, and the cockpit-view render method
+   * for object classes 5 and 6.  Like c86e it was never promoted, so c4df's
+   * `mvec = word[STRSEG:classid*2 + 0x3632]` had nothing to reach. */
+  FUN_0000_c894(param_1,param_2,param_3,param_4,param_5);
+  return;
+}
