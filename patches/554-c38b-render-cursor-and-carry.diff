+  extern unsigned char  g_fist_cf;
+  extern unsigned short g_fist_render_di, g_fist_iter_si;
+  uint8_t *dg = g_mem + 0x1c000;
+  uint16_t si, di;
+  (void)param_2;
+  g_fist_iter_si = 0xffff;                                      /* both exits: mov $0xffff,%si */
+  if (*(uint8_t *)(dg + 0xe6ee) != 0) { g_fist_cf = 1; return; }              /* c38b/c390 */
+  if (*(uint8_t *)(dg + 0x1549) != 0x1e) { g_fist_cf = 1; return; }           /* c392/c397 */
+  si = *(uint16_t *)(dg + 0x7ae0);                                            /* c399 */
