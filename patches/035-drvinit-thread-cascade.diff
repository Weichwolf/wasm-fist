-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c036)))();
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c036)))();
-  DAT_1000_c714 = DAT_1000_c714 | 0x60;
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c036)))();
-  DAT_1000_c718 = DAT_1000_c718 | 0x60;
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c036)))();
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c0d4)))();
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c0cc)))();
-  DAT_1000_c784 = DAT_1000_c784 | 0x60;
-  (*(code *)fist_icall_far((uint32_t)(_DAT_1000_c012)))();
+  /* PATCH 035: driver-overlay offset 0x2 = `jmp 0x9` -> the real driver init.  Call it directly. */
+  FUN_0000_0009();
   return;
 }
 
