459a->206f->209e->4937->65c2->m_mga_294d->m_mga_298a, SIGSEGV at fist_mga.c:6745, param_3=0x91d7001).
65c2's asm:

    165c2: mov  bx,[0x156a]        ; c554 arg
    165c6: lcall [0x554]           ; (*c554)()
    165ca: push bx
    165cb: mov  ax,[0x156c]; mov [0x7aee],ax
