+/* PATCH 322: FUN_0000_dc12 -- the 22dd render-script OBJECT/VEHICLE geometry-record poster (asm 0xdc12,
+ * DS=SS=DGROUP=0x1c00).  Sibling of db99 (patch 193): calls the record prolog ddff, copies the camera
+ * fields into the extender-TCB record (es:di = word[0xea2e]:word[0xea2c] = DAT_2000_aa2c), computes the
+ * player-object relative geometry (b112/0731 object-delta helpers, already reconstructed), and posts op
+ * 0x10 (ea12!=0) / op 0x5c (ea12==0) to the Doug-Huffman extender via e339.  Base-loss rebasing: the
+ * vehicle/object near offsets (word[0x6d34]=veh node; word[bx*8+0x6d3c]; word[bx*2+0x7d2a]) index DGROUP
+ * -> g_mem+0x1c000+off; b112/0731 take those as host pointers (param_1<->si, param_2<->di, matched vs the
+ * af1c call site: b112(other,self) => b112(object,vehnode); 0731(si-ptr,di-ptr)).  EBX inbox (rec+0x3f2)
+ * is provably dead for these display-list ops (the PM op-handler reloads ebx=[0xc93] first, per patch 193)
+ * -> written 0, not fabricated. */
+void __allregs FUN_0000_dc12(void)
+{
+  uint8_t *rec;
+  uint8_t *d548 = g_mem + 0x1d548;                 /* si=0x1548 (immediate) */
+  uint16_t vn, bx, ax;
+  int done = 0;
+  FUN_0000_ddff();                                 /* build record[0x0e..0x24] */
+  rec = DAT_2000_aa2c;                             /* ea2c/ea2e unchanged by ddff */
+  *(uint16_t *)(rec + 0x2c) = *(uint16_t *)(d548 + 0x12);   /* d548 struct [0x12..0x1c] */
+  *(uint16_t *)(rec + 0x2e) = *(uint16_t *)(d548 + 0x14);
+  *(uint16_t *)(rec + 0x30) = *(uint16_t *)(d548 + 0x16);
+  *(uint16_t *)(rec + 0x32) = *(uint16_t *)(d548 + 0x18);
+  *(uint16_t *)(rec + 0x34) = *(uint16_t *)(d548 + 0x1a);
+  *(uint16_t *)(rec + 0x36) = *(uint16_t *)(d548 + 0x1c);
+  *(uint16_t *)(rec + 0x38) = *(uint16_t *)(g_mem + 0x1d558);   /* word[0x1558] */
+  rec[0x58] = 5;                                   /* movb es:[di+0x58],5 */
+  vn = *(uint16_t *)(g_mem + 0x1c000 + 0x6d34);    /* si = word[0x6d34] veh node near offset */
+  {
+    uint8_t *node = g_mem + 0x1c000 + vn;
+    if (node[0x1c] != 0) {                         /* dc5a: object branch (8-byte stride table 0x6d3c) */
+      bx = *(uint16_t *)(g_mem + 0x1c000 + (uint16_t)(node[0x1b] * 8 + 0x6d3c));
+      if (bx != 0) {                               /* dc6b or bx,bx; je dc9a */
+        ax = (uint16_t)FUN_0000_b112(g_mem + 0x1c000 + bx, g_mem + 0x1c000 + vn); /* b112(obj,veh) */
+        *(uint16_t *)(rec + 0x56) = ax;            /* dcae */
+        rec[0x58] |= 2;                            /* dcb2 */
+        done = 1;
+      }
+    } else {                                       /* dc7b: non-object branch (2-byte stride table 0x7d2a) */
+      bx = *(uint16_t *)(g_mem + 0x1c000 + (uint16_t)(node[0x1b] * 2 + 0x7d2a));
+      if (g_mem[0x1c000 + bx] != 0) {              /* dc85 cmpb [bx],0; je dc9a */
+        ax = (uint16_t)FUN_0000_0731((uint *)(g_mem + 0x1c000 + (uint16_t)(bx + 0xc)),   /* si=bx+0xc */
+                                     (uint *)(g_mem + 0x1c000 + (uint16_t)(vn + 4)));     /* di=veh+4 */
+        ax = (uint16_t)((ax & 0xff) | (((ax >> 8) + 0x80) << 8));   /* dc94 add ah,0x80 */
+        *(uint16_t *)(rec + 0x56) = ax;            /* dcae */
+        rec[0x58] |= 2;                            /* dcb2 */
+        done = 1;
+      }
+    }
+    if (!done) {                                   /* dc9a: both object tables empty */
+      if (node[0x19] & 0x80) {                     /* dc9a testb [si+0x19],0x80; je dcb7 */
+        rec[0x58] = (uint8_t)((rec[0x58] | 2) & 0xfb);           /* dca0 orb 2; dca5 andb 0xfb */
+        *(uint16_t *)(rec + 0x56) = *(uint16_t *)(g_mem + 0x1c000 + (uint16_t)(vn + 0x8e)); /* dcaa [si+0x8e] */
+        rec[0x58] |= 2;                            /* dcb2 */
+      }
+      /* else dc9e je dcb7: rec+0x56 / rec+0x58 left unchanged */
+    }
+  }
+  *(uint16_t *)(rec + 0x3e) = (uint16_t)(g_mem[0x1d54a] << 6);  /* dcb7 ah=[0x154a];al=0;shr ax,2 */
+  *(uint16_t *)(rec + 0x02) = *(uint16_t *)(g_mem + 0x1c000 + *(uint16_t *)(g_mem + 0x1d56a)); /* word[word[0x156a]] */
+  *(uint16_t *)(rec + 0x04) = 0;                   /* dcce */
+  *(uint32_t *)(rec + 0x3f2) = 0;                  /* inbox = EBX (provably dead for op 0x10/0x5c) */
+  DAT_2000_aa10 = (DAT_2000_aa12 != 0) ? 0x10 : 0x5c;  /* dcd4 cmpw [0xea12],0 -> op 0x10 / 0x5c */
+  FUN_0000_e339();
+  return;
+}
+
+/* PATCH 322: the 22dd render-script handler @ 0000:41df (`call dc12; word[0x4b9e]=0; addw 2,[0x4a86]; ret`).
+ * A 22dd script MID-ENTRY Ghidra never promoted -> fist_icall_near(0,0x41df) trapped to a no-op -> the
+ * interpreter cursor (DAT_2000_0a86) never advanced past it -> FUN_0000_22dd's `c450=3; do{call[cursor]}
+ * while(c450!=0)` do-while spun forever (the phase terminator 23ce that clears c450 was never reached),
+ * freezing the whole 459a mission loop (c452 stuck at 1, so patch-295's per-frame pump never re-runs).
+ * Sibling of 41d0 (patch 193) / 41c7 (patch 306); posts the object/vehicle geometry record via dc12. */
+void __allregs FUN_0000_41df(void)
+{
+  FUN_0000_dc12();
+  *(uint16_t *)(g_mem + 0x1c000 + 0x4b9e) = 0;
+  DAT_2000_0a86 = (uint16_t)(DAT_2000_0a86 + 2);   /* addw 2,[0x4a86] */
+  return;
+}
