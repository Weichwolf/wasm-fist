+/* Original e61e/e634 consumed AX/ECX/DL lanes. ES is STRSEG; the
+ * script's last byte is a BYTE OFFSET into the DWORD pitch table, not pitch. */
+static void fist_intro_sound(uint16_t cur)
+{
+  uint8_t *dg = g_mem + 0x1c000;
+  uint8_t *resource = g_mem + ((uint32_t)*(uint16_t *)(dg + 0x70) << 4);
+  uint16_t ax = resource[(uint16_t)(cur + 2)] |
+                ((uint16_t)resource[(uint16_t)(cur + 3)] << 8);
+  uint8_t dl = resource[(uint16_t)(cur + 4)];
+  uint16_t bx = resource[(uint16_t)(cur + 5)];
+  fist_sound_registers(ax, *(uint32_t *)(dg + (uint16_t)(0xf772 + bx)), dl);
+  FUN_0000_e2c2((uint32_t)bx);
+}
+
+/* e684/e6a5 explicitly supplies zero ECX/DL and queues the silence
+ * sample for channels 2, 1, 0. */
+static void fist_intro_stop(undefined4 inbox)
+{
+  for (uint16_t ax = 0x82ff; ax >= 0x80ff; ax -= 0x100) {
+    fist_sound_registers(ax, 0, 0);
+    FUN_0000_e2c2(inbox);
+  }
+}
