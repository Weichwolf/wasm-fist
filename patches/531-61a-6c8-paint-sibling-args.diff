      param_4).  Patch 181 dropped BOTH -> 294d/298a blitted a garbage sprite (runaway 298a SIGSEGV). */
-  ((void (*)(uint))fist_icall_far((uint32_t)(DAT_1000_c61a)))((uint16_t)(ax & 0xff00));
