@@ -48625 +48624 @@
-   * table[idx]).  param_2 stays the raw DGROUP offset for the INT-21 DX slot iRam000f0006. */
+   * table[idx]).  param_2 stays the raw DGROUP offset for the INT-21 DX slot uRam000f0006. */
@@ -48643,3 +48642,3 @@
-    iRam000f0006 = param_2;
-    iRam000f0008 = param_2;
-    iRam000f000a = iVar2;
