+   *     #0 FUN_0000_6f90 (param_1=35721, param_2=0x0)  build/fist.c:19327
+   *     #1 FUN_0000_6e8d  #2 FUN_0000_6a4a  #3 FUN_0000_e714
+   *
+   * reproduced by driving the real UI (SETTINGS at (160,123), LOW DETAIL at (237,40), ACCEPT at
+   * (258,190)) -- the click lands correctly, the LED moves to LOW DETAIL, and the port then dies.
+   *
+   * The three `>> 1` fields are NOT table lookups: `mov 0x8b47,%ax ; shr $1,%al ; add $0x30,%al` loads
+   * a word but shifts only AL, so the value is byte[0x8b47] >> 1 + '0'.  Ghidra's `(byte)(word >> 1)`
+   * differs whenever bit 8 of the word is set.
+   *
+   * The tail is `lcall *[0x2b4] ; mov $0x8ab3,%di ; cld ; rep movsb %ds:(%si),%es:(%di)`.  DS and ES
+   * are DGROUP here, so both ends are near offsets: the destination is DGROUP:0x8ab3 and the source is
+   * DGROUP:si.  Ghidra used both as host pointers.
+   *
+   * NOT fixed here: SI arrives as 0.  `FUN_0000_6e8d` BEGINS with the call to this function (asm
+   * 0x6e8d is the call instruction itself), so SI is threaded from 6a4a and above, and the port's
+   * arg-less far dispatch does not carry it -- board:0014's carrier class.  Transcribing the copy
+   * faithfully as DGROUP:si is still right; the zero is a separate defect one level up. */
+  {
+    uint8_t *dg = (uint8_t *)g_mem + 0x1c000;
+    dg[0x8aa8] = (uint8_t)(dg[0x8b43] + 0x30);                          /* 6f90 */
+    dg[0x8aa9] = dg[(uint16_t)(dg[0x8b45] + 0x8b5d)];                   /* 6f98 */
+    dg[0x8ab2] = dg[(uint16_t)(dg[0x8b50] + 0x8b5d)];                   /* 6fa4 */
+    dg[0x8aab] = dg[(uint16_t)(dg[0x8b46] + 0x8b5d)];                   /* 6fb0 */
+    dg[0x8aac] = (uint8_t)((dg[0x8b47] >> 1) + 0x30);                   /* 6fbd */
+    dg[0x8aad] = (uint8_t)((dg[0x8b49] >> 1) + 0x30);                   /* 6fc7 */
+    dg[0x8aae] = (uint8_t)((dg[0x8b4b] >> 1) + 0x30);                   /* 6fd1 */
+    dg[0x8aaf] = dg[(uint16_t)(dg[0x8b4d] + 0x8b5d)];                   /* 6fdb */
+    dg[0x8ab1] = dg[(uint16_t)(dg[0x8b4e] + 0x8b5d)];                   /* 6fe7 */
+    dg[0x8ab0] = dg[(uint16_t)(dg[0x8b4f] + 0x8b5d)];                   /* 6ff3 */
+    (*(code *)fist_icall_far((uint32_t)(DAT_1000_c2b4)))();             /* 6fff */
+    {   uint16_t di = 0x8ab3, si = (uint16_t)(uintptr_t)param_2;        /* 7003 */
+        for (; param_1 != 0; param_1 = param_1 + -1)                    /* 7007 rep movsb */
+            dg[(uint16_t)(di++)] = dg[(uint16_t)(si++)];
+    }
   }
+  (void)puVar1; (void)puVar2; (void)puVar3;
   return;
 }
 
