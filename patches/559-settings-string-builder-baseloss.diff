+   *     6f9d: 8a 87 5d 8b      mov    0x8b5d(%bx),%al   ; DS-relative: byte[DGROUP:0x8b5d + value]
+   *     6fa1: a2 a9 8a         mov    %al,0x8aa9
+   *
+   * i.e. an index into the character table at DGROUP:0x8b5d.  Ghidra emitted
+   * `*(undefined1 *)(DAT_2000_4b45 + 0x8b5d)` -- the SUM deref'd as a host pointer -- so selecting any
+   * detail level SEGVs the port outright:
