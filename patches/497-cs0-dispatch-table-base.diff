+    /* PATCH 497: CS=0, not 0x1000.  Table verified at image 0x9f0f: near offsets
+     * {0x9f1d, 0x9f66, 0x9fe5, 0xa069, 0xa07c, 0xa02a}, all inside this function's own neighbourhood. */
+    uint16_t vec = *(uint16_t *)(g_mem + (uint16_t)(0x9f0f + o[0x25])); /* 9ecd call cs:[0x9f0f+bx] */
