   bx = (uint16_t)(o[0x91] << 1);                               /* 91d0 movzbw; shl 1 */
-  vec = *(uint32_t *)(g_mem + 0x10000 + (uint16_t)(0x9206 + bx));   /* 91d7 lcall cs:[0x9206+bx] */
+  /* PATCH 497: CS=0, not 0x1000 -- see the patch header.  Table verified at image 0x9206:
