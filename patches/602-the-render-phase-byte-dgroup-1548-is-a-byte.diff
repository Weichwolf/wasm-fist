 #define DAT_1000_d549 (*(undefined1 *)(g_mem+0x1d549))
 #define DAT_1000_d54a (*(undefined1 *)(g_mem+0x1d54a))
 #define DAT_1000_d54b (*(undefined1 *)(g_mem+0x1d54b))
