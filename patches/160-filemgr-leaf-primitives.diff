+/* ===== PATCH 160: seg-0f69 FILEMGR variant-0 leaf primitives (asm 0x12867/0x12871/0x1287b) ===== */
+/* The model/KLC/PAL/SKY loads go through the seg-0f69 FILEMGR (2733 batch-load / 276e streaming-open /
+   27e2 close / 27f7 read / 280a seek), which dispatch per-extension-variant leaf handlers held in the
+   cs:0x2b88.. vtable (base cs=0f69 -> g_mem+0xf690).  For LOOSE (uncompressed) data files the attr-probe
+   picks variant0 (the ORIGINAL extension char), whose column is the plain-INT-21h leaf set:
+      LOAD 0x318e=FUN_1000_281e (thunk->2593), OPEN 0x3195=FUN_1000_2825 (both already recovered),
+      CLOSE 0x31d7, READ 0x31e1, SEEK 0x31eb.
+   Ghidra promoted 281e/2825 (+ the variant-2 set 2ccb..) but not the three tiny CLOSE/READ/SEEK stubs
+   below (they are reached only through the vtable).  Reconstructed instruction-faithfully from the image
+   and registered in the fmap so fist_icall_near(0xf69,off) resolves them.  Each takes bx=handle as arg0
+   (+ cx=count/dx=buf for READ; cx:dx=offset for SEEK) -- the caller-supplied regs the cluster forwards. */
+
+/* ===== 0f69:0x31d7 = linear 0x12867 : CLOSE (cmp bx,1; jb ret; mov ah,0x3e; int 21h) ===== */
+void __allregs FUN_1000_2867(int param_1)
+{
+  if ((uint16_t)param_1 >= 1) {                 /* asm: cmp bx,1 ; jb .ret */
+    uRam000f0014 = 0x21;
+    uRam000f0000 = 0x3e00;                       /* AH=3e close */
+    uRam000f0002 = param_1;                      /* BX = handle */
+    fist_int_dispatch();
+  }
+  return;
+}
+
+/* ===== 0f69:0x31e1 = linear 0x12871 : READ (mov ah,0x3f; int 21h) -> AX=bytes ===== */
+int __allregs FUN_1000_2871(int param_1,int param_2,int param_3)
+{
+  uRam000f0014 = 0x21;
+  uRam000f0000 = 0x3f00;                          /* AH=3f read */
+  uRam000f0002 = param_1;                         /* BX = handle */
+  uRam000f0004 = param_2;                         /* CX = count  */
+  iRam000f0006 = param_3;                         /* DX = buffer (DGROUP) */
+  uRam000f000e = 0x1c00;                          /* DS = DGROUP (small model) */
+  fist_int_dispatch();
+  return uRam000f0000;
+}
+
+/* ===== 0f69:0x31eb = linear 0x1287b : SEEK (mov ax,0x4200; int 21h) -> DX:AX=pos ===== */
+int __allregs FUN_1000_287b(int param_1,int param_2,int param_3)
+{
+  uRam000f0014 = 0x21;
+  uRam000f0000 = 0x4200;                          /* AL=0 whence=SET */
+  uRam000f0002 = param_1;                         /* BX = handle */
+  uRam000f0004 = param_2;                         /* CX = offset hi */
+  iRam000f0006 = param_3;                         /* DX = offset lo */
+  fist_int_dispatch();
+  return uRam000f0000;
+}
