+  /* PATCH 569: the single-pixel render method (asm 0x37cd-0x3822), table 0x4b52 entry 9 (method id
+   * 0x12 -- the id c9af stamps into every record it drains).  BX = the deferred record (param_3, a
+   * DGROUP near offset); `push bx ; mov bx,0x6bc8 ; call 3d4c ; pop bx` projects the record's point
+   * (AX = X, CX = Y via word[0x6c38]); `neg ax ; mov dx,ax`; vp = word[0x156a]: sx = vp.w/2 + dx must
+   * be < vp.w, sy = vp.h/2 + cx must be < vp.h (both UNSIGNED `jae ret`); the pixel goes to
+   * es:[rowtab[sx] + sy] (es = vp[0], rowtab = word[0x794]) from the record's colour byte[bx+5]; then,
+   * when word[bx+2] != word[0x1554] and (dx,cx) == (word[0x6b6e],word[0x6b70]) -- the reticle -- the
+   * record's id word[bx+2] is published to word[0x6b72].  Ghidra host-deref'd the record and used the
+   * incoming param_2 for 3d4c's CX output. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned int bx = (unsigned short)param_3;
+  (void)param_1; (void)param_2;
+  int ax = FUN_0000_3d4c(0x6bc8);
+  uint16_t cx = (uint16_t)DAT_2000_2c38;                                      /* 3d94 */
+  uint16_t dx = (uint16_t)(-ax);                                              /* 37d5/37d7 */
+  uint16_t *vp = (uint16_t *)DAT_1000_d56a;                                   /* di = word[0x156a] */
+  uint16_t sx = (uint16_t)((vp[5] >> 1) + dx);                                /* 37df..37e6 */
+  if (sx >= vp[5]) return;                                                    /* 37e8 jae */
+  uint16_t rowent = *(uint16_t *)(dg + (uint16_t)(sx * 2 + DAT_1000_c794));   /* 37ec/37ee */
+  uint16_t sy = (uint16_t)((vp[6] >> 1) + cx);                                /* 37f2..37f9 */
+  if (sy >= vp[6]) return;                                                    /* 37fb jae */
+  { uint8_t *fb = g_mem + (((uint32_t)vp[0]) << 4);                           /* es = word[di] */
+    fb[(uint16_t)(sy + rowent)] = dg[(uint16_t)(bx + 5)]; }                  /* 37ff..3806 movsb */
+  if (*(uint16_t *)(dg + (uint16_t)(bx + 2)) == (uint16_t)DAT_1000_d554) return;   /* 380a */
+  if (*(uint16_t *)(dg + 0x6b6e) != dx) return;                              /* 3810 */
+  if (*(uint16_t *)(dg + 0x6b70) != cx) return;                              /* 3816 */
+  *(uint16_t *)(dg + 0x6b72) = *(uint16_t *)(dg + (uint16_t)(bx + 2));       /* 381c/381f */
   return;
 }
 
