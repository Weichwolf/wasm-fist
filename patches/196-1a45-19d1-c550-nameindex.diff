   uVar6 = (undefined2)((ulong)param_2 >> 0x10);
-  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c550)))();
+  ((undefined2 (*)(undefined2*))fist_icall_far((uint32_t)(DAT_1000_c550)))((undefined2*)DAT_1000_e676);
   uVar3 = DAT_1000_c74a;
   uVar2 = DAT_1000_c748;
@@ -8039,4 +8039,4 @@
