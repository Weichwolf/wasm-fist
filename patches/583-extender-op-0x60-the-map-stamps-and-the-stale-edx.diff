+/* ===== ((uint)(uintptr_t)&FUN_0000_8650) @ 0000:8650 ===== */
+
+undefined4 __allregs FUN_0000_8650(void)
+
+{
+  /* PATCH 583: extender op 0x60 (service 10f1 = `call 8650`), the MAP STAMPS: the engine's e043 posts a
+   * world position (TCB+0xd2/0xd6) and two 16-byte image names (TCB+0x5a, TCB+0x6a) for every objective
+   * and crater of a mission (9cfc/9d26, up to 32); the height image is pressed into the heightmap
+   * [0x85bc] and the colour image into the colormap [0x85b8] around that position.  Unpromoted -- the
+   * gate is its only caller.  Asm 0x8650-0x8835:
+   *   8648 = (x << 13) >> (32-DETAIL) ; 864c = (-y << 13) >> (32-DETAIL)        (map cell of the centre)
+   *   DETAIL < 9 -> -1 ; half = 4 << (DETAIL-9) (a byte shift; carry -> -1)
+   *   min/max of the heightmap over the (2*half+1)-square around the centre; max-min > 9 -> -1
+   *   643c(eax = [0x8644], esi = TCB+0x5a) ; bed2 x (10-DETAIL) or bc06 x (DETAIL-10) ; centre on w/2,h/2
+   *   8840 (height stamp) ; the centre again ; 643c(TCB+0x6a) ; 4a3c ; the same rescale and centring
+   *   ac64 = [0x28a5] ; ac60 = 0xff ; 88af (colour stamp) ; 0 */
+  uint8_t  *xb   = g_mem + fist_ext_base;
+  uint8_t  *tcb  = (uint8_t *)DAT_0000_0c93;
+  unsigned  d    = xb[0x8490];
+  uint32_t  mask = *(uint32_t *)(xb + 0x849c);
+  const uint8_t *hm = (const uint8_t *)(uintptr_t)DAT_0000_85bc;
+  uint8_t  *img  = (uint8_t *)(uintptr_t)DAT_0000_8644;
+  uint8_t   lo = 0xff, hi = 0, half, side, r, c;
+  uint32_t  bx0, bp;
+  int       n;
+  DAT_0000_8648 = ((uint32_t)(*(int32_t *)(tcb + 0xd2) << 13)) >> (32 - d);          /* 8656-8669 */
+  DAT_0000_864c = ((uint32_t)-(*(int32_t *)(tcb + 0xd6) << 13)) >> (32 - d);         /* 866e-867b */
+  if (d < 9) return 0xffffffff;                                                       /* 8680-8689 */
+  if (d - 9 == 6) return 0xffffffff;                 /* 8691 `shl dl,cl`: the carry is bit 2 of 4 leaving */
+  half = (uint8_t)(4u << (d - 9));                                                    /* 868f/8691 */
+  side = (uint8_t)(2 * half + 1);                                                     /* 86b9-86bd, 86c5-86c9 */
+  /* The window origin is `sub ebx,edx` / `sub ebp,edx` with only DL set (`mov dl,4 ; shl dl,cl`): the
+   * rest of EDX is whatever the previous service left in the 32-bit app's register (the extender
+   * preserves it across the mode switches) -- the oracle's register trace (scratch/oracle/regtrace*)
+   * shows 0x290a8000 at AZER1's first post and each successful stamp's ac70 distance (0x3c1, 0x2a4)
+   * at the next.  Modelled as g_ext_edx: the previous 8650's exit, ac70's best distance, the op-0x54
+   * handler's -(y << 13); bits 8..10 of the low word displace the window (the mask is 0x7ff).
+   * Every one of AZER1's 16 decisions and both maps come out identical to the oracle's with it. */
+  { extern unsigned g_ext_edx; uint32_t edx = (g_ext_edx & 0xffffff00u) | half;      /* 868f/8691 */
+    bx0  = DAT_0000_8648 - edx;                                                       /* 86a5-86ab */
+    bp   = DAT_0000_864c - edx;                                                       /* 86ad-86b3 */
+    g_ext_edx = (g_ext_edx & 0xffff0000u) | half; }         /* 86f3 `pop edx` after the last row: dh = 0 */
+  for (r = side; r != 0; r--) {                                                       /* 86c5: rows */
+    uint32_t bx = bx0;
+    bp &= mask;                                                                       /* 86cb */
+    for (c = side; c != 0; c--) {                                                     /* 86d3: columns */
+      uint8_t v = hm[(bp << d) + (bx & mask)];
+      if (v < lo) lo = v;                                                             /* 86e2-86e6 */
+      if (v > hi) hi = v;                                                             /* 86e8-86ec */
+      bx++;
+    }
+    bp++;                                                                             /* 86f5 */
+  }
+  if ((uint8_t)(hi - lo) > 9) return 0xffffffff;                                      /* 86fa-8701 */
+  FUN_0000_643c((uint *)img, 0, 0, 0, 0, (undefined4)(uintptr_t)(tcb + 0x5a), 0);    /* 8707-8715 */
+  n = 10 - (int)d;                                                                    /* 871a-8727 */
+  { extern unsigned g_ext_edx;                                    /* bed2 leaves EDX = the width it halved, bc06 0 */
+    if (n > 0) { for (; n != 0; n--) { FUN_0000_bed2(img); g_ext_edx = DAT_0000_5578 << 1; } }   /* 873c: shrink */
+    else       { for (n = -n; n != 0; n--) { FUN_0000_bc06((int)(intptr_t)img); g_ext_edx = 0; } } } /* 872b: enlarge */
+  DAT_0000_8648 -= DAT_0000_5578 >> 1;                                                /* 874b-8752 */
+  DAT_0000_864c -= DAT_0000_557c >> 1;                                                /* 8758-875f */
+  FUN_0000_8840(img, (uint8_t *)(uintptr_t)DAT_0000_85bc);                            /* 8765-8771 */
+  DAT_0000_8648 = ((uint32_t)(*(int32_t *)(tcb + 0xd2) << 13)) >> (32 - d);          /* 8776-878f */
+  DAT_0000_864c = ((uint32_t)-(*(int32_t *)(tcb + 0xd6) << 13)) >> (32 - d);         /* 8794-87a1 */
+  FUN_0000_643c((uint *)img, 0, 0, 0, 0, (undefined4)(uintptr_t)(tcb + 0x6a), 0);    /* 87a6-87b4 */
+  FUN_0000_4a3c();                                                                    /* 87b9 */
+  n = 10 - (int)d;                                                                    /* 87be-87cb */
+  { extern unsigned g_ext_edx;
+    if (n > 0) { for (; n != 0; n--) { FUN_0000_bed2(img); g_ext_edx = DAT_0000_5578 << 1; } }
+    else       { for (n = -n; n != 0; n--) { FUN_0000_bc06((int)(intptr_t)img); g_ext_edx = 0; } } }
+  DAT_0000_8648 -= DAT_0000_5578 >> 1;                                                /* 87ef-8803 */
+  DAT_0000_864c -= DAT_0000_557c >> 1;
+  DAT_0000_ac64 = DAT_0000_28a5;                                                      /* 8809-880e */
+  DAT_0000_ac60 = 0xff;                                                               /* 8813 */
+  FUN_0000_88af(img, (uint8_t *)(uintptr_t)DAT_0000_85b8);                            /* 881d-8829 */
+  return 0;                                                                           /* 882e */
+}
