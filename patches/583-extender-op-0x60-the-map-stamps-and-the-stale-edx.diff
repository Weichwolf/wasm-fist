+/* ===== ((uint)(uintptr_t)&FUN_0000_88af) @ 0000:88af ===== */
+
+void __allregs FUN_0000_88af(const uint8_t *esi, uint8_t *edi)
+
+{
+  /* PATCH 583: the COLOUR stamp (asm 0x88af-0x89a2), the same walk over the colormap.  The stamp
+   * pixel's own palette entry (643c left the image palette at 0x5598) is read for its G byte: 0x1f
+   * is transparent; otherwise the cell's colour (the sorted map palette at 0x5260, 3 bytes per index)
+   * is shaded by it -- bit 5 clear: each component * ((g & 0x1f) << 2 | 0x80) >> 8; bit 5 set: each
+   * component * ~((g & 0x1f) << 1) >> 8 + ((g & 0x1f) >> 1) -- and ac70 finds the nearest palette
+   * index in [ac64 .. ac60] for the result, which replaces the cell. */
+  uint8_t  *xb   = g_mem + fist_ext_base;
+  unsigned  d    = xb[0x8490];
+  uint32_t  mask = *(uint32_t *)(xb + 0x849c), rows, cols, bp0, bp;
+  uint8_t  *end  = edi + DAT_0000_8498;
+  *(uint32_t *)(xb + 0x8838) = (uint32_t)(uintptr_t)end;                              /* 88b0-88b8 */
+  edi += (DAT_0000_864c & mask) << d;                                                 /* 88bd-88dc */
+  bp0  = DAT_0000_8648 & mask;                                                        /* 88d0-88d6 */
+  for (rows = DAT_0000_557c; rows != 0; rows--) {                                     /* 88de/88e4 */
+    bp = bp0;
+    for (cols = DAT_0000_5578; cols != 0; cols--) {                                   /* 88eb */
+      uint8_t g = xb[0x5599 + 3u * *esi++];                                           /* 88ec-88f6 */
+      if (g != 0x1f) {                                                                /* 88f7 */
+        const uint8_t *rgb = xb + 0x5260 + 3u * edi[bp];                              /* 88fc-8902 */
+        uint8_t bl = (uint8_t)(g << 3);                                               /* 8909 shl bl,3 */
+        if (((g >> 5) & 1) == 0) {                                                    /* the carry: bit 5 */
+          bl = (uint8_t)((bl >> 1) + 0x80);                                           /* 890e-8910 */
+          xb[0xac68] = (uint8_t)((rgb[0] * bl) >> 8);                                 /* 8913-8917 */
+          xb[0xac69] = (uint8_t)((rgb[1] * bl) >> 8);
+          xb[0xac6a] = (uint8_t)((rgb[2] * bl) >> 8);
+        } else {
+          uint8_t bh;
+          bl >>= 2; bh = (uint8_t)~bl; bl >>= 2;                                      /* 8935-893c */
+          xb[0xac68] = (uint8_t)(((rgb[0] * bh) >> 8) + bl);                          /* 893f-8945 */
+          xb[0xac69] = (uint8_t)(((rgb[1] * bh) >> 8) + bl);
+          xb[0xac6a] = (uint8_t)(((rgb[2] * bh) >> 8) + bl);
+        }
+        edi[bp] = (uint8_t)FUN_0000_ac70();                                           /* 8969-8972 */
+      }
+      bp = (bp + 1) & mask;                                                           /* 8977-8978 */
+    }
+    edi += DAT_0000_8494;                                                             /* 8987 */
+    if (edi >= end) edi -= DAT_0000_8498;                                             /* 898d-8995 */
+  }
+  return;
+}
