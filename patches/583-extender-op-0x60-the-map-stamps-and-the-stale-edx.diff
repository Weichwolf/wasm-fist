+/* ===== ((uint)(uintptr_t)&FUN_0000_8840) @ 0000:8840 ===== */
+
+void __allregs FUN_0000_8840(const uint8_t *esi, uint8_t *edi)
+
+{
+  /* PATCH 583: the HEIGHT stamp (asm 0x8840-0x88ae): [0x8838] = map end; the row start is the centre's
+   * row ((864c & mask) << DETAIL), the column 8648 & mask; for h rows of w pixels: cell = clamp0(pixel
+   * + cell - 0x80) (byte arithmetic, the add wraps), columns wrap on the mask, rows on the map size. */
+  uint8_t  *xb   = g_mem + fist_ext_base;
+  unsigned  d    = xb[0x8490];
+  uint32_t  mask = *(uint32_t *)(xb + 0x849c), rows, cols, bp0, bp;
+  uint8_t  *end  = edi + DAT_0000_8498;
+  *(uint32_t *)(xb + 0x8838) = (uint32_t)(uintptr_t)end;                              /* 8841-8849 */
+  edi += (DAT_0000_864c & mask) << d;                                                 /* 884e-886d */
+  bp0  = DAT_0000_8648 & mask;                                                        /* 8861-8867 */
+  for (rows = DAT_0000_557c; rows != 0; rows--) {                                     /* 886f/8875 */
+    bp = bp0;
+    for (cols = DAT_0000_5578; cols != 0; cols--) {                                   /* 887c */
+      uint8_t al = (uint8_t)(*esi++ + edi[bp]);                                       /* 887c-887d */
+      al = (al < 0x80) ? 0 : (uint8_t)(al - 0x80);                                    /* 8882-8886 */
+      edi[bp] = al;                                                                   /* 8888 */
+      bp = (bp + 1) & mask;                                                           /* 888d-888e */
+    }
+    edi += DAT_0000_8494;                                                             /* 8897 */
+    if (edi >= end) edi -= DAT_0000_8498;                                             /* 889d-88a5 */
+  }
+  return;
+}
