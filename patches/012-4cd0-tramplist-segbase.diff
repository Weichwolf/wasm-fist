+       mov ax,si; mov dx,ds                 ; each iter: save current node (off,seg)
+     .loop: lds si,[ds:si+1]                ; DS:SI := forward far-ptr of current node
+            lea si,[si-5]                     ; back up to next node head
+            cmpw [ds:si+5],0xdb8b             ; terminator marker (mov bx,bx)
+            jne .loop
+       mov ds,dx; mov si,ax                 ; DS:SI := last real node (before the terminator)
+       (fall into 4ce7: append new node ES:BX after it)
+     Entry DS = 0x1000 (106d: push cs;pop ds => the caller CS in the base-0 FUN_1000 model);
+     SI = head off (param_2). The new node is ES:BX (ES=0x1000, BX=param_1). Ghidra dropped the
+     far-ptr bases (dereffed the offset as a host pointer -> SIGSEGV). Nodes live in the un-decompiled
+     SMC scratch region ~0x19bb; the thunks are inert for our C control flow but the memory is kept
+     byte-faithful. Nodes are handed to 4ce7 as far pointers (seg<<16|off). */
+  unsigned seg = 0x1000;                              /* DS on entry (caller CS) */
+  unsigned off = (uint16_t)param_2;                   /* SI = head offset */
+  unsigned last_seg = seg, last_off = off;
