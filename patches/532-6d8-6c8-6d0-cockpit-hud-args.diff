+      /* PATCH 532 (8cbf): asm `mov bx,0x91b8 ; mov ax,0x18 ; lcall *0x6c8` -- [0x6c8] is FUN_0000_294d,
+       * five params, ax=param_1 and bx=param_4.  AX is 0x18 here, not 0. */
