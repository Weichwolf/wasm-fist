+  dg[(unsigned short)(di + 0x16)] &= 0xf9;                                          /* andb [di+0x16],0xf9 */
+  dg[(unsigned short)(di + 0x17)] &= 0xe7;                                          /* andb [di+0x17],0xe7 */
   return;
 }
 
