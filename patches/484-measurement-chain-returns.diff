+  /* PATCH 484: asm 0xa17e is `call 08e8; lret` -- a pure forwarder, so the callee's AX IS this
+   * function's return value.  Ghidra's bare `return;` in a non-void function left it to the
+   * calling convention: correct by accident at -O0 (native), garbage at -O2 (wasm). */
+  return FUN_0000_08e8(param_1,param_2);
 }
 
 
