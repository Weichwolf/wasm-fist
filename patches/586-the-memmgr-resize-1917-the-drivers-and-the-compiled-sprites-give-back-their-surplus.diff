+/* ===== ((uint)(uintptr_t)&FUN_1000_1917) @ 1000:1917 ===== */
+
+uint __allregs FUN_1000_1917(unsigned short ax, unsigned short bx, unsigned short cx)
+
+{
+  /* PATCH 586: DGROUP:0xd4 = 0f69:2287 -- the MEMMGR RESIZE a driver calls at the end of its init to
+   * give back the part of its image it no longer needs: `push ax ; call 1345 ; jb fail ; mov cx,ds ;
+   * mov ds,ax ; pop ax ; push cx ; call 0cce ; pop ds ; retf` -- AX = the new size in paragraphs,
+   * CX:BX = the owner struct; 1345 finds the block, 0cce (patch 188) splits its tail back onto the
+   * free list.  MGAVIDEO's init asks for 0x46a of its 0x7ca paragraphs (struct 0x3e4), SOUNDDVR's for
+   * 0x413 of 0x434 (struct 0x4fa) -- the oracle's blocks are exactly that size.  The shim had routed
+   * the linear to a sound-driver stand-in that searched for 0x4fa and resized nothing, so both drivers
+   * kept their whole images: 14 KB less heap, and a mission that fills it (the second cockpit's console
+   * after the player's vehicle is lost) hit the swap path with no swap.  Unpromoted before. */
+  uint16_t node = (uint16_t)FUN_1000_1345(cx, bx);                 /* 11918 call 1345 (cx:bx owner) */
+  if (node == 0) { g_mm_cf = 1; return 0; }                        /* 1191b jb -> pop ax ; retf (CF=1) */
+  g_mm_ds = node;                                                  /* 1191f mov ds,ax */
+  FUN_1000_0cce(ax, 0, 0);                                         /* 11923 call 0cce (ax = new size) */
+  return (uint)node;
+}
