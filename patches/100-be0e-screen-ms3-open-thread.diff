FUN_0000_be0e: thread the screen-resource-load registers into the (*c378)() screen loader.

be0e is the SCREEN-ENTER handler (asm 0xbe0e): given a screen id in bx (param_1 = 4 for MAINMENU, 8 for
LOADING, ...), it looks up that screen's resource filename via the 4-byte-stride table at DGROUP:0x9f2c
(entry = {name_off:word, seg:word}; the offsets point at ASCIIZ ".MS3" names in DGROUP: idx4 = 0x9f30 ->
"MAINMENU.MS3", idx8 = 0x9f34 -> "LOADING.MS3", ...) and hands it to the screen loader via the far method
vector DGROUP:0x378 (installed by reloc section si=0x174; stably resolves to FUN_1000_250d, the direct
resource-open/alloc/read loader).  asm 0xbe2a-0xbe33:
    mov dx,[bx+0x9f2c]   ; dx = word[DGROUP:param_1+0x9f2c] = the .MS3 filename offset
    mov bx,0x9f1c        ; bx = the screen descriptor offset (250d stores the loaded seg into its word0)
    mov cx,ds            ; cx = DGROUP = 0x1c00 (the descriptor segment)
    lcall [0x378]        ; -> 250d(cx,dx,bx)
250d's __allregs C signature maps param_1=CX(descr seg), param_2=DX(filename offset), param_3=BX(descr
off), param_4=BP, param_5=SI, param_6=DI (verified against 250d entry asm 0x1250d: mov [2b66],bx /
mov [2b68],cx / mov [2b64],dx then AH=3D open DS:DX).  The __allregs indirect method-vector site dropped
all of them (called with no args) so 250d opened a garbage DX offset (empty name) -> the .MS3 never
loaded.  Thread them faithfully (per-patch indirect-call arg threading, CLAUDE.md).  be0e does not set
BP/SI/DI before the call (they carry the caller's, irrelevant to the open/read of a whole file) -> 0.
--- a/fist.c
+++ b/fist.c
@@ -29436,7 +29436,12 @@
     }
     if (param_1 != -1) {
       DAT_2000_5fd9 = param_1;
-      (*(code *)fist_icall_far((uint32_t)(DAT_1000_c378)))();
+      /* PATCH 100: thread the screen-resource-load registers into the (*c378)()=250d loader
+         (dx=word[DGROUP:param_1+0x9f2c] = the .MS3 filename offset, bx=0x9f1c = screen descriptor,
+         cx=ds=0x1c00 = descriptor seg).  __allregs vector site had dropped them -> empty-name open. */
+      ((void (*)(undefined2,undefined2,undefined2,undefined2,undefined2,undefined2))
+       fist_icall_far((uint32_t)(DAT_1000_c378)))
+          (0x1c00, *(undefined2 *)(g_mem + 0x1c000 + param_1 + 0x9f2c), 0x9f1c, 0, 0, 0);
       _DAT_2000_5f1e = _DAT_2000_5f1e | 800;
       (*(code *)fist_icall_far((uint32_t)(DAT_1000_c510)))();
       FUN_0000_be58();
