+/* ===== PATCH 192: the 22dd mission-viewport trig/normalise handler @ 0000:23f2 (+ mid-entries) ===== */
+
+/* 0x0cbe: normalise dx:ax -> 16-bit mantissa in *ax, byte-exponent in *dx (0x08 or 0x10);
+ * dx==0 -> unchanged. */
+static void m192_norm_cbe(uint16_t *ax, uint16_t *dx)
+{
+  uint16_t A = *ax, D = *dx;
+  if (D == 0) return;                    /* or dx,dx; je 0xccc (unchanged) */
+  if ((D >> 8) != 0) {                   /* dh!=0: ax=dx; dx=0x10 */
+    *ax = D; *dx = 0x10; return;
+  }
+  /* dh==0, dl!=0: al=ah; ah=dl; dx=8 -> ax = (old dl)<<8 | (old ah) */
+  *ax = (uint16_t)(((D & 0xff) << 8) | (A >> 8));
+  *dx = 0x08;
+}
+
+/* 0x0374: octant = ((-angle + 0x4000) rol 3) & 7. */
+static uint16_t m192_oct_374(uint16_t a)
+{
+  a = (uint16_t)(-(int)a);                                   /* neg ax */
+  a = (uint16_t)((a & 0x00ff) | ((((a >> 8) + 0x40) & 0xff) << 8)); /* add 0x40,ah (byte) */
+  a = (uint16_t)((a << 1) | (a >> 15));                      /* rol ax,1 */
+  a = (uint16_t)((a << 1) | (a >> 15));
+  a = (uint16_t)((a << 1) | (a >> 15));
+  return (uint16_t)(a & 7);                                  /* and 7 */
+}
+
+/* 0x05bc (cos) / 0x05b7 (sin) wrapper contract: ax = table mantissa (patch-157 FUN_0000_05e2), dx =
+ * exponent word the __allregs decompile drops.  0x5e2 returns CF=1 on |value|==1.0 saturation (signalled
+ * by ax==0xffff); the wrapper then sets ax=1,dl=0 (CF=1) or dl=0xf0 (CF=0), dh=cwtd sign of `arg`. */
+static void m192_trig(uint16_t arg, uint16_t *ax_out, uint16_t *dx_out)
+{
+  int v = FUN_0000_05e2((uint)arg);
+  uint16_t dh = (arg & 0x8000) ? 0xff00 : 0x0000;   /* cwtd of the 0x5e2 argument */
+  if ((uint16_t)v == 0xffff) { *ax_out = 1;            *dx_out = dh;        }  /* jb 0x5c4: ax=1, dl=0 */
+  else                       { *ax_out = (uint16_t)v;  *dx_out = dh | 0xf0; }  /* dl=0xf0 */
+}
+
+void __allregs FUN_0000_23f2(uint16_t bx)   /* bx = 0x6c34 / 0x6c30 / 0x6c2c (mid-entry selects) */
+{
+  uint8_t *DG = g_mem + 0x1c000;
+  uint16_t ax = *(uint16_t *)(DG + bx);       /* mov (bx),ax */
+  uint16_t dx = 0;                            /* xor dx,dx */
+  uint8_t  cl = *(DG + 0x154a);               /* mov cx,dx; mov cl,[0x154a] -> cx = 0x00:cl */
+  if (cl > 1) {                               /* cmp 1; jbe -> skip */
+    uint32_t p = (uint32_t)ax * (uint32_t)cl; /* mul cx */
+    ax = (uint16_t)p; dx = (uint16_t)(p >> 16);
+  }
+  cl = 0;                                     /* xor cl,cl */
+  if ((dx >> 8) == 0) {                       /* or dh,dh; jne 0x2418 */
+    do {                                      /* byte-shift dx:ax left 8, cl+=8, while dh==0 */
+      uint32_t da = (((uint32_t)dx << 16) | ax) << 8;
+      dx = (uint16_t)(da >> 16); ax = (uint16_t)da;
+      cl += 8;
+    } while ((dx >> 8) == 0);
+  }
+  if (!(dx & 0x8000)) {                       /* js 0x2422 -> skip if MSB already set */
+    do {                                      /* bit-shift dx:ax left 1, cl+=1, until MSB set */
+      cl += 1;
+      uint32_t da = (((uint32_t)dx << 16) | ax) << 1;
+      dx = (uint16_t)(da >> 16); ax = (uint16_t)da;
+    } while (!(dx & 0x8000));
+  }
+  cl = (uint8_t)(cl + *(DG + 0x154c));        /* add [0x154c],cl */
+  uint8_t ch = (uint8_t)(-(int)(cl & 0xf8));  /* ch=cl; and 0xf8,ch; neg ch */
+  cl = (uint8_t)(cl + ch);                    /* add ch,cl -> cl = cl & 7 */
+  while (cl != 0) {                           /* je 0x2439 -> skip; else shr dx:ax by cl */
+    uint32_t da = (((uint32_t)dx << 16) | ax) >> 1;
+    dx = (uint16_t)(da >> 16); ax = (uint16_t)da;
+    cl -= 1;
+  }
+  m192_norm_cbe(&ax, &dx);                     /* call 0xcbe */
+  {
+    uint8_t dl = (uint8_t)dx;
+    dl = (uint8_t)(dl + ch);                   /* add ch,dl */
+    dl = (uint8_t)(dl + *(DG + bx + 2));       /* add [bx+2],dl */
+    dx = (uint16_t)((dx & 0xff00) | dl);
+  }
+  *(uint16_t *)(DG + 0x6c26) = ax;             /* mov ax,[0x6c26] */
+  *(uint16_t *)(DG + 0x6c28) = dx;             /* mov dx,[0x6c28] */
+  {
+    uint16_t angle = *(uint16_t *)(DG + 0x1558);
+    uint16_t tax, tdx;
+    m192_trig(angle, &tax, &tdx);              /* call 0x5bc (cos of angle) */
+    *(uint16_t *)(DG + 0x6c1e) = tax;
+    *(uint16_t *)(DG + 0x6c20) = tdx;
+    {
+      uint16_t adj = (uint16_t)(-(int)angle);  /* 0x5b7: neg ax; add 0x40,ah (byte) */
+      adj = (uint16_t)((adj & 0x00ff) | ((((adj >> 8) + 0x40) & 0xff) << 8));
+      m192_trig(adj, &tax, &tdx);              /* call 0x5b7 (sin = cos of angle+90deg) */
+      *(uint16_t *)(DG + 0x6c22) = tax;
+      *(uint16_t *)(DG + 0x6c24) = tdx;
+    }
+    *(uint16_t *)(DG + 0x6c2a) = m192_oct_374(angle);  /* call 0x374 (octant) */
+  }
+  *(uint16_t *)(DG + 0x4a86) += 2;             /* addw 2,[0x4a86] -- advance the 22dd cursor */
+}
+
+void __allregs FUN_0000_23e5(undefined2 param_1) { (void)param_1; FUN_0000_23f2(0x6c30); }
+void __allregs FUN_0000_23ea(undefined2 param_1) { (void)param_1; FUN_0000_23f2(0x6c34); }
+void __allregs FUN_0000_23ef(undefined2 param_1) { (void)param_1; FUN_0000_23f2(0x6c2c); }
+
