   uVar6 = DAT_0000_557c >> 2;
+  instruction_count += 7 * (uint64_t)uVar6;
   uVar10 = (uint)param_1;
   do {
     uVar7 = uVar3 >> 2;
@@ -12328,12 +12331,16 @@
