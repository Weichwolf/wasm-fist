 void __allregs FUN_0000_c6fa(undefined2 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4);
 void __allregs FUN_0000_c70d(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4, undefined2 param_5);
+void __allregs FUN_0000_c86e(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4, undefined2 param_5);  /* PATCH 533 */
 void __allregs FUN_0000_c7ca(undefined2 param_1,int param_2,undefined2 param_3);
 void __allregs FUN_0000_c8b2(undefined2 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4, undefined2 param_5);
 void __allregs FUN_0000_c8c2(undefined2 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4, undefined2 *param_5);
@@ -33531,6 +33532,28 @@
   return;
 }
 
+/* ===== ((uint)(uintptr_t)&FUN_0000_c86e) @ 0000:c86e ===== */
+
+void __allregs
+FUN_0000_c86e(undefined1 param_1,undefined2 param_2,undefined2 param_3,undefined2 param_4,
+             undefined2 param_5)
+
+{
+  /* PATCH 533: asm 0xc86e `mov ah,0xd; call c8b2; ret` -- the cockpit-view (d549==0x1e) render method
+   * for object classes 7..14, i.e. the BULK of the object registry.  Ghidra never promoted it, so it
+   * was neither defined nor in the fist_icall fmap, and c4df's data-driven dispatch
+   * `mvec = word[STRSEG:classid*2 + 0x3632]` resolved 0xc86e to nothing.
+   * Instruction-for-instruction the twin of FUN_0000_c70d (patch 463, class 0x15) with AH=0x0d instead
+   * of 0x0f, so it takes patch 463's reconstruction verbatim: arg-less dispatch, si = the object from
+   * g_fist_render_si, bx = classid*2 live from c4df, bp untraced at this entry -> 0. */
+  extern unsigned short g_fist_render_si;
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned short si = g_fist_render_si;
+  FUN_0000_c8b2(CONCAT11(0xd,0),(undefined2)(unsigned short)(*(unsigned short *)(dg + si) << 1),0,(undefined2)si,0);
+  (void)param_1;(void)param_2;(void)param_3;(void)param_4;(void)param_5;
+  return;
+}
+
 
 /* ===== ((uint)(uintptr_t)&FUN_0000_c7ca) @ 0000:c7ca ===== */
 
