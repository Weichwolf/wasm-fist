@@ -3624,7 +3624,9 @@ void __allregs FUN_0000_11ba(uint16_t bx, uint8_t al)
   int16_t *r = (int16_t *)(g_mem + 0x1c000 + (uint16_t)bx);
   r[0] = (int16_t)(r[0] + 2); r[1] = (int16_t)(r[1] + 2);
   r[2] = (int16_t)(r[2] - 2); r[3] = (int16_t)(r[3] - 2);
