+  (void)al; FUN_0000_11db(bx, 2);
   r[0] = (int16_t)(r[0] - 2); r[1] = (int16_t)(r[1] - 2);
   r[2] = (int16_t)(r[2] + 2); r[3] = (int16_t)(r[3] + 2);
