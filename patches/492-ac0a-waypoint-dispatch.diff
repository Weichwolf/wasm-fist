+/* ===== PATCH 492: FUN_1000_ac39 @ 1000:ac39 (waypoint-list consume, not in the Ghidra function set) ===== */
+
+void __allregs FUN_1000_ac39(int param_1)
+
+{
+  /* PATCH 492: waypoint mode 0 -- consume the reached waypoint (asm 0x1ac39; DS=DGROUP=0x1c00).  si=param_1 = the near offset of the object's WAYPOINT
+   * LIST (ac0a resolves it as word[DGROUP:0x7d2a + byte[di+0x1b]*2]).  byte[si] is the entry count; when
+   * non-zero it is decremented and the remaining 8-byte entries shift down one slot (si+0x14 -> si+0xc),
+   * i.e. the reached waypoint is CONSUMED. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  uint16_t si = (uint16_t)param_1, di, cx;
+  cx = dg[si];
+  if (cx == 0) return;
+  dg[si] = (uint8_t)(dg[si] - 1);
+  di = (uint16_t)(si + 0xc);
+  si = (uint16_t)(si + 0x14);
+  do {
+    *(uint32_t *)(dg + di) = *(uint32_t *)(dg + si);
+    *(uint32_t *)(dg + (uint16_t)(di + 4)) = *(uint32_t *)(dg + (uint16_t)(si + 4));
+    si = (uint16_t)(si + 8); di = (uint16_t)(di + 8);
+  } while (--cx != 0);
+  return;
+}
