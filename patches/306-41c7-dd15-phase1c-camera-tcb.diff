+/* ===== ((uint)(uintptr_t)&FUN_0000_dd15) @ 0000:dd15 ===== */
+
+void __allregs FUN_0000_dd15(void)
+
+{
+  /* PATCH 306: FUN_0000_dd15 (asm 0xdd15-0xddc3) -- the phase-0x1c render-script CAMERA->extender-TCB
+     copy, dispatched by the 22dd render-cursor-walk handler 0x41c7.  Structurally identical to db99
+     (patch 193): ddff() builds the viewport geom record into the TCB (es:di = word[0xea2e]:word[0xea2c]
+     = DAT_2000_aa2c), then the mission camera block at DGROUP:0x155a (= d548+0x12, the same source db99
+     copies) is written to rec+0x2c..0x36 (32-bit X/Y/Z), and the extender op 8 (display-list setup) is
+     posted via e339.  dd15 additionally sets rec+0x3c/0x3a (near/detail plane, from the word[0x6d34]
+     descriptor struct) and rec+0x3e (from byte[0x154a]).  Ghidra never promoted 0xdd15 (unpromoted
+     mid-entry, class 121/193/292) -> registered in the fist_icall fmap.  Base-loss rebase: every si/bx
+     near-offset -> g_mem+0x1c000+off; TCB = DAT_2000_aa2c.  asm-verified vs re_out/fist_dat_image.bin
+     (DS=DGROUP=0x1c00). */
+  uint8_t *dg = g_mem + 0x1c000;
+  uint8_t *rec;
+  uint16_t si, ax, bx;
+  uint8_t  bh;
+  FUN_0000_ddff();                                      /* dd15: call ddff */
+  rec = DAT_2000_aa2c;                                  /* es:di = word[0xea2e]:word[0xea2c] */
+  /* camera block si=0x155a -> rec+0x2c..0x36 (asm dd20-dd48) */
+  *(uint16_t *)(rec + 0x2c) = *(uint16_t *)(dg + 0x155a);
+  *(uint16_t *)(rec + 0x2e) = *(uint16_t *)(dg + 0x155c);
+  *(uint16_t *)(rec + 0x30) = *(uint16_t *)(dg + 0x155e);
+  *(uint16_t *)(rec + 0x32) = *(uint16_t *)(dg + 0x1560);
+  *(uint16_t *)(rec + 0x34) = *(uint16_t *)(dg + 0x1562);
+  *(uint16_t *)(rec + 0x36) = *(uint16_t *)(dg + 0x1564);
+  *(uint16_t *)(rec + 0x38) = *(uint16_t *)(dg + 0x1558);                     /* dd4c */
+  *(uint16_t *)(rec + 0x3e) = (uint16_t)((uint16_t)*(uint8_t *)(dg + 0x154a) << 8); /* dd53: ah=byte[0x154a], al=0 */
+  si = *(uint16_t *)(dg + 0x156a);                                            /* dd5d */
+  *(uint16_t *)(rec + 0x02) = *(uint16_t *)(dg + si);                         /* word[DGROUP:si] */
+  *(uint16_t *)(rec + 0x04) = 0;
+  si = *(uint16_t *)(dg + 0x6d34);                                            /* dd6d: descriptor near-offset */
+  *(uint16_t *)(rec + 0x3c) = *(uint16_t *)(dg + (uint16_t)(si + 0x22));      /* dd71 */
+  ax = *(uint16_t *)(dg + (uint16_t)(si + 0x24));                             /* dd78 */
+  bx = *(uint8_t *)(dg + (uint16_t)(si + 0x3c));                              /* dd7b: movzbw bx,byte[si+0x3c] */
+  bx &= 0xfffe;
+  bx = *(uint16_t *)(dg + (uint16_t)(bx - 0x155d));                           /* dd83: word[DGROUP:(bx-0x155d)] */
+  bh = (uint8_t)((bx >> 8) + *(uint8_t *)(dg + (uint16_t)(si + 0xa7)));       /* dd87: add bh,byte[si+0xa7] */
+  bx = (uint16_t)(((uint16_t)bh << 8) | (bx & 0xff));
+  bx = (uint16_t)(((int16_t)bx) >> 2);                                        /* dd8b: sar bx,2 (signed) */
+  ax = (uint16_t)(ax + bx);                                                   /* dd8e: add ax,bx */
+  *(uint16_t *)(rec + 0x3a) = ax;                                            /* dd90 */
+  if (*(uint8_t *)(dg + (uint16_t)(si + 0x17)) & 2) {                         /* dd94: testb [si+0x17],2 */
+    *(uint16_t *)(rec + 0x3c) = 0;
+    *(uint16_t *)(rec + 0x3a) = *(uint16_t *)(dg + 0x8d0a);
+  }
+  /* ddb1: `mov gs:[si+0x3f2],ebx` -- rec+0x3f2 = the extender command inbox (EBX).  Low16 = the computed
+     bx (dd8b sar result); the high16 is caller-ambient and the op-8 PM handler follows the op-0xc pattern
+     (its handler overwrites ebx first, provably dead -- patch 193's ddff/db99 note) -> write the computed
+     low16 without fabricating the high half. */
+  *(uint32_t *)(rec + 0x3f2) = (uint32_t)(uint16_t)bx;
+  *(uint16_t *)(dg + 0xea10) = 8;                                             /* ddb9: op = 8 */
+  FUN_0000_e339();                                                           /* ddc0 */
+}
