+   * DGROUP:0x6cea: `lcall [dword DGROUP:(0x6cea + (n&7)*4)]`.  Ghidra base-lost it -- treated
+   * 0x6cea+(n&7)*4 as a HOST pointer, read only the low WORD, and emitted a NEAR call -> *puVar1
+   * dereferenced host 0x6cea..0x6d06 -> SIGSEGV.  Rebuilt as the faithful FAR dispatch through the
+   * DGROUP table.  The 8 task slots are not registered on this cascade path yet, so the table is 0
+   * and fist_icall_far(0) honest-traps (no-op return) -- behaviour-neutral for reaching the render;
+   * populating the background-task list is deferred subsystem work. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned int bx;
   DAT_2000_2ce8 = DAT_2000_2ce8 + 1;
-  puVar1 = (undefined2 *)((DAT_2000_2ce8 & 7) * 4 + 0x6cea);
-  (*(code *)fist_icall_near(0x0u,(uint16_t)(*puVar1)))();
+  bx = (unsigned short)(((unsigned short)DAT_2000_2ce8 & 7) << 2);
+  (*(code *)fist_icall_far(*(uint32_t *)(dg + (unsigned short)(0x6cea + bx))))();
   return;
