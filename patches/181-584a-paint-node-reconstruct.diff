+     (0x584a-0x586f, the c61a arg computation) and base-lost bx (treated param_1 as a host pointer ->
+     `*(int*)(param_1+4)` wild-deref, SIGSEGV).  bx (node offset) is published by 209e to DGROUP:0x3e08,
+     bp (walk base) to g_fist_paintbp (patch 142); SS=DS=DGROUP.  Faithful transliteration below. */
+  extern unsigned short g_fist_paintbp;
+  uint8_t *dg = g_mem + 0x1c000;
+  uint16_t bx = *(uint16_t *)(dg + 0x3e08);
+  uint16_t bp = g_fist_paintbp;
+  /* head (584a-586f): ax = the c61a argument, from the nested element si. */
+  uint16_t si = *(uint16_t *)(dg + (uint16_t)(bx + 2));            /* mov si,[bx+2] */
+  si = *(uint16_t *)(dg + (uint16_t)(bp + si + 1));                /* mov si,[bp+si+1] */
+  uint16_t ax = *(uint16_t *)(dg + (uint16_t)(si + 0x7cba));       /* mov ax,[si+0x7cba] */
+  if (si == *(uint16_t *)(dg + 0x7c52)) ax = (uint16_t)(ax + 8);   /* cmp si,[0x7c52]; add ax,8 */
+  if ((*(uint16_t *)(dg + (uint16_t)(si + 0x7cdc)) & 1) &&         /* testw [si+0x7cdc],1; je */
+      ((*(uint8_t *)(dg + 0x6dab) & 2) == 0))                      /* testb [0x6dab],2; jne */
+    ax = 0xfd0;                                                    /* mov ax,0xfd0 */
+  bx = (uint16_t)(bx + 4);                                         /* lea bx,[bx+4] */
+  ax = (uint16_t)(ax & 0xff00);                                    /* mov al,0 */
+  /* tail (5870-5888): c61a(ax); bump the DGROUP:[bx]/[bx+2] words; nested c6c8; restore. */
+  ((void (*)(uint))fist_icall_far((uint32_t)(DAT_1000_c61a)))(ax);
+  *(uint16_t *)(dg + bx)                     += 1;                 /* incw [bx] */
+  *(uint16_t *)(dg + (uint16_t)(bx + 2))     += 1;                 /* incw [bx+2] */
   (*(code *)fist_icall_far((uint32_t)(DAT_1000_c6c8)))();
