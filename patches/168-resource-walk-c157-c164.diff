-void __allregs FUN_0000_c164(void);
+undefined2 __allregs FUN_0000_c164(void);   /* PATCH 168: returns the found table-entry near-offset in AX (asm si), CF via g_fist_cf */
 uint __allregs FUN_0000_c182(uint param_1,undefined2 param_2,undefined2 param_3,uint *param_4,int param_5);
 void __allregs FUN_0000_c1db(void);
 void __allregs FUN_0000_c1f0(void);
@@ -29785,28 +29785,41 @@
 void __allregs FUN_0000_c157(void)
 
 {
-  DAT_2000_a29e = (undefined2 *)&DAT_2000_9fbc;
-  DAT_2000_a2a0 = 0xb6;
+  /* PATCH 168 (asm 0xc157): the resource-list walk cursor init.  asm `movw [DGROUP:0xe29e],0xdfbc;
+     movw [DGROUP:0xe2a0],0xb6` -- a29e is a 16-bit near-offset (the table base DGROUP:0xdfbc = the
+     &DAT_2000_9fbc linear 0x29fbc), a2a0 the 0xb6 entry count.  Ghidra typed a29e undefined2* and
+     stored a 4-byte host pointer -> its low16 read back by c164 is garbage.  Store the WORD offset. */
+  *(uint16_t *)(g_mem + 0x2a29e) = 0xdfbc;
+  *(uint16_t *)(g_mem + 0x2a2a0) = 0xb6;
   return;
 }
 
 
 /* ===== ((uint)(uintptr_t)&FUN_0000_c164) @ 0000:c164 ===== */
 
-void __allregs FUN_0000_c164(void)
+undefined2 __allregs FUN_0000_c164(void)
 
 {
-  int *piVar1;
-  
-  do {
-    piVar1 = DAT_2000_a29e;
-    if (DAT_2000_a2a0 == 0) {
-      return;
+  /* PATCH 168 (asm 0xc164): the resource-list "find next nonzero entry" walker.  ES=DS=DGROUP; a29e
+     (word[DGROUP:0xe29e]) is the running near-offset cursor, a2a0 (word[DGROUP:0xe2a0]) the remaining
+     count.  Each step: bx = cursor; if count==0 -> stc/ret; cursor += 4 (stride-4 table); count -= 1;
+     si = word[DGROUP:bx]; if si!=0 -> clc/ret with the found value in AX(=si); else loop.  Ghidra
+     typed a29e int* and dereferenced the near-offset value as a host ptr (`*piVar1` = the SIGSEGV at
+     c164, fault = the near-offset 0x20fc) AND lost the returned si.  Rebased to DGROUP + CF via the
+     shim g_fist_cf + the found si returned in AX (consumed by d755/c182).  Not reached by the 19
+     flows (a bare host deref would already SIGSEGV them). */
+  extern unsigned char g_fist_cf;
+  unsigned char *dg = g_mem + 0x1c000;
+  do {
+    uint16_t bx = *(uint16_t *)(dg + 0xe29e);
+    if (*(uint16_t *)(dg + 0xe2a0) == 0) { g_fist_cf = 1; return 0; }       /* c168 je c180 stc */
+    *(uint16_t *)(dg + 0xe29e) = (uint16_t)(*(uint16_t *)(dg + 0xe29e) + 4); /* c16f addw 4 */
+    *(uint16_t *)(dg + 0xe2a0) = (uint16_t)(*(uint16_t *)(dg + 0xe2a0) - 1); /* c174 decw */
+    {
+      uint16_t si = *(uint16_t *)(dg + bx);                                  /* c178 mov si,[bx] */
+      if (si != 0) { g_fist_cf = 0; return si; }                            /* c17a jne -> c17e clc */
     }
