+  /* PATCH 027: zero-fill the just-allocated buffer at ES:DI where ES = DGROUP:0x4f0 = struct[0] =
+     the segment 0a31 allocated (asm 0x14ef: mov es,[0x4f0]; xor di,di; rep stosw 0; rep stosw 0xffff).
+     Ghidra dropped the ES base (di started at host 0) -> SIGSEGV. Base the stores at g_mem+(es<<4)+di. */
