+  /* PATCH 456: asm 0xc00c `cmp ax,0xffff; je; mov ds:0x9fdd,ax; bx=ax; mov ax,word[bx-0x601f]; cmp al,0xff
+   * ...; call e2c2`.  param_1=ax; word[bx-0x601f] is a DGROUP read Ghidra deref'd as a HOST pointer (the
+   * c035/c00c SIGSEGV without setarch -R, divergent on wasm).  Rebase the read to the DGROUP model; 16-bit
+   * guard (0xffff).  The e2c2 ARG is left as Ghidra emitted it: the asm builds it from ecx/edx register
+   * math (not modeled here), but it is pure param arithmetic -> IDENTICAL native<->wasm, so it does not
+   * block byte-identity; its FAITHFULNESS vs the asm is a separate (2da2/faithfulness) concern. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  if (((unsigned short)param_1 != 0xffff) &&
+      (DAT_2000_5fdd = param_1,
+       (char)*(unsigned short *)(dg + (unsigned short)((unsigned short)param_1 - 0x601f)) != -1))
   {
     FUN_0000_e2c2(CONCAT22((int)((ulong)param_3 >> 0x10),param_1));
   }
