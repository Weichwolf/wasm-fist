+#define _DAT_1000_c794 (*(undefined2 *)(g_mem+0x1c794))
+#define _DAT_1000_c796 (*(undefined2 *)(g_mem+0x1c796))
 #define _DAT_1000_c798 (*(undefined4 *)(g_mem+0x1c798))
 #define _DAT_1000_c79a (*(undefined4 *)(g_mem+0x1c79a))
 #define _DAT_1000_cc1a (*(undefined4 *)(g_mem+0x1cc1a))
