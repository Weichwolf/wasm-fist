+/* ===== ((uint)(uintptr_t)&FUN_1000_177f) @ 1000:177f ===== */
+
+uint __allregs FUN_1000_177f(int param_1,uint param_2,undefined2 param_3)
+
+{
+  /* PATCH 571: the MEMMGR front-end behind the far vector DGROUP:0xe8 = 0f69:20ef (asm 0x1177f-0x11795),
+   * unpromoted before.  AX = size in paragraphs, CX:BX = the caller's descriptor struct (every caller
+   * passes DGROUP:0x157c).  `incb ss:0x1744` arms the guard that makes 184b return CF instead of jumping
+   * to the fatal 13e4 handler, `call 184b`, `decb ss:0x1744`, and on CF `mov bx,ss:[0x16d8]` -- the
+   * largest free block -- so an `ax=0xffff` request is the engine's "how much memory is there" idiom:
+   * 42cc/4354 read BX back (threaded through g_fist_177f_bx).  SS=DGROUP (patch 156). */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  extern unsigned char g_fist_cf;
+  uint r;
+  dg[0x1744] += 1;
+  g_mm_cf = 0;
+  r = FUN_1000_184b(param_1, 0x1c00, 0, (undefined2 *)(uintptr_t)(unsigned short)param_2, 0, 0);
+  dg[0x1744] -= 1;
+  if (g_mm_cf) { g_fist_177f_bx = *(unsigned short *)(dg + 0x16d8); g_fist_cf = 1; }
+  else         { g_fist_177f_bx = (unsigned short)param_2;            g_fist_cf = 0; }
+  (void)param_3;
+  return r;
+}
