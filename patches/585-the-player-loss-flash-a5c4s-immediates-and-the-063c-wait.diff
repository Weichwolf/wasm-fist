+  /* PATCH 585: asm 0x1a5c4 `push di ; push [0x452] ; mov ax,0x40 ; mov si,0x20 ; mov di,0x20 ; lcall
+   * [0x5c4] ; pop [0x452] ; pop di ; retf` -- the player-loss flash: MGAVIDEO 063c (0647 -> 0660) fades
+   * the DAC to black, red 64 frames, green and blue 32, and waits for it.  Ghidra dropped the three
+   * immediates at the indirect call, so 0660 took whatever was on the stack: the green and blue rates
+   * came out 0 and 2048 -- black at once and a red that lingered for 21845 frames. */
   uVar1 = DAT_1000_c452;
-  (*(code *)fist_icall_far((uint32_t)(DAT_1000_c5c4)))();
+  ((void (*)(unsigned short, unsigned short, unsigned short))fist_icall_far((uint32_t)(DAT_1000_c5c4)))(0x40, 0x20, 0x20);
   DAT_1000_c452 = uVar1;
   return;
 }
