+    *(byte *)(g_mem + 0x1c000 + (uint16_t)(uintptr_t)DAT_1000_5957 + 2) =
+        *(byte *)(g_mem + 0x1c000 + (uint16_t)(uintptr_t)DAT_1000_5957 + 2) | 0x60;
     uVar3 = 0x1000;
-    FUN_1000_5014(*DAT_1000_5957,uVar1,DAT_1000_5959,param_4,param_5,param_6);
