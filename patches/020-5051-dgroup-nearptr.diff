+++ b/fist.c
@@ -47154,24 +47154,35 @@
   bool bVar2;
   undefined2 uVar3;
   
+  /* patch 020: param_3 is a DGROUP NEAR pointer (offset; DS=0x1c00 -> stored to DAT_1000_595b). Ghidra
+   * dropped the segment base and dereferenced the bare 16-bit offset as a host address -> SIGSEGV at
+   * `*(byte*)(param_3+1)`. Rebase every param_3 / DAT_1000_5957 deref to g_mem + DGROUP(0x1c000) + off
+   * (asm-verified base-0 0x15051..0x150c7: `ds:[bx+2]` byte flags, `ds:[bx]` word). Also fix the final
+   * indirect far call: asm `call dword cs:0x5951` reads the far ptr assembled at cs:0x5951 = linear
+   * 0x15951 (DAT_1000_5951 off + DAT_1000_5953 seg), which Ghidra mis-based to DAT_2000_1951 (0x21951).
+   * The bVar2 CF-error checks after FUN_1000_50c8/5014 remain a dropped-flag local (documented CF class;
+   * both succeed on the boot path -> CF=0). */
   DAT_1000_595b = 0x1c00;
   DAT_1000_5957 = param_3;
   DAT_1000_5959 = param_2;
-  *(byte *)(param_3 + 1) = *(byte *)(param_3 + 1) & 0xbf;
+  *(byte *)(g_mem + 0x1c000 + (uint16_t)(uintptr_t)param_3 + 2) =
+      *(byte *)(g_mem + 0x1c000 + (uint16_t)(uintptr_t)param_3 + 2) & 0xbf;
   bVar2 = false;
-  *(byte *)(param_3 + 1) = *(byte *)(param_3 + 1) | 0x22;
