-    uVar4 = 0;
-    uVar2 = param_2[2] - param_3[2];
-    uVar6 = (param_2[3] - param_3[3]) - (uint)(param_2[2] < param_3[2]);
-    bVar7 = uVar6 == 0;
-    if ((int)uVar6 < 0) {
-      uVar4 = 0xff;
-      bVar7 = uVar2 == 0;
-      uVar2 = -uVar2;
-      if (bVar7) {
-        uVar6 = -uVar6;
-        bVar7 = uVar6 == 0;
