+  /* PATCH 538: the 3-lane proximity/range test (asm 0x0ea9-0x0f2f; DS=DGROUP=0x1c00), the primitive
+   * under EVERY collision and proximity walk in the engine (bb1b, bb64, a0ab, 08e8, ...).  cx=the
+   * bound (bp); bx=param_2 and si=param_3 are two coordinate triples of THREE INT32 LANES, each held
+   * as two words: [bx]/[bx+2] = X, [bx+4]/[bx+6] = Y, [bx+8]/[bx+0xa] = Z.
+   *
+   * Ghidra typed the operands `uint *` and then modelled each lane as a 64-BIT value split over two
+   * array elements: it paired element[0] (=X) with element[1] (=Y) as one lane's low/high halves, so
+   * lane 1 tested X against a "high word" that is really Y, lane 2 tested Z, and Y was never tested
+   * at all.  Its `uVar5 ^ 0xffff` also flips only the low 16 bits of a 32-bit variable, so even the
+   * negate is not the asm's 32-bit `neg ax / xor dx,0xffff` pair.
+   *
+   * Worse, the pristine version NEVER SETS THE CARRY, yet every caller branches on it -- bb1b does
+   * `call 0ea9; jae next` (patch 284 threads it through g_fist_cf).  So the range test's answer was
+   * a STALE carry left by some unrelated call.  Measured in AZER1 self-play: every one of 8000
+   * projectile "range hits" passed, and 7994 of them were against the six type-0x1b objects, which
+   * sit at z=7936..13824 while the vehicles sit at z=1280..2048.
+   *
+   * Reconstructed 1:1 per lane: 32-bit difference; `jns` on the sign of the HIGH word; on negative,
+   * `neg ax` then `neg dx` (when ax was 0) else `xor dx,0xffff`; FAIL (clc) unless the high word is 0
+   * AND the low word is <= the bound (an UNSIGNED `ja`).  Lane Z is DELIBERATELY not bound-checked --
+   * the asm stores its signed delta to 0x202c/0x202e and its sign to 0x2032 and falls into `stc`, so
+   * the test is 2-D by design.  0x2030/0x2031/0x2032 are BYTE stores (`mov %cl,...`); the
+   * DAT_1000_e030/e031 macros are undefined2 and would clobber the neighbouring sign byte, so write
+   * bytes.  Out: CF=1 on a hit (g_fist_cf), AX = |dZ| low word. */
+  extern unsigned char g_fist_cf;
+  const unsigned char *b = (const unsigned char *)param_2;   /* bx */
+  const unsigned char *s = (const unsigned char *)param_3;   /* si */
+  uint16_t bp = (uint16_t)param_1;                           /* 0ea9 mov bp,cx */
+  uint16_t ax, dx, ax0;
+  unsigned char cl;
+
+#define FIST_0EA9_LANE(byte_off)                                                      \
+  do {                                                                                \
+    uint32_t d_ = *(const uint32_t *)(b + (byte_off))                                 \
+                - *(const uint32_t *)(s + (byte_off));      /* sub ax / sbb dx */     \
+    ax = (uint16_t)d_; dx = (uint16_t)(d_ >> 16); cl = 0;                             \
+    if ((int16_t)dx < 0) {                                  /* jns */                 \
+      cl = 0xff;                                            /* dec cl */              \
+      ax0 = ax; ax = (uint16_t)(0u - (unsigned)ax);          /* neg ax */             \
+      dx = ax0 ? (uint16_t)(dx ^ 0xffffu)                   /* jae only when ax==0 */ \
+               : (uint16_t)(0u - (unsigned)dx);                                       \
+    }                                                                                 \
+  } while (0)
+
+  FIST_0EA9_LANE(0);                                        /* 0ead-0ec6 lane X */
+  if (dx != 0 || ax > bp) { g_fist_cf = 0; return ax; }     /* 0ec2 jne / 0ec6 ja -> 0f23 clc */
+  *(uint16_t *)(g_mem + 0x1e024) = ax;                      /* 0ec8 mov [0x2024],ax */
+  *(uint16_t *)(g_mem + 0x1e026) = dx;                      /* 0ecb mov [0x2026],dx */
+  g_mem[0x1e030] = cl;                                      /* 0ecf mov [0x2030],cl (BYTE) */
+
+  FIST_0EA9_LANE(4);                                        /* 0ed5-0ef0 lane Y */
+  if (dx != 0 || ax > bp) { g_fist_cf = 0; return ax; }     /* 0eec jne / 0ef0 ja -> 0f23 clc */
+  *(uint16_t *)(g_mem + 0x1e028) = ax;                      /* 0ef2 mov [0x2028],ax */
+  *(uint16_t *)(g_mem + 0x1e02a) = dx;                      /* 0ef5 mov [0x202a],dx */
+  g_mem[0x1e031] = cl;                                      /* 0ef9 mov [0x2031],cl (BYTE) */
+
+  {                                                         /* 0eff-0f1d lane Z: recorded, NOT gated */
+    uint32_t d_ = *(const uint32_t *)(b + 8) - *(const uint32_t *)(s + 8);
+    ax = (uint16_t)d_; dx = (uint16_t)(d_ >> 16); cl = 0;
+    *(uint16_t *)(g_mem + 0x1e02c) = ax;                    /* 0f0b: the SIGNED delta, before abs */
+    *(uint16_t *)(g_mem + 0x1e02e) = dx;                    /* 0f0e */
+    if ((int16_t)dx < 0) {                                  /* 0f12 jns */
+      cl = 0xff;
+      ax0 = ax; ax = (uint16_t)(0u - (unsigned)ax);
+      dx = ax0 ? (uint16_t)(dx ^ 0xffffu) : (uint16_t)(0u - (unsigned)dx);
     }
   }
-  return uVar2;
