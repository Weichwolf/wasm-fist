+/* ===== PATCH 162: FSG chunk handlers reconstructed (asm-verified) ===== */
+/* These are dispatched by FUN_0000_d501 through the DAT_2000_a9e6 table.  Ghidra never promoted
+   them (reached only via the cs:vtable), so fist_icall_near(0,off) trapped them (returned 0) and the
+   FSG chunk they parse was silently skipped.  Each is a tiny INT-21h leaf: the read-buffer DGROUP
+   near-offset goes into the DX reg-file slot (0xF0006) as a value, NOT a host pointer.  DS=DGROUP
+   (0x1c00) is the ambient reg-file DS that d501 leaves set before dispatch; set explicitly here.
+   Behaviour-neutral for the 19 verify flows (ACCEPT mission-cascade only). */
+
+/* ===== ((uint)(uintptr_t)&FUN_0000_d7da) @ 0000:d7da  (TERM chunk) ===== */
+/* asm: mov BYTE ds:0xe974,1 ; clc ; ret */
+void __allregs FUN_0000_d7da(void)
+{
+  extern unsigned char g_fist_cf;
+  DAT_2000_a974 = '\x01';
+  g_fist_cf = 0;
+  return;
+}
+
+
+/* ===== ((uint)(uintptr_t)&FUN_0000_d8a9) @ 0000:d8a9  (PINF chunk) ===== */
+/* asm 0xd8a9: if byte[ds:0xe975]==1 -> INT21 AH=3f read word[ds:0xe97a] bytes into DGROUP:0x85b6;
+   else INT21 AH=42 AL=1 seek-forward word[ds:0xe97a].  bx=handle word[ds:0xe970]. clc; ret. */
+void __allregs FUN_0000_d8a9(void)
+{
+  extern unsigned char g_fist_cf;
+  if (DAT_2000_a975 == '\x01') {
+    uRam000f0014 = 0x21;
+    uRam000f0000 = CONCAT11(0x3f,(char)uRam000f0000);
+    uRam000f0002 = DAT_2000_a970;
+    uRam000f0004 = DAT_2000_a97a;
+    puRam000f0006 = (undefined2 *)0x85b6;
+    uRam000f000e = 0x1c00;
+    fist_int_dispatch();
+  }
+  else {
+    uRam000f0014 = 0x21;
+    uRam000f0000 = 0x4201;
+    uRam000f0002 = DAT_2000_a970;
+    uRam000f0004 = 0;
+    puRam000f0006 = (undefined2 *)DAT_2000_a97a;
+    uRam000f000e = 0x1c00;
+    fist_int_dispatch();
+  }
+  g_fist_cf = 0;
+  return;
+}
+
