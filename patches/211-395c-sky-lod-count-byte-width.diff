 #define DAT_0000_3924 (*(undefined4 *)(g_mem+fist_ext_base+0x3924))
-#define DAT_0000_395c (*(undefined4 *)(g_mem+fist_ext_base+0x395c))
+#define DAT_0000_395c (*(undefined1 *)(g_mem+fist_ext_base+0x395c))
