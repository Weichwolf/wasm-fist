/* Event queue = linked list of 18-byte (9-word) nodes at DGROUP:0x18ea; ALL links/handles are 16-bit
 * DGROUP near offsets (empty sentinel 0xffff), NOT host pointers.  d8e0/d8e2 are ADJACENT words so the
 * 4-byte int** typing overlapped them and truncated every node link (patch 126; init/drain already fixed
 * in patches 043/073).  QOFF: offset->host base pointer;  QW: the 16-bit word at a DGROUP offset. */
#define QOFF(o) (g_mem + 0x1c000 + (uint16_t)(o))
#define QW(o)   (*(uint16_t *)QOFF(o))
