+  if (*(uint16_t *)(o + 0x97) != 0) {                       /* 90db mov si,[di+0x97]; or si,si */
+    FUN_1000_a265(param_1,param_2,(int *)(uintptr_t)di);    /* 90e3 lcall f69:abd5 (di = NEAR offset) */
+    *(uint16_t *)(o + 0x8b) = (uint16_t)(*(uint16_t *)(o + 0x9b) - *(uint16_t *)(o + 0x26));
   }
