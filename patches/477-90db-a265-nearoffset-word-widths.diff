-  iVar2 = ((uVar1 - 0x16c & -(uint)(uVar1 < 0x16c)) + 0x16c ^ uVar3) - uVar3;
-  if (iVar2 != 0) {
-    *(int *)(param_3 + 0x89) = *(int *)(param_3 + 0x89) + iVar2;
-    *(undefined1 *)(param_3 + 200) = 3;
+  d  = (int16_t)(*(uint16_t *)(o + 0x8b) - *(uint16_t *)(o + 0x89));   /* 90f3/90f7 */
+  sg = (int16_t)(d >> 15);                                             /* 90fb cwtd */
+  d  = (int16_t)((d ^ sg) - sg);
+  if ((uint16_t)d > 0x16c) d = 0x16c;                                  /* 9100-9109 clamp */
+  d  = (int16_t)((d ^ sg) - sg);
+  if (d != 0) {                                                        /* 910f je 911d */
+    *(uint16_t *)(o + 0x89) = (uint16_t)(*(uint16_t *)(o + 0x89) + (uint16_t)d);
+    o[0xc8] = 3;
     FUN_0000_76e8();
   }
-  *(undefined1 *)(param_3 + 0xa9) = 0x80;
-  *(undefined1 *)(param_3 + 0xaa) = 0;
-  *(undefined1 *)(param_3 + 0xab) = 0;
+  o[0xa9] = 0x80;
+  o[0xaa] = 0;
