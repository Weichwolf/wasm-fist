-    FUN_1000_a265(param_1,param_2,param_3);
-    *(int *)(param_3 + 0x8b) = *(int *)(param_3 + 0x9b) - *(int *)(param_3 + 0x26);
+  /* PATCH 477: the AH-64 TURRET/aim slew (asm 0x90db-0x912c; DS=DGROUP=0x1c00, di=the object).
+   * With a locked target word[di+0x97] it re-runs the aiming solver a265 and takes the commanded
+   * azimuth word[di+0x8b] = word[di+0x9b] - word[di+0x26]; the actual azimuth word[di+0x89] then slews
+   * toward it by at most 0x16c per frame (the `sub bx,ax; sbb cx,cx; and cx,ax; add bx,ax` clamp), and
+   * a move sets byte[di+0xc8]=3 and calls 76e8.  Finally byte[di+0xa9]=0x80, [di+0xaa]=[di+0xab]=0.
+   * TWO defects: (1) a265 takes DI as a DGROUP NEAR OFFSET (patch 274) but this caller received the
+   * object HOST pointer from 902c (patch 365) and passed it straight through -- a265 then used the
+   * pointer's low 16 bits as the offset and wrote its results (word[di+0x38]/[di+0x99]/[di+0x9b])
+   * through a wild near offset.  In the AZER1 self-play that landed on DGROUP:0x6ce3..0x6ce6 and
+   * overwrote the frame-loop's own service vector word[0x6ce4], so 459a then called through it into
+   * FUN_0000_4700 with a garbage DI and crashed.  (2) every field here is a WORD in the asm; Ghidra
+   * used 32-bit `int`, so each store clobbered the neighbouring field. */
+  unsigned char *dg = (unsigned char *)g_mem + 0x1c000;
+  unsigned char *o = (unsigned char *)(intptr_t)param_3;
+  uint16_t di = (uint16_t)(o - dg);
