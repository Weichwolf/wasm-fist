+     frontier).  Base-loss rebase: es=DS=DGROUP; every bx/di/si near-offset -> g_mem+0x1c000+off; c33c CF
+     via g_fist_cf + returned si via g_fist_iter_si (378e/patch-292 idiom).  asm-verified vs
+     re_out/fist_dat_image.bin (DS=ES=DGROUP=0x1c00).
+
+     OBSERVED-REACHED on the genuine BATTLES(160,100)->OK(205,128)->ACCEPT(40,186) AZER1 run: the roster
+     is EMPTY on the first cockpit frame (c33c returns CF on the first call, gdb-confirmed), so the loop
+     exits immediately and the FOUND body (3eb3 projection + 8e8 + insertion sort) is DORMANT.  The found
+     body is reconstructed faithfully from the asm for completeness; its 3eb3->e189 op-0x50 point
+     projection is the extender projection service (not yet wired -> returns an imprecise projection, a
+     documented residual analogous to a20d's a192/0459), so a POPULATED roster's depth-sort is a pending
+     refinement, not exercised on the reached path. */
+  extern unsigned char g_fist_cf;
+  extern unsigned short g_fist_iter_si;
+  uint8_t  *dg = g_mem + 0x1c000;
+  uint16_t bx, di, si, cx, ax, dx;
+  /* 2471: word[0x6c6d] = word[0x6c62] with the low byte +1 (frame tag) */
+  ax = *(uint16_t *)(dg + 0x6c62);
+  ax = (uint16_t)((ax & 0xff00) | (uint8_t)((ax & 0xff) + 1));
+  *(uint16_t *)(dg + 0x6c6d) = ax;
+  *(uint16_t *)(dg + 0x4ba0) = 0;             /* list head = 0 */
+  *(uint16_t *)(dg + 0x4b9e) = 0;             /* iterator cursor = 0 (=> c33c INIT) */
+  bx = 0x4ba2;                                /* node array base */
+  for (;;) {                                  /* 2486: loop top */
+    si = *(uint16_t *)(dg + 0x4b9e);
+    di = bx;
+    *(uint16_t *)(dg + (uint16_t)(di + 0x1e)) = 0xffff;   /* node distance = MAX */
+    *(uint16_t *)(dg + (uint16_t)(di + 0x20)) = 0xffff;
+    /* 2496: call near [0x1630] = c33c(si, di) -> CF (done) + updated si (g_fist_iter_si) */
+    g_fist_cf = 0;
+    (*(code *)fist_icall_near(0x0u, *(uint16_t *)(dg + 0x1630)))(si, di);
+    if (g_fist_cf) break;                     /* 249c: jb 0x2512 (roster exhausted) */
+    si = g_fist_iter_si;
+    *(uint16_t *)(dg + 0x4b9e) = si;          /* 249e */
+    di = (uint16_t)((di + 1) & 0xfffe);       /* 24a2 */
+    *(uint16_t *)(dg + bx) = di;              /* 24a6: word[bx]=di */
+    /* 24a8: inline 3eb3(node=bx) -> CF = (edx == -1) (asm 0x3eb3): project the node via e189 op-0x50. */
