+          if ((uint32_t)(((uint32_t)dx << 16) | cx) >= nd_d) break;  /* jae 0x2503 */
+          sptr = di;
+          di = *(uint16_t *)(dg + di);                    /* di = word[di] (next) */
+          if (di == 0) break;
