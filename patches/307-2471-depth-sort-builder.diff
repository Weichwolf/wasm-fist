+         reconstruction -> stored as 0 pending the op-0x50 service). */
+      e_edx = (uint32_t)FUN_0000_e189((uint32_t)(uint16_t)bx);
+      *(uint16_t *)(nd + 0x26) = 0;                       /* [bx+0x26]=ax (extraout, residual) */
+      *(uint16_t *)(nd + 0x28) = 0;                       /* [bx+0x28]=cx (extraout, residual) */
+      *(uint32_t *)(nd + 0x2a) = e_edx;                   /* [bx+0x2a]=edx */
+      *(uint16_t *)(nd + 0x2e) = (uint16_t)(bx + 0xa);    /* [bx+0x2e]=si (OFFSET bx+0xa) */
+      *(uint16_t *)(nd + 0x30) = di;                      /* [bx+0x30]=di */
+      if (e_edx == 0xffffffff) continue;                  /* 24ad: jb 0x2486 (behind camera) */
+    }
+    /* 24af: 8e8(si=0x155a camera, di=bx+0xa node) -> ax:dx = view distance (in DAT_1000_c458/c45a) */
+    FUN_0000_08e8((long *)(dg + 0x155a), (long *)(dg + (uint16_t)(bx + 0xa)));
+    ax = (uint16_t)DAT_1000_c458;
+    dx = (uint16_t)DAT_1000_c45a;
+    /* 24ba: 32-bit compare (word[bx+0x20]:word[bx+0x1e]) - (dx:ax); if below -> skip (already nearer) */
+    if ((uint32_t)(((uint32_t)*(uint16_t *)(dg + (uint16_t)(bx + 0x20)) << 16) |
+                   *(uint16_t *)(dg + (uint16_t)(bx + 0x1e)))
+        < (uint32_t)(((uint32_t)dx << 16) | ax))
+      continue;
+    *(uint16_t *)(dg + (uint16_t)(bx + 0x1e)) = ax;       /* 24c4: store distance */
+    *(uint16_t *)(dg + (uint16_t)(bx + 0x20)) = dx;
+    /* 24ca..24d9: clamp (ax:dx) -= (dh:dl:ch:cl of word[bx+6]); if negative clamp to 0 */
+    {
+      cx = *(uint16_t *)(dg + (uint16_t)(bx + 6));
+      int32_t d32 = (int32_t)(((uint32_t)dx << 16) | ax) - (int32_t)(uint16_t)cx;
+      if (d32 < 0) d32 = 0;
+      ax = (uint16_t)d32; dx = (uint16_t)((uint32_t)d32 >> 16);
+      *(uint16_t *)(dg + (uint16_t)(bx + 0x22)) = ax;
+      *(uint16_t *)(dg + (uint16_t)(bx + 0x24)) = dx;
+      cx = ax;
+    }
+    FUN_0000_2565((int)ax, dx, (int)(int16_t)cx);         /* 24e3: debug (no-op if word[0x29e]==0) */
+    /* 24e6..2507: insertion-sort node bx into the distance-ordered list at word[0x4ba0] */
+    {
+      uint16_t sptr = 0x4ba0;                             /* si = &head */
+      di = *(uint16_t *)(dg + 0x4ba0);                    /* di = head */
+      if (bx != 0x4ba2) {
+        for (;;) {                                        /* 24f1 */
+          uint32_t nd_d = (((uint32_t)*(uint16_t *)(dg + (uint16_t)(di + 0x24)) << 16) |
