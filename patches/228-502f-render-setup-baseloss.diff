+  {
+    unsigned int si = 0xc84;                                           /* mov si,0xc84 */
+    if (*(unsigned short *)(dg + (unsigned short)(di + 0x40)) & 1)     /* testw [di+0x40],1; je */
+      si = *(unsigned short *)(dg + (unsigned short)(dg[(unsigned short)(di + 0x43)] + 0x86bc)); /* si=word[0x86bc+byte[di+0x43]] */
+    FUN_1000_66cd((int)si);                                           /* lcall 0f69:0x703d */
   }
